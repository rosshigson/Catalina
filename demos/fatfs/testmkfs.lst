                   DAT
                   
                   '------------------------------------------------------------------------------
                   ' Float32 Assembly language routines
                   '------------------------------------------------------------------------------
                   ' flt_add   r0 = r0 + r1
                   ' flt_sub   r0 = r0 - r1
                   ' changes: r0, flagA, expA, manA, r1, flagB, expB, manB, t1
                   '------------------------------------------------------------------------------
                   
002cc 0b3 f5602e32 flt_sub                 xor     r1, Bit31               ' negate B
002d0 0b4          flt_add
                   
002d0 0b4 fd604224                         stalli               ' disable interrupts
                   
002d4 0b5 fdb00180                         call    #_Unpack2               ' unpack two variables
002d8 0b6 ed9ffec0           if_c_or_z     jmp     #returni                ' check for NaN or B = 0
                   
002dc 0b7 f7cebc01                         test    flagA, #SignFlag wz     ' negate A mantissa if negative
002e0 0b8 5662c160           if_nz         neg     manA, manA
002e4 0b9 f7cec201                         test    flagB, #SignFlag wz     ' negate B mantissa if negative
002e8 0ba 5662c763           if_nz         neg     manB, manB
                   
002ec 0bb f600755f                         mov     t1, expA                ' align mantissas
002f0 0bc f1807562                         sub     t1, expB
002f4 0bd f640743a                         abs     t1, t1
002f8 0be f324741f                         fle     t1, #31
002fc 0bf f25abf62                         cmps    expA, expB wcz
00300 0c0 10c2c63a           if_nz_and_nc  sar     manB, t1
00304 0c1 40c2c03a           if_nz_and_c   sar     manA, t1
00308 0c2 4602bf62           if_nz_and_c   mov     expA, expB
                   
0030c 0c3 f102c163                         add     manA, manB              ' add the two mantissas
00310 0c4 f256c000                         cmps    manA, #0 wc             ' set sign of result
00314 0c5 c546bc01           if_c          or      flagA, #SignFlag
00318 0c6 3526bc01           if_nc         andn    flagA, #SignFlag
0031c 0c7 f642c160                         abs     manA, manA              ' pack result and exit
00320 0c8 fdb001dc pack_rtni               call    #_Pack
00324 0c9 fd9ffe74                         jmp     #returni
                   
                   '------------------------------------------------------------------------------
                   ' flt_mul  r0 = r0 * r1
                   ' changes: r0, flagA, expA, manA, r1, flagB, expB, manB, t1, t2
                   '------------------------------------------------------------------------------
                   
00328 0ca          flt_mul
                   
00328 0ca fd604224                         stalli               ' disable interrupts
                   
0032c 0cb fdb00128                         call    #_Unpack2               ' unpack two variables
00330 0cc 3d900024           if_nc         jmp     #flt_mul2               ' multiply if neither is NaN
00334 0cd f20ebeff                         cmp     expA, #255 wz           ' NaN, so check for r0 = Inf
00338 0ce ad900008           if_z          jmp     #flt_mul1               ' yes - return Inf
0033c 0cf f20ec4ff                         cmp     expB, #255 wz           ' no - check for r1 = Inf
00340 0d0 5d9ffe58           if_nz         jmp     #returni                ' no - return NaN
00344 0d1 f6002d5a flt_mul1                mov     r0, Inf                 ' yes, r0 or r1 is Inf, so return Inf
00348 0d2 f562bd61                         xor     flagA, flagB            '
0034c 0d3 f7cebc01                         test    flagA, #SignFlag wz
00350 0d4 55402c32           if_nz         or      r0, Bit31
00354 0d5 fd9ffe44                         jmp     #returni
00358 0d6 f562bd61 flt_mul2                xor     flagA, flagB            ' get sign of result
0035c 0d7 f102bf62                         add     expA, expB              ' add exponents
00360 0d8 fd02c163                         qmul    manA, manB
00364 0d9 fd607419                         getqy   t1
00368 0da f0647403                         shl     t1, #3                  ' justify result and exit
0036c 0db f602c03a                         mov     manA, t1
00370 0dc fd9fffac                         jmp     #pack_rtni
                   
                   '------------------------------------------------------------------------------
                   ' flt_div  r0 = r0 / r1
                   ' changes: r0, flagA, expA, manA, r1, flagB, expB, manB, t1, t2
                   '------------------------------------------------------------------------------
                   
00374 0dd          flt_div
                   
00374 0dd fd604224                         stalli               ' disable interrupts
                   
00378 0de fdb000dc                         call    #_Unpack2               ' unpack two variables
0037c 0df e6002d59           if_c_or_z     mov     r0, NaN                 ' check for NaN or divide by 0
00380 0e0 ed9ffe18           if_c_or_z     jmp     #returni
                   
00384 0e1 f562bd61                         xor     flagA, flagB            ' get sign of result
00388 0e2 f182bf62                         sub     expA, expB              ' subtract exponents
                   
0038c 0e3 f046c001                         shr     manA, #1
00390 0e4 fd62c028                         setq    manA
00394 0e5 fd180163                         qdiv    #0, manB
00398 0e6 fd62c018                         getqx   manA
0039c 0e7 f046c002                         shr     manA, #2
003a0 0e8 fd9fff7c                         jmp     #pack_rtni
                   
                   '------------------------------------------------------------------------------
                   ' flt_int  r0 = float(r0)
                   ' changes: r0, flagA, expA, manA
                   '------------------------------------------------------------------------------
                   
003a4 0e9          flt_int
                   
003a4 0e9 fd604224                         stalli               ' disable interrupts
                   
003a8 0ea f602bc16                         mov     flagA, r0               ' get integer value
003ac 0eb f6042c00                         mov     r0, #0                  ' set initial result to zero
003b0 0ec f64ac15e                         abs     manA, flagA wz          ' get absolute value of integer
003b4 0ed ad9ffde4           if_z          jmp     #returni                ' if zero, exit
003b8 0ee f046bc1f                         shr     flagA, #31              ' set sign flag
003bc 0ef f606be1f                         mov     expA, #31               ' set initial value for exponent
003c0 0f0 f076c001 normalize_1             shl     manA, #1 wc             ' normalize the mantissa
003c4 0f1 3186be01           if_nc         sub     expA, #1                ' adjust exponent
003c8 0f2 3d9ffff4           if_nc         jmp     #normalize_1
003cc 0f3 f086c001                         rcr     manA, #1                ' justify mantissa
003d0 0f4 f046c002                         shr     manA, #2
003d4 0f5 fd9fff48                         jmp     #pack_rtni
                   
                   '------------------------------------------------------------------------------
                   ' int_flt  r0 = fix(r0)
                   ' changes: r0, flagA, expA, manA, t1
                   '------------------------------------------------------------------------------
                   
003d8 0f6          int_flt
                   
003d8 0f6 fd604224                         stalli               ' disable interrupts
                   
003dc 0f7 fdb000a8 fix                     call    #_Unpack                ' unpack floating point value
003e0 0f8 cd9ffdb8           if_c          jmp     #returni                ' check for NaN
003e4 0f9 f066c002                         shl     manA, #2                ' left justify mantissa
003e8 0fa f6042c00                         mov     r0, #0                  ' initialize result to zero
003ec 0fb f662bf5f                         neg     expA, expA              ' adjust for exponent value
003f0 0fc f10ebe1f                         add     expA, #31 wz
003f4 0fd f256be21                         cmps    expA, #33 wc
003f8 0fe bd9ffda0           if_nc_or_z    jmp     #returni
003fc 0ff f186be01                         sub     expA, #1
00400 100 f042c15f                         shr     manA, expA
00404 101 f046c001                         shr     manA, #1
00408 102 f7cebc01                         test    flagA, #signFlag wz     ' check sign and exit
0040c 103 f3e02d60                         sumnz   r0, manA
00410 104 fd9ffd88                         jmp     #returni
                   
                   '------------------------------------------------------------------------------
                   ' flt_cmp   set Z and C flags for r0 - r1
                   ' changes: status, t1
                   '------------------------------------------------------------------------------
                   
00414 105          flt_cmp
                   
00414 105 fd604224                         stalli               ' disable interrupts
                   
00418 106 f6007416                         mov     t1, r0               ' compare signs
0041c 107 f5607417                         xor     t1, r1
00420 108 f5087432                         and     t1, Bit31 wz
00424 109 ad900018           if_z          jmp     #cmp1                  ' same, then compare magnitude
                   
00428 10a f6007416                         mov     t1, r0               ' check for +0 or -0
0042c 10b f5407417                         or      t1, r1
00430 10c f5387432                         andn    t1, Bit31 wcz
00434 10d ad9ffd64           if_z          jmp     #returni
                   
00438 10e f7d02c32                         test    r0, Bit31 wc         ' compare signs
0043c 10f fd9ffd5c                         jmp     #returni
                   
00440 110 f7c82c32 cmp1                    test    r0, Bit31 wz         ' check signs
00444 111 5d900008           if_nz         jmp     #cmp2
00448 112 f2182c17                         cmp     r0, r1 wcz
0044c 113 fd9ffd4c                         jmp     #returni
00450 114 f2182e16 cmp2                    cmp     r1, r0 wcz           ' reverse test if negative
00454 115 fd9ffd44                         jmp     #returni
                   
                   '------------------------------------------------------------------------------
                   ' input:   r0        32-bit floating point value
                   '          r1        32-bit floating point value
                   ' output:  flagA        r0 flag bits (Nan, Infinity, Zero, Sign)
                   '          expA         r0 exponent (no bias)
                   '          manA         r0 mantissa (aligned to bit 29)
                   '          flagB        r1 flag bits (Nan, Infinity, Zero, Sign)
                   '          expB         r1 exponent (no bias)
                   '          manB         r1 mantissa (aligned to bit 29)
                   '          C flag       set if r0 or r1 is NaN
                   '          Z flag       set if r1 is zero
                   ' changes: r0, flagA, expA, manA, r1, flagB, expB, manB, t1
                   '------------------------------------------------------------------------------
                   
00458 116 f6007416 _Unpack2                mov     t1, r0               ' save A
0045c 117 f6002c17                         mov     r0, r1               ' unpack B to A
00460 118 fdb00024                         call    #_Unpack
                   
00464 119 f6002e16                         mov     r1, r0               ' save B variables
00468 11a f602c35e                         mov     flagB, flagA
0046c 11b f602c55f                         mov     expB, expA
00470 11c f602c760                         mov     manB, manA
                   
00474 11d f6002c3a                         mov     r0, t1               ' unpack A
00478 11e fdb0000c                         call    #_Unpack
0047c 11f 37cec208           if_nc         test    flagB, #NanFlag wz
00480 120 1d75e06f           if_nc_and_nz  modc    _set wc
00484 121 020ec600           _ret_         cmp     manB, #0 wz          ' set Z flag
                   
                   '------------------------------------------------------------------------------
                   ' input:   r0        32-bit floating point value
                   ' output:  flagA        r0 flag bits (Nan, Infinity, Zero, Sign)
                   '          expA         r0 exponent (no bias)
                   '          manA         r0 mantissa (aligned to bit 29)
                   '          C flag       set if r0 is NaN
                   '          Z flag       set if r0 is zero
                   ' changes: r0, flagA, expA, manA
                   '------------------------------------------------------------------------------
                   
00488 122 f602bc16 _Unpack                 mov     flagA, r0            ' get sign
0048c 123 f046bc1f                         shr     flagA, #31
00490 124 f602c016                         mov     manA, r0             ' get mantissa
00494 125 f502c15c                         and     manA, Mask23
00498 126 f602be16                         mov     expA, r0             ' get exponent
0049c 127 f066be01                         shl     expA, #1
004a0 128 f04ebe18                         shr     expA, #24 wz
004a4 129 ad900014           if_z          jmp     #zeroSubnormal         ' check for zero or subnormal
004a8 12a f20ebeff                         cmp     expA, #255 wz           ' check if finite
004ac 12b 5d90003c           if_nz         jmp     #finite
004b0 12c f6002d59                         mov     r0, NaN              ' no, then return NaN
004b4 12d f546bc08                         or      flagA, #NaNFlag
004b8 12e fd90003c                         jmp     #U_exit2
                   
004bc 12f f6007b60 zeroSubnormal           mov     t4, manA
004c0 130 f5487b5f                         or      t4, expA wz             ' check for zero
004c4 131 5d90000c           if_nz         jmp     #subnorm
004c8 132 f546bc02                         or      flagA, #ZeroFlag        ' yes, then set zero flag
004cc 133 f666be96                         neg     expA, #150              ' set exponent and exit
004d0 134 fd900024                         jmp     #U_exit2
                   
004d4 135 f066c007 subnorm                 shl     manA, #7                ' fix justification for subnormals
004d8 136 f7cac15d subnorm2                test    manA, Bit29 wz
004dc 137 5d900014           if_nz         jmp     #U_exit1
004e0 138 f066c001                         shl     manA, #1
004e4 139 f186be01                         sub     expA, #1
004e8 13a fd9fffec                         jmp     #subnorm2
                   
004ec 13b f066c006 finite                  shl     manA, #6                ' justify mantissa to bit 29
004f0 13c f542c15d                         or      manA, Bit29             ' add leading one bit
                   
004f4 13d f186be7f U_exit1                 sub     expA, #127              ' remove bias from exponent
004f8 13e f7d6bc08 U_exit2                 test    flagA, #NaNFlag wc      ' set C flag
004fc 13f 020ec000           _ret_         cmp     manA, #0 wz             ' set Z flag
                   
                   '------------------------------------------------------------------------------
                   ' input:   flagA        r0 flag bits (Nan, Infinity, Zero, Sign)
                   '          expA         r0 exponent (no bias)
                   '          manA         r0 mantissa (aligned to bit 29)
                   ' output:  r0        32-bit floating point value
                   ' changes: r0, flagA, expA, manA
                   '------------------------------------------------------------------------------
                   
00500 140 f20ec000 _Pack                   cmp     manA, #0 wz             ' check for zero
00504 141 a606be00           if_z          mov     expA, #0
00508 142 ad900040           if_z          jmp     #P_exit3
                   
0050c 143 f076c001 normalize_2             shl     manA, #1 wc             ' normalize the mantissa
00510 144 3186be01           if_nc         sub     expA, #1                ' adjust exponent
00514 145 3d9ffff4           if_nc         jmp     #normalize_2
                   
00518 146 f106be02                         add     expA, #2                ' adjust exponent
0051c 147 f116c100                         add     manA, #$100 wc          ' round up by 1/2 lsb
00520 148 c106be01           if_c          add     expA, #1
                   
00524 149 f106be7f                         add     expA, #127              ' add bias to exponent
00528 14a f342bf5b                         fges    expA, Minus23
0052c 14b f366beff                         fles    expA, #255
                   
00530 14c f256be01                         cmps    expA, #1 wc             ' check for subnormals
00534 14d 3d900014           if_nc         jmp     #P_exit3
                   
00538 14e f546c001 subnormal               or      manA, #1                ' adjust mantissa
0053c 14f f006c001                         ror     manA, #1
                   
00540 150 f662bf5f                         neg     expA, expA
00544 151 f042c15f                         shr     manA, expA
00548 152 f606be00                         mov     expA, #0                ' biased exponent = 0
                   
0054c 153 f6002d60 P_exit3                 mov     r0, manA             ' bits 22:0 mantissa
00550 154 f0442c09                         shr     r0, #9
00554 155 f066be17                         shl     expA, #23
00558 156 f5402d5f                         or      r0, expA
0055c 157 f066bc1f                         shl     flagA, #31
00560 158 05402d5e           _ret_          or      r0, flagA            ' bit 31 sign
                   
00564 159 7fffffff NaN                     long    $7FFF_FFFF
00568 15a 7f800000 Inf                     long    $7F80_0000
0056c 15b ffffffe9 Minus23                 long    -23
00570 15c 007fffff Mask23                  long    $007F_FFFF
00574 15d 20000000 Bit29                   long    $2000_0000
                   
00578 15e 00000000 flagA                   long    0
0057c 15f 00000000 expA                    long    0
00580 160 00000000 manA                    long    0
                   
00584 161 00000000 flagB                   long    0
00588 162 00000000 expB                    long    0
0058c 163 00000000 manB                    long    0
                   
                   '-------------------- End of Float32 Components -------------------------------
                   
                   ' lockbits must be in the same place in all NMM kernels
                   
00590 164                   fit    $1ea
007a8 1ea                   orgf   $1ea
                   
