                   '------------------------------------------------------------------------------------------------
                   
                   CON
                   
                   '------------------------------------------------------------------------------------------------
                   ' 1 Commands & Responses...
                   '------------------------------------------------------------------------------------------------
                   ' Command              Argument        Response/Data    Description
                     CMD0   = 0  +$40   ' 0               R1       -       GO_IDLE_STATE            *Reqs valid CRC
                     CMD1   = 1  +$40   ' 0               R1       -       SEND_OP_COND
                     ACMD41 = 41 +$40   ' $4000_0000      R1       -       APP_SEND_OP_COND         *Reqs CMD55 first
                     CMD8   = 8  +$40   ' 0               R1+R7    -       SEND_IF_COND             *Reqs valid CRC
                     CMD9   = 9  +$40   ' 0               R1       Y       SEND_CSD
                     CMD10  = 10 +$40   ' 0               R1       Y       SEND_CID
                   '  CMD12  = 12 +$40   ' 0               R2       -       STOP_TRANSMISSION
                     CMD13  = 13 +$40   ' 0               R2       -       SEND_STATUS
                     CMD16  = 16 +$40   ' BlkLen[31:0]    R1       -       SET_BLOCKLEN
                     CMD17  = 17 +$40   ' Addr[31:0]      R1       Y       READ_SINGLE_BLOCK
                   '  CMD18  = 18 +$40   ' Addr[31:0]      R1       Y       READ_MULTIPLE_BLOCK
                   '  CMD23  = 23 +$40   ' NoBlks[15:0]    R1       -       SET_BLOCK_COUNT
                   '  ACMD23 = 23 +$40   ' NoBlks[22:0]    R1       -       SET_WR_BLOCK_ERASE_COUNT *Reqs CMD55 first
                     CMD24  = 24 +$40   ' Addr[31:0]      R1       Y*      WRITE_BLOCK
                   '  CMD25  = 25 +$40   ' Addr[31:0]      R1       Y*      WRITE_MULTIPLE_BLOCK
                     CMD55  = 55 +$40   ' 0               R1       -       APP_CMD                  *Prefix for ACMD41/ACMD23
                     CMD58  = 58 +$40   ' 0               R1+R3    -       READ_OCR
                   
                   
                   ' R1 response:  $FF = busy/wait (0-8 bytes?)
                   '               b7: 0 (msb first)
                   '               b6: Parameter Error
                   '               b5: Address Error
                   '               b4: Erase Sequence Error
                   '               b3: Command CRC Error
                   '               b2: Illegal Command
                   '               b1: Erase Reset
                   '               b0: In Idle State
                   ' R1b response: ???
                   ' R3 response:  R1 + OCR(32b)
                   ' R7 response:  R1($01) + 32b(b11..b0 = $1AA = SDC V2 2V7-3V6, else reject)
                   '
                   ' DataPacket:   DataToken(1byte) + DataBlock(1-2048bytes) + CRC(2bytes)
                   '   DataToken:  $FE = CMD17/18/24 (read'1'block/read'n'blocks/write'1'block)
                   '               $FC = CMD25 (write'n'blocks)
                   '               $FD = CMD25 StopToken  (Single byte packet without data or CRC)
                   ' ErrorToken:   Single Byte Reply
                   '               b7-b5: 000
                   '               b4: Card Locked
                   '               b3: Out of Range
                   '               b2: Card ECC failed
                   '               b1: CC Error
                   '               b0: Error
                   ' DataResponse:
                   '               b7-b4: xxx0
                   '               $x5: Data Accepted
                   '               $xB: Data Rejected - CRC Error
                   '               $xD: Data Rejected - Write Error
                   
                   
                   DAT
                   
                   '
                   ' Check pin pull-up
                   '
131a4 045          check_pullup
131a4 045 fd63ec58         drvl    pa              ' drive pin low
131a8 046          check_pulldn
131a8 046 ff800000         waitx   ##300*1         ' wait >1us
131ac 047 fd66581f 
131b0 048 fd63ec50         fltl    pa              ' float pin
131b4 049 ff800002         waitx   ##300*5         ' wait >5us
131b8 04a fd67b81f 
131bc 04b 0d73ec40   _ret_ testp   pa      wc      ' sample pin
                   
                   '+-------[1 Card Initialisation ]--------------------------------------------+ <--- 1 initialisation --->
                   '+ On Entry:                                                                   +
                   '+ Call Format:                                                                +
                   '+              CALL    #_SDcard_Init                   '                      + < call: sd initialise >
                   '+ On Return:                                                                  +
                   '+      hub $20   = CSD[16] + CID[16]                   ' csd/cid data         +
                   '+      Returns  "Z" if ok, "NZ" if error                                      +
                   '+-----------------------------------------------------------------------------+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ 1 /SDHC/sdxc SPI Initialisation                                        +
                   '+-----------------------------------------------------------------------------+
                   '+      Send >74 clocks with /CS=1 & DI=1 starting & ending with CLK=0         +
                   '+-----------------------------------------------------------------------------+
131c0 04c          _SDcard_Init
131c0 04c f6065a20                 mov     _hubdata,         #$20          ' init hub data ptr=$20
                                                                           ' ie. after CLKFREQ ($14), CLKMODE ($18) & BAUDRATE ($1C)
                                   'callpa  #_SD_CS,          #check_pullup ' check for pull-up on sd_cs
                           'if_nc   jmp     #_fail '_pullup                 '
                   
131c4 04d fd647859                 drvh    #_SD_CS                         ' cs=1 & output
131c8 04e fd647a58                 drvl    #_SD_CK                         ' ck=0 & output
131cc 04f fd647659                 drvh    #_SD_DI                         ' di=1 & output
                   
131d0 050 f6064ec0                 mov     ctr1,             #(96*2)
131d4 051 ff800001 .count          waitx   ##delay5us                      '\ 5us+5us (ie 100KHz)
131d8 052 fd67081f 
131dc 053 fd647a4f                 outnot  #_SD_CK                         '| CLK=0-->1-->0
131e0 054 fb6e4ffc                 djnz    ctr1,             #.count       '/
131e4 055 ff800001                 waitx   ##delay5us                      '  CLK=0 (idle) & /CS=1
131e8 056 fd67081f 
                   '+-----------------------------------------------------------------------------+
                   '+ Software Reset:                                                             +
                   '+      CMD0,  PAR=$0,        CRC=$95, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
131ec 057 fd62501a .Command0       getct   ini_time                        '\ set timeout up to CMD9
131f0 058 ff000dbb                 mov     time_out,         ##delay10ms   '/
131f4 059 f6065340 
131f8 05a f6064e0a                 mov     ctr1,             #10           ' try a few times
131fc 05b f6063840 .again0         mov     cmdout,           #CMD0
13200 05c f6063a00                 mov     cmdpar,           #0
13204 05d f6063c95                 mov     cmdcrc,           #$95
                   '+-----------------------------------------------------------------------------+
13208 05e fdb0022c                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
1320c 05f 3f055d4a   if_nc         mov     time_out,         ##delay1s     ' increase timeout to 1s
13210 060 36065300 
                                                                           '\ $01(idle): 1 /MMC, not fully validated
13214 061 3d900050   if_nc         jmp     #.Command8                      '/ $00(good): (dane card response)
                   '+-----------------------------------------------------------------------------+
13218 062 ff800001                 waitx   ##delay5us                      ' delay 5us
1321c 063 fd67081f 
13220 064 fb6e4ff6                 djnz    ctr1,             #.again0      ' n: try again?
13224 065 fd9002c8                 jmp     #_fail '00                      '
                   
                   '+-----------------------------------------------------------------------------+
                   '+ _SD_Ready: check 1 card is ready (send $FF until $FF received)             +
                   '+            return Z if ok, NZ and reply on timeout                          +
                   '+-----------------------------------------------------------------------------+
13228 066 fd62501a _SD_Ready       getct   ini_time                        '\ set timeout
1322c 067 ff055d4a                 mov     time_out,         ##delay1s     '/
13230 068 f6065300 
13234 069 fd647848                 outl    #_SD_CS                         ' /CS=0 (enable)
13238 06a fdb0027c .again1         call    #_recvbyte                      ' read data byte
1323c 06b f20e42ff                 cmp     reply,            #$FF wz       ' $FF?
13240 06c ad900020         if_z    jmp     #.ready1
13244 06d fd62441a                 getct   replyR1                         '\ timeout ?
13248 06e f1824528                 sub     replyR1,          ini_time      '|
1324c 06f f2124529                 cmp     replyR1,          time_out  wc  '| c if < timeout
13250 070 3d90000c         if_nc   jmp     #.error1                        '/ n: not ready
13254 071 ff800001                 waitx   ##delay5us                      ' delay 5us
13258 072 fd67081f 
1325c 073 fd9fffd8                 jmp     #.again1                        ' try again
13260 074 f54e4300 .error1         or      reply,#$100 wz                  ' ensure NZ on error
13264 075 0d647849 .ready1 _RET_   outh    #_SD_CS                         ' /CS=1 (disable)
                   
                   '+=============================================================================+
                   
                   ' we know we now have an 1 /MMC card but its not fully validated yet...
                   '+-----------------------------------------------------------------------------+
                   '+ Check Voltage:                                                              +
                   '+      CMD8,  PAR=$1AA,      CRC=$87, REPLY=R1($01)+R7($xx1AA) ($05=try SDV1) +
                   '+-----------------------------------------------------------------------------+
13268 076 f6063848 .Command8       mov     cmdout,           #CMD8
1326c 077 f6063baa                 mov     cmdpar,           #$1AA
13270 078 f6063c87                 mov     cmdcrc,           #$87
                   '+-----------------------------------------------------------------------------+
13274 079 fdb001c0                 call    #_cmdR1R7        ' /CS=0, send cmd, recv R1+R7, /CS=1
                   '+-----------------------------------------------------------------------------+
13278 07a ed90001c   if_c_or_z     jmp     #.illegal                       ' j if <> $01 (not idle)
1327c 07b ff000007 .idle           and     reply,            ##$FFF        '\
13280 07c f50643ff 
13284 07d f20e43aa                 cmp     reply,            #$1AA     wz  '/ R7[11:0]=$1AA ?
13288 07e ff200000                 mov     cmdpar2,          ##$40000000   ' preset for SDV2
1328c 07f f6063e00 
13290 080 5d90025c   if_ne         jmp     #_fail '98                      ' n: unknown R7
13294 081 fd90000c                 jmp     #.Command55                     ' y: CMD55+ACMD41($4000_0000)
                   
13298 082 f20e4405 .illegal        cmp     replyR1,          #$05      wz  ' $05(illegal cmd) ?
1329c 083 5d900250   if_ne         jmp     #_fail '08                      ' <>$01/$05 (not idle/illegal)
132a0 084 f6063e00                 mov     cmdpar2,          #0            ' try SDV1
                                                                           ' CMD55+ACMD41($0) fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Prefix to ACMD41 & ACMD23:                                                  +
                   '+      CMD55, PAR=$0,        CRC=$xx, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
132a4 085 f6063877 .Command55      mov     cmdout,           #CMD55        '
132a8 086 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
132ac 087 fdb00180                 call    #_cmdRZA41       ' /CS=0, send cmd, recv R1, /CS=0(ena)
                   '+-----------------------------------------------------------------------------+
132b0 088 ed90023c   if_c_or_z     jmp     #_fail '55                      ' <>$01 (not idle)
                                                                           '              fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check SDV1/SDV2:  (follows CMD55)                                           +
                   '+     ACMD41, PAR=$0,        CRC=$xx, REPLY=R1($00)1 -V1                     +
                   '+     ACMD41, PAR=$40000000, CRC=$xx, REPLY=R1($00)1 -V2                     +
                   '+-----------------------------------------------------------------------------+
132b4 089 f6063869 .CommandA41     mov     cmdout,           #ACMD41       '
