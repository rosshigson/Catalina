160e0 09a fc223b1c         wypin   tmpch, txpin         ' ... so send <cr> to tx pin
160e4 09b f6063c01         mov     rxtx_flag,#1         ' enable rx/tx
160e8 09c fd64002d         ret
                   
                   '-------[ Transmit Char(s) ]--------------------------------------------------
