                   '-------[ Serial Initialize (uses SmartPins) ]--------------------------------
                   ' Call Format:
                   '      call      #serial_init       ' provide addr & baud
                   ' On Entry:
                   '      tmpch     = bitrate          ' tx & rx bit period + #(bits-1)
                   '                                   ' = (_clkfreq / _BAUDRATE) << 16 + 7
                   ' On Return:
                   '      tmpch = #0D
                   
160bc 091          serial_init
160bc 091 ff800000         wrpin   ##txmode, txpin      ' set asynchronous tx mode in smart pin tx
160c0 092 fc08f91c 
