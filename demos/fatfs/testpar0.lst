160c8 094 fd623841         dirh    txpin                ' enable smart pin tx
                   
160cc 095 ff800000         wrpin   ##rxmode, rxpin      ' set asynchronous rx mode in smart pin rx
160d0 096 fc087d1b 
160d4 097 fc123b1b         wxpin   tmpch, rxpin         ' set rx bit period + #(bits-1)
160d8 098 fd623641         dirh    rxpin                ' enable smart pin rx
                   
