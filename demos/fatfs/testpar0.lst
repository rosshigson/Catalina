160ec 09d fd723840         testp   txpin         wc     ' wait for buffer empty on tx pin
160f0 09e 3d9ffff8  if_nc  jmp     #serial_tx           '
160f4 09f fc223b1c         wypin   tmpch, txpin         ' send byte (bits7:0) to tx pin
                   
160f8 0a0 f04e3a08         shr     tmpch, #8     wz     ' any more chars to send?
160fc 0a1 5d9fffec  if_nz  jmp     #serial_tx           ' (nz = another char in tmpch)
16100 0a2 fd64002d         ret
                   
                   '-------[ Receive a char ]----------------------------------------------------
