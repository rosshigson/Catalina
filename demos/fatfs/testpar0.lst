16c70 041 f6641401         neg     .rslt,#1
16c74 042 fd64002d         ret
                   
16c78 043          .SD_StopIO
                   ' ??? not implemented - disable 1 card ???
16c78 043 f6641401         neg     .rslt,#1
16c7c 044 fd64002d         ret
                   
                   '------------------------------------------------------------------------------------------------
                   
                   CON
                   
                   '------------------------------------------------------------------------------------------------
                   ' 1 Commands & Responses...
                   '------------------------------------------------------------------------------------------------
                   ' Command              Argument        Response/Data    Description
                     CMD0   = 0  +$40   ' 0               R1       -       GO_IDLE_STATE            *Reqs valid CRC
                     CMD1   = 1  +$40   ' 0               R1       -       SEND_OP_COND
                     ACMD41 = 41 +$40   ' $4000_0000      R1       -       APP_SEND_OP_COND         *Reqs CMD55 first
                     CMD8   = 8  +$40   ' 0               R1+R7    -       SEND_IF_COND             *Reqs valid CRC
                     CMD9   = 9  +$40   ' 0               R1       Y       SEND_CSD
                     CMD10  = 10 +$40   ' 0               R1       Y       SEND_CID
                   '  CMD12  = 12 +$40   ' 0               R2       -       STOP_TRANSMISSION
                     CMD13  = 13 +$40   ' 0               R2       -       SEND_STATUS
                     CMD16  = 16 +$40   ' BlkLen[31:0]    R1       -       SET_BLOCKLEN
                     CMD17  = 17 +$40   ' Addr[31:0]      R1       Y       READ_SINGLE_BLOCK
                   '  CMD18  = 18 +$40   ' Addr[31:0]      R1       Y       READ_MULTIPLE_BLOCK
                   '  CMD23  = 23 +$40   ' NoBlks[15:0]    R1       -       SET_BLOCK_COUNT
                   '  ACMD23 = 23 +$40   ' NoBlks[22:0]    R1       -       SET_WR_BLOCK_ERASE_COUNT *Reqs CMD55 first
                     CMD24  = 24 +$40   ' Addr[31:0]      R1       Y*      WRITE_BLOCK
                   '  CMD25  = 25 +$40   ' Addr[31:0]      R1       Y*      WRITE_MULTIPLE_BLOCK
                     CMD55  = 55 +$40   ' 0               R1       -       APP_CMD                  *Prefix for ACMD41/ACMD23
                     CMD58  = 58 +$40   ' 0               R1+R3    -       READ_OCR
                   
                   
                   ' R1 response:  $FF = busy/wait (0-8 bytes?)
                   '               b7: 0 (msb first)
                   '               b6: Parameter Error
                   '               b5: Address Error
                   '               b4: Erase Sequence Error
                   '               b3: Command CRC Error
                   '               b2: Illegal Command
                   '               b1: Erase Reset
                   '               b0: In Idle State
                   ' R1b response: ???
                   ' R3 response:  R1 + OCR(32b)
                   ' R7 response:  R1($01) + 32b(b11..b0 = $1AA = SDC V2 2V7-3V6, else reject)
                   '
                   ' DataPacket:   DataToken(1byte) + DataBlock(1-2048bytes) + CRC(2bytes)
                   '   DataToken:  $FE = CMD17/18/24 (read'1'block/read'n'blocks/write'1'block)
                   '               $FC = CMD25 (write'n'blocks)
                   '               $FD = CMD25 StopToken  (Single byte packet without data or CRC)
                   ' ErrorToken:   Single Byte Reply
                   '               b7-b5: 000
                   '               b4: Card Locked
                   '               b3: Out of Range
                   '               b2: Card ECC failed
                   '               b1: CC Error
                   '               b0: Error
                   ' DataResponse:
                   '               b7-b4: xxx0
                   '               $x5: Data Accepted
                   '               $xB: Data Rejected - CRC Error
                   '               $xD: Data Rejected - Write Error
                   
                   
                   DAT
                   
                   '
                   ' Check pin pull-up
                   '
16c80 045          check_pullup
16c80 045 fd63ec58         drvl    pa              ' drive pin low
16c84 046          check_pulldn
16c84 046 ff800000         waitx   ##300*1         ' wait >1us
16c88 047 fd66581f 
16c8c 048 fd63ec50         fltl    pa              ' float pin
16c90 049 ff800002         waitx   ##300*5         ' wait >5us
16c94 04a fd67b81f 
16c98 04b 0d73ec40   _ret_ testp   pa      wc      ' sample pin
                   
                   '+-------[1 Card Initialisation ]--------------------------------------------+ <--- 1 initialisation --->
                   '+ On Entry:                                                                   +
                   '+ Call Format:                                                                +
                   '+              CALL    #_SDcard_Init                   '                      + < call: sd initialise >
                   '+ On Return:                                                                  +
                   '+      hub $20   = CSD[16] + CID[16]                   ' csd/cid data         +
                   '+      Returns  "Z" if ok, "NZ" if error                                      +
                   '+-----------------------------------------------------------------------------+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ 1 /SDHC/sdxc SPI Initialisation                                        +
                   '+-----------------------------------------------------------------------------+
                   '+      Send >74 clocks with /CS=1 & DI=1 starting & ending with CLK=0         +
                   '+-----------------------------------------------------------------------------+
16c9c 04c          _SDcard_Init
16c9c 04c f6065a20                 mov     _hubdata,         #$20          ' init hub data ptr=$20
                                                                           ' ie. after CLKFREQ ($14), CLKMODE ($18) & BAUDRATE ($1C)
                                   'callpa  #_SD_CS,          #check_pullup ' check for pull-up on sd_cs
                           'if_nc   jmp     #_fail '_pullup                 '
                   
16ca0 04d fd647859                 drvh    #_SD_CS                         ' cs=1 & output
16ca4 04e fd647a58                 drvl    #_SD_CK                         ' ck=0 & output
16ca8 04f fd647659                 drvh    #_SD_DI                         ' di=1 & output
                   
16cac 050 f6064ec0                 mov     ctr1,             #(96*2)
16cb0 051 ff800001 .count          waitx   ##delay5us                      '\ 5us+5us (ie 100KHz)
16cb4 052 fd67081f 
16cb8 053 fd647a4f                 outnot  #_SD_CK                         '| CLK=0-->1-->0
16cbc 054 fb6e4ffc                 djnz    ctr1,             #.count       '/
16cc0 055 ff800001                 waitx   ##delay5us                      '  CLK=0 (idle) & /CS=1
16cc4 056 fd67081f 
                   '+-----------------------------------------------------------------------------+
                   '+ Software Reset:                                                             +
                   '+      CMD0,  PAR=$0,        CRC=$95, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
16cc8 057 fd62501a .Command0       getct   ini_time                        '\ set timeout up to CMD9
16ccc 058 ff000dbb                 mov     time_out,         ##delay10ms   '/
16cd0 059 f6065340 
16cd4 05a f6064e0a                 mov     ctr1,             #10           ' try a few times
16cd8 05b f6063840 .again0         mov     cmdout,           #CMD0
16cdc 05c f6063a00                 mov     cmdpar,           #0
16ce0 05d f6063c95                 mov     cmdcrc,           #$95
                   '+-----------------------------------------------------------------------------+
16ce4 05e fdb0022c                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
16ce8 05f 3f055d4a   if_nc         mov     time_out,         ##delay1s     ' increase timeout to 1s
16cec 060 36065300 
                                                                           '\ $01(idle): 1 /MMC, not fully validated
16cf0 061 3d900050   if_nc         jmp     #.Command8                      '/ $00(good): (dane card response)
                   '+-----------------------------------------------------------------------------+
16cf4 062 ff800001                 waitx   ##delay5us                      ' delay 5us
16cf8 063 fd67081f 
16cfc 064 fb6e4ff6                 djnz    ctr1,             #.again0      ' n: try again?
16d00 065 fd9002c8                 jmp     #_fail '00                      '
                   
                   '+-----------------------------------------------------------------------------+
                   '+ _SD_Ready: check 1 card is ready (send $FF until $FF received)             +
                   '+            return Z if ok, NZ and reply on timeout                          +
                   '+-----------------------------------------------------------------------------+
16d04 066 fd62501a _SD_Ready       getct   ini_time                        '\ set timeout
16d08 067 ff055d4a                 mov     time_out,         ##delay1s     '/
16d0c 068 f6065300 
16d10 069 fd647848                 outl    #_SD_CS                         ' /CS=0 (enable)
16d14 06a fdb0027c .again1         call    #_recvbyte                      ' read data byte
16d18 06b f20e42ff                 cmp     reply,            #$FF wz       ' $FF?
16d1c 06c ad900020         if_z    jmp     #.ready1
16d20 06d fd62441a                 getct   replyR1                         '\ timeout ?
16d24 06e f1824528                 sub     replyR1,          ini_time      '|
16d28 06f f2124529                 cmp     replyR1,          time_out  wc  '| c if < timeout
16d2c 070 3d90000c         if_nc   jmp     #.error1                        '/ n: not ready
16d30 071 ff800001                 waitx   ##delay5us                      ' delay 5us
16d34 072 fd67081f 
16d38 073 fd9fffd8                 jmp     #.again1                        ' try again
16d3c 074 f54e4300 .error1         or      reply,#$100 wz                  ' ensure NZ on error
16d40 075 0d647849 .ready1 _RET_   outh    #_SD_CS                         ' /CS=1 (disable)
                   
                   '+=============================================================================+
                   
                   ' we know we now have an 1 /MMC card but its not fully validated yet...
                   '+-----------------------------------------------------------------------------+
                   '+ Check Voltage:                                                              +
                   '+      CMD8,  PAR=$1AA,      CRC=$87, REPLY=R1($01)+R7($xx1AA) ($05=try SDV1) +
                   '+-----------------------------------------------------------------------------+
16d44 076 f6063848 .Command8       mov     cmdout,           #CMD8
16d48 077 f6063baa                 mov     cmdpar,           #$1AA
16d4c 078 f6063c87                 mov     cmdcrc,           #$87
                   '+-----------------------------------------------------------------------------+
16d50 079 fdb001c0                 call    #_cmdR1R7        ' /CS=0, send cmd, recv R1+R7, /CS=1
                   '+-----------------------------------------------------------------------------+
16d54 07a ed90001c   if_c_or_z     jmp     #.illegal                       ' j if <> $01 (not idle)
16d58 07b ff000007 .idle           and     reply,            ##$FFF        '\
16d5c 07c f50643ff 
16d60 07d f20e43aa                 cmp     reply,            #$1AA     wz  '/ R7[11:0]=$1AA ?
16d64 07e ff200000                 mov     cmdpar2,          ##$40000000   ' preset for SDV2
16d68 07f f6063e00 
16d6c 080 5d90025c   if_ne         jmp     #_fail '98                      ' n: unknown R7
16d70 081 fd90000c                 jmp     #.Command55                     ' y: CMD55+ACMD41($4000_0000)
                   
16d74 082 f20e4405 .illegal        cmp     replyR1,          #$05      wz  ' $05(illegal cmd) ?
16d78 083 5d900250   if_ne         jmp     #_fail '08                      ' <>$01/$05 (not idle/illegal)
16d7c 084 f6063e00                 mov     cmdpar2,          #0            ' try SDV1
                                                                           ' CMD55+ACMD41($0) fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Prefix to ACMD41 & ACMD23:                                                  +
                   '+      CMD55, PAR=$0,        CRC=$xx, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
16d80 085 f6063877 .Command55      mov     cmdout,           #CMD55        '
16d84 086 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
16d88 087 fdb00180                 call    #_cmdRZA41       ' /CS=0, send cmd, recv R1, /CS=0(ena)
                   '+-----------------------------------------------------------------------------+
16d8c 088 ed90023c   if_c_or_z     jmp     #_fail '55                      ' <>$01 (not idle)
                                                                           '              fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check SDV1/SDV2:  (follows CMD55)                                           +
                   '+     ACMD41, PAR=$0,        CRC=$xx, REPLY=R1($00)1 -V1                     +
                   '+     ACMD41, PAR=$40000000, CRC=$xx, REPLY=R1($00)1 -V2                     +
                   '+-----------------------------------------------------------------------------+
16d90 089 f6063869 .CommandA41     mov     cmdout,           #ACMD41       '
16d94 08a f6023b1f                 mov     cmdpar,           cmdpar2       ' SDV1=0 / SDV2=$40000000
                   '+-----------------------------------------------------------------------------+
16d98 08b fdb00178                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
16d9c 08c 1d9fffe0   if_nc_and_nz  jmp     #.Command55                     '  =$01(busy): CMD55+CMD41 again
16da0 08d cd900228   if_c          jmp     #_fail '41                      ' <>$00/$01: error
                   
16da4 08e f20e3e00                 cmp     cmdpar2,          #0        wz  ' SDV1 ?
16da8 08f a6065409         if_z    mov     blocksh,          #9            ' y: #1 SDV1(byte address)
16dac 090 ad90001c         if_z    jmp     #.Command16                     ' y: SDV1 does not use CMD58
                                                                           ' SDV2         fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check OCR CCS bit:                                                          +
                   '+      CMD58, PAR=$0,        CRC=$xx, REPLY=R1($00)+R3(b30=1)                 +
                   '+-----------------------------------------------------------------------------+
16db0 091 f606387a .Command58      mov     cmdout,           #CMD58        ' SDHC ?
16db4 092 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
16db8 093 fdb00158                 call    #_cmdR1R3        ' /CS=0, send cmd, recv R1+R3, /CS=1
                   '+-----------------------------------------------------------------------------+
16dbc 094 dd90020c   if_c_or_nz    jmp     #_fail '58                      ' <>$00(good): error
16dc0 095 f42e421e                 testbn  reply,            #30       wz  ' bit30=CCS=1? $40000000?
16dc4 096 a6065409         if_z    mov     blocksh,          #9            ' n: #2 SDV2(byte address)
16dc8 097 56065400         if_nz   mov     blocksh,          #0            ' y: #3 SDHC/SDV2(block address)
                   ''      if_nz   jmp     #.Command9x                     ' y: does not req cmd16?                        ?????????
                                                                           ' SDV2(byte)   fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Force block size to 512 bytes:                                              +
                   '+      CMD16, PAR=$200,      CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
16dcc 098 f6063850 .Command16      mov     cmdout,           #CMD16        ' force blocksize=512bytes
16dd0 099 ff000001                 mov     cmdpar,           ##512         ' 512 bytes
16dd4 09a f6063a00 
                   '+-----------------------------------------------------------------------------+
16dd8 09b fdb00138                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
16ddc 09c 1d9fffec   if_nc_and_nz  jmp     #.Command16                     '  =$01(idle): again
16de0 09d dd9001e8   if_c_or_nz    jmp     #_fail '16                      ' <>$00(good): error
                   '+-----------------------------------------------------------------------------+
16de4 09e f602572d .Command9x      mov     bufaddr,          _hubdata      ' where to store CSD/CID
                   '+-----------------------------------------------------------------------------+
                   '+ Read CSD register (16 bytes):                                               +
                   '+      CMD9,  PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
16de8 09f f6063849 .Command9       mov     cmdout,           #CMD9         ' read CSD register
16dec 0a0 fdb00044                 call    #_readREG                       '
                   '+-----------------------------------------------------------------------------+
                   '+ Read CID register (16 bytes):                                               +
                   '+      CMD10, PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
16df0 0a1 f606384a .Command10      mov     cmdout,           #CMD10        ' read CID register
16df4 0a2 fdb0003c                 call    #_readREG                       '
                   '+-----------------------------------------------------------------------------+
16df8 0a3 0d6c1e6f         _RET_   MODZ    _set                      wz    ' "Z" = success
                   '+=============================================================================+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ Read Sector:                                                                +
                   '+-----------------------------------------------------------------------------+
16dfc 0a4          _readSECTOR
                   '+-----------------------------------------------------------------------------+
                   '+ Read Block/Sector:  (512 bytes)                                             +
                   '+      CMD17, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
16dfc 0a4 ff000001 .Command17      mov     bytescnt,         ##512         ' read block (no. bytes)
16e00 0a5 f6064a00 
16e04 0a6 f6063851                 mov     cmdout,           #CMD17        '
16e08 0a7 f6023b2c                 mov     cmdpar,           blocknr       '
16e0c 0a8 f0623b2a                 shl     cmdpar,           blocksh       ' <<0 or <<9
                   '+-----------------------------------------------------------------------------+
16e10 0a9 fdb00028                 call    #_readBLOCK                     ' read 512 bytes
                   '+-----------------------------------------------------------------------------+
16e14 0aa fd64002d                 RET                                     ' "Z" = success
                   '+-----------------------------------------------------------------------------+
                   '+ Write Sector:                                                               +
                   '+-----------------------------------------------------------------------------+
16e18 0ab          _writeSECTOR
                   '+-----------------------------------------------------------------------------+
                   '+ Write Block/Sector:  (512 bytes)                                            +
                   '+      CMD24, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
16e18 0ab ff000001 .Command24      mov     bytescnt,         ##512         ' write block (no. bytes)
16e1c 0ac f6064a00 
16e20 0ad f6063858                 mov     cmdout,           #CMD24        '
16e24 0ae f6023b2c                 mov     cmdpar,           blocknr       '
16e28 0af f0623b2a                 shl     cmdpar,           blocksh       ' <<0 or <<9
                   '+-----------------------------------------------------------------------------+
16e2c 0b0 fdb0005c                 call    #_writeBLOCK                    ' write 512 bytes
                   '+-----------------------------------------------------------------------------+
16e30 0b1 fd64002d                 RET                                     ' "Z" = success
                   '+=============================================================================+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ Read Block/Sector:  (512 bytes)                                             +
                   '+      CMD9,  PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+      CMD10, PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+      CMD17, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
16e34 0b2 f6064a10 _readREG        mov     bytescnt,         #16           ' CMD9,10: CSD,CID register
16e38 0b3 f6063a00                 mov     cmdpar,           #0            '        PAR=$0,      16 bytes
16e3c 0b4          _readBLOCK                                              ' CMD17: PAR=sector, 512 bytes
16e3c 0b4 fd62501a                 getct   ini_time                        '\ set timeout for cmd9,10,17
16e40 0b5 ff055d4a                 mov     time_out,         ##delay1s     '/
16e44 0b6 f6065300 
                   '+-----------------------------------------------------------------------------+
16e48 0b7 fdb000c0                 call    #_cmdRZtoken     ' /CS=0, send cmd, recv R1, /CS=0(ena)
16e4c 0b8 5d90017c         if_nz   jmp     #_fail '17                      ' <>$00(good): error
                   '+-----------------------------------------------------------------------------+
16e50 0b9 fdb000f8                 call    #_getreply                      ' n*$FF+$FE
16e54 0ba f20e42fe                 cmp     reply,            #$FE      wz  ' $FE=valid Data Token
16e58 0bb ad900008         if_z    jmp     #.readbyte
16e5c 0bc f5464300                 or      reply,#$100                     ' ensure we don't return 0 on error!
16e60 0bd fd900168                 jmp     #_fail '97                      '
                    '+-----------------------------------------------------------------------------+
16e64 0be fdb0012c .readbyte       call    #_recvbyte                      ' read data byte
16e68 0bf fc42432b                 wrbyte  reply,            bufaddr       ' save byte
16e6c 0c0 f1065601                 add     bufaddr,          #1            ' bufaddr++
16e70 0c1 fb6e4bfc                 djnz    bytescnt,         #.readbyte    ' byte--
16e74 0c2 fdb0011c                 call    #_recvbyte                      ' read CRC16 1/2
16e78 0c3 fdb00118                 call    #_recvbyte                      ' read CRC16 2/2
                   ' NOTE: CRC16 not checked - do we want to do this?                                         ??????????
16e7c 0c4 fd647a48                 outl    #_SD_CK                         ' CLK=0 (idle)          already=0
16e80 0c5 fdb00110                 call    #_recvbyte                      ' SEND 8 CLOCKS BEFORE DISABLING CS
16e84 0c6 fd647849                 outh    #_SD_CS                         ' /CS=1 (disable)
16e88 0c7 0d6c1e6f         _RET_   MODZ    _set                        wz  ' "Z" = success
                   '+=============================================================================+
                   '+-----------------------------------------------------------------------------+
                   '+ Write Block/Sector:  (512 bytes)                                            +
                   '+      CMD24, PAR=blocknr                                                     +
                   '+-----------------------------------------------------------------------------+
16e8c 0c8          _writeBLOCK                                             ' CMD24: PAR=sector, 512 bytes
16e8c 0c8 fd62501a                 getct   ini_time                        '\ set timeout for cmd24
16e90 0c9 ff0aba95                 mov     time_out,         ##delay2s     '/
16e94 0ca f6065200 
                   '+-----------------------------------------------------------------------------+
16e98 0cb fdb00070                 call    #_cmdRZtoken     ' /CS=0, send cmd, recv R1, /CS=0(ena)
16e9c 0cc 5d90012c         if_nz   jmp     #_fail '24                      ' <>$00(good): error
                   '+-----------------------------------------------------------------------------+
16ea0 0cd f60648fe                 mov     dataout,          #$FE          ' start block token
16ea4 0ce fdb000f0                 call    #_sendbyte                      ' write data byte
                   '+-----------------------------------------------------------------------------+
16ea8 0cf fac2492b .writebyte      rdbyte  dataout,          bufaddr       ' load byte
16eac 0d0 fdb000e8                 call    #_sendbyte                      ' write data byte
16eb0 0d1 f1065601                 add     bufaddr,          #1            ' bufaddr++
16eb4 0d2 fb6e4bfc                 djnz    bytescnt,         #.writebyte   ' byte--
                   ' NOTE: CRC16 is ignored in SPI mode
16eb8 0d3 fdb000d8                 call    #_sendFF                        ' CRC16 byte 1/2
16ebc 0d4 fdb000d4                 call    #_sendFF                        ' CRC16 byte 2/2
16ec0 0d5 ff800dbb                 waitx   ## delay10ms                      ' why is this necessary???
16ec4 0d6 fd66801f 
16ec8 0d7 fdb00080                 call    #_getreply                      '
16ecc 0d8 f506421f                 and     reply,            #$1f
16ed0 0d9 f20e4205                 cmp     reply,            #$5 wz
16ed4 0da ad900008        if_z     jmp     #.waitdelay
16ed8 0db f5464300                 or      reply,#$100                     ' ensure reply is not zero
16edc 0dc fd9000ec                 jmp     #_fail
16ee0 0dd          .waitdelay
16ee0 0dd ff800dbb                 waitx   ## delay10ms                      ' why is this necessary???
16ee4 0de fd66801f 
16ee8 0df          .waitbusy
16ee8 0df fdb000a8                 call    #_recvbyte                      ' get a byte
16eec 0e0 f20e42ff                 cmp     reply,            #$FF      wz  ' reply=$FF=busy ?
16ef0 0e1 5d900014         if_nz   jmp     #.writedone                     ' n: done
16ef4 0e2 fd62441a                 getct   replyR1                         '\ y: timeout ?
16ef8 0e3 f1824528                 sub     replyR1,          ini_time      '|
16efc 0e4 f2124529                 cmp     replyR1,          time_out  wc  '| c if < timeout
16f00 0e5 cd9fffe4         if_c    jmp     #.waitbusy                      '| n: try again
16f04 0e6 fd9000c4                 jmp     #_fail '90                      '/ y: timed out
16f08 0e7          .writedone
16f08 0e7 0d641e6f         _RET_   MODZ    _set                            ' "Z" = success
                   '+=============================================================================+
                   '+-----------------------------------------------------------------------------+
                   '+      SEND: CMDx, PARx, CRCx, GET REPLY                                      +
                   '+-----------------------------------------------------------------------------+
16f0c 0e8          _cmdRZA41                                               ' CMD55:       R1 response
16f0c 0e8          _cmdRZtoken                                             ' CMD9,10,17,24: R1+$FE response
16f0c 0e8 f6064001                 mov     cmdtype,          #1            ' returns w /CS=0(ena)
16f10 0e9 fd900004                 jmp     #_cmdxx                         '
16f14 0ea          _cmdR1R3                                                ' CMD58:    R1+R3 response
16f14 0ea          _cmdR1R7                                                ' CMD8:     R1+R7 response
16f14 0ea          _cmdR1                                                  ' CMD0,A41,16: R1 response
16f14 0ea f6064000                 mov     cmdtype,          #0            ' returns w /CS=1(disabled)
16f18 0eb          _cmdxx                                                  '
                   '+-----------------------------------------------------------------------------+
16f18 0eb fd647848                 outl    #_SD_CS                         ' /CS=0 (enable)
                   '+-----------------------------------------------------------------------------+
16f1c 0ec fdb00074                 call    #_sendFF                        ' send $FF byte first
16f20 0ed f602491c                 mov     dataout,          cmdout        ' CMD
16f24 0ee fdb00070                 call    #_sendbyte                      ' send cmd byte
16f28 0ef f602491d                 mov     dataout,          cmdpar        ' Parameter
16f2c 0f0 fdb0005c                 call    #_sendlong                      ' send 4 bytes (MSB first)
16f30 0f1 f602491e                 mov     dataout,          cmdcrc        ' CRC
16f34 0f2 fdb00060                 call    #_sendbyte                      ' send crc byte
                   '+-----------------------------------------------------------------------------+
16f38 0f3 fdb00010                 call    #_getreply                      ' recv R1/R1+R3/R1+R7/RZ..+Token
                   '+-----------------------------------------------------------------------------+
16f3c 0f4 fd647a48                 outl    #_SD_CK                         ' CLK=0 (idle)           already=0
                   
16f40 0f5 fd624031                 skip    cmdtype                         '\ skips next instr if #1
16f44 0f6 fd647849                 outh    #_SD_CS                         '| /CS=1(disable) if reqd
16f48 0f7 fd64002d               RET                                       '/ else /CS=0 cmdRZA41/cmdRZtoken
                   '+=============================================================================+
                   
                   '+-----------------------------------------------------------------------------+
