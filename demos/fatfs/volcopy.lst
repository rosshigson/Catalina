                   '------------------------------------------------------------------------------------------------
                   
                   CON
                   
                   '------------------------------------------------------------------------------------------------
                   ' 1 Commands & Responses...
                   '------------------------------------------------------------------------------------------------
                   ' Command              Argument        Response/Data    Description
                     CMD0   = 0  +$40   ' 0               R1       -       GO_IDLE_STATE            *Reqs valid CRC
                     CMD1   = 1  +$40   ' 0               R1       -       SEND_OP_COND
                     ACMD41 = 41 +$40   ' $4000_0000      R1       -       APP_SEND_OP_COND         *Reqs CMD55 first
                     CMD8   = 8  +$40   ' 0               R1+R7    -       SEND_IF_COND             *Reqs valid CRC
                     CMD9   = 9  +$40   ' 0               R1       Y       SEND_CSD
                     CMD10  = 10 +$40   ' 0               R1       Y       SEND_CID
                   '  CMD12  = 12 +$40   ' 0               R2       -       STOP_TRANSMISSION
                     CMD13  = 13 +$40   ' 0               R2       -       SEND_STATUS
                     CMD16  = 16 +$40   ' BlkLen[31:0]    R1       -       SET_BLOCKLEN
                     CMD17  = 17 +$40   ' Addr[31:0]      R1       Y       READ_SINGLE_BLOCK
                   '  CMD18  = 18 +$40   ' Addr[31:0]      R1       Y       READ_MULTIPLE_BLOCK
                   '  CMD23  = 23 +$40   ' NoBlks[15:0]    R1       -       SET_BLOCK_COUNT
                   '  ACMD23 = 23 +$40   ' NoBlks[22:0]    R1       -       SET_WR_BLOCK_ERASE_COUNT *Reqs CMD55 first
                     CMD24  = 24 +$40   ' Addr[31:0]      R1       Y*      WRITE_BLOCK
                   '  CMD25  = 25 +$40   ' Addr[31:0]      R1       Y*      WRITE_MULTIPLE_BLOCK
                     CMD55  = 55 +$40   ' 0               R1       -       APP_CMD                  *Prefix for ACMD41/ACMD23
                     CMD58  = 58 +$40   ' 0               R1+R3    -       READ_OCR
                   
                   
                   ' R1 response:  $FF = busy/wait (0-8 bytes?)
                   '               b7: 0 (msb first)
                   '               b6: Parameter Error
                   '               b5: Address Error
                   '               b4: Erase Sequence Error
                   '               b3: Command CRC Error
                   '               b2: Illegal Command
                   '               b1: Erase Reset
                   '               b0: In Idle State
                   ' R1b response: ???
                   ' R3 response:  R1 + OCR(32b)
                   ' R7 response:  R1($01) + 32b(b11..b0 = $1AA = SDC V2 2V7-3V6, else reject)
                   '
                   ' DataPacket:   DataToken(1byte) + DataBlock(1-2048bytes) + CRC(2bytes)
                   '   DataToken:  $FE = CMD17/18/24 (read'1'block/read'n'blocks/write'1'block)
                   '               $FC = CMD25 (write'n'blocks)
                   '               $FD = CMD25 StopToken  (Single byte packet without data or CRC)
                   ' ErrorToken:   Single Byte Reply
                   '               b7-b5: 000
                   '               b4: Card Locked
                   '               b3: Out of Range
                   '               b2: Card ECC failed
                   '               b1: CC Error
                   '               b0: Error
                   ' DataResponse:
                   '               b7-b4: xxx0
                   '               $x5: Data Accepted
                   '               $xB: Data Rejected - CRC Error
                   '               $xD: Data Rejected - Write Error
                   
                   
                   DAT
                   
                   '
                   ' Check pin pull-up
                   '
18610 045          check_pullup
18610 045 fd63ec58         drvl    pa              ' drive pin low
18614 046          check_pulldn
18614 046 ff800000         waitx   ##300*1         ' wait >1us
18618 047 fd66581f 
1861c 048 fd63ec50         fltl    pa              ' float pin
18620 049 ff800002         waitx   ##300*5         ' wait >5us
18624 04a fd67b81f 
18628 04b 0d73ec40   _ret_ testp   pa      wc      ' sample pin
                   
                   '+-------[1 Card Initialisation ]--------------------------------------------+ <--- 1 initialisation --->
                   '+ On Entry:                                                                   +
                   '+ Call Format:                                                                +
                   '+              CALL    #_SDcard_Init                   '                      + < call: sd initialise >
                   '+ On Return:                                                                  +
                   '+      hub $20   = CSD[16] + CID[16]                   ' csd/cid data         +
                   '+      Returns  "Z" if ok, "NZ" if error                                      +
                   '+-----------------------------------------------------------------------------+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ 1 /SDHC/sdxc SPI Initialisation                                        +
                   '+-----------------------------------------------------------------------------+
                   '+      Send >74 clocks with /CS=1 & DI=1 starting & ending with CLK=0         +
                   '+-----------------------------------------------------------------------------+
1862c 04c          _SDcard_Init
1862c 04c f6065a20                 mov     _hubdata,         #$20          ' init hub data ptr=$20
                                                                           ' ie. after CLKFREQ ($14), CLKMODE ($18) & BAUDRATE ($1C)
                                   'callpa  #_SD_CS,          #check_pullup ' check for pull-up on sd_cs
                           'if_nc   jmp     #_fail '_pullup                 '
                   
18630 04d fd647859                 drvh    #_SD_CS                         ' cs=1 & output
18634 04e fd647a58                 drvl    #_SD_CK                         ' ck=0 & output
18638 04f fd647659                 drvh    #_SD_DI                         ' di=1 & output
                   
1863c 050 f6064ec0                 mov     ctr1,             #(96*2)
18640 051 ff800001 .count          waitx   ##delay5us                      '\ 5us+5us (ie 100KHz)
18644 052 fd67081f 
18648 053 fd647a4f                 outnot  #_SD_CK                         '| CLK=0-->1-->0
1864c 054 fb6e4ffc                 djnz    ctr1,             #.count       '/
18650 055 ff800001                 waitx   ##delay5us                      '  CLK=0 (idle) & /CS=1
18654 056 fd67081f 
                   '+-----------------------------------------------------------------------------+
                   '+ Software Reset:                                                             +
                   '+      CMD0,  PAR=$0,        CRC=$95, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
18658 057 fd62501a .Command0       getct   ini_time                        '\ set timeout up to CMD9
1865c 058 ff000dbb                 mov     time_out,         ##delay10ms   '/
18660 059 f6065340 
18664 05a f6064e0a                 mov     ctr1,             #10           ' try a few times
18668 05b f6063840 .again0         mov     cmdout,           #CMD0
1866c 05c f6063a00                 mov     cmdpar,           #0
18670 05d f6063c95                 mov     cmdcrc,           #$95
                   '+-----------------------------------------------------------------------------+
18674 05e fdb0022c                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
18678 05f 3f055d4a   if_nc         mov     time_out,         ##delay1s     ' increase timeout to 1s
1867c 060 36065300 
                                                                           '\ $01(idle): 1 /MMC, not fully validated
18680 061 3d900050   if_nc         jmp     #.Command8                      '/ $00(good): (dane card response)
                   '+-----------------------------------------------------------------------------+
18684 062 ff800001                 waitx   ##delay5us                      ' delay 5us
18688 063 fd67081f 
1868c 064 fb6e4ff6                 djnz    ctr1,             #.again0      ' n: try again?
18690 065 fd9002c8                 jmp     #_fail '00                      '
                   
                   '+-----------------------------------------------------------------------------+
                   '+ _SD_Ready: check 1 card is ready (send $FF until $FF received)             +
                   '+            return Z if ok, NZ and reply on timeout                          +
                   '+-----------------------------------------------------------------------------+
18694 066 fd62501a _SD_Ready       getct   ini_time                        '\ set timeout
18698 067 ff055d4a                 mov     time_out,         ##delay1s     '/
1869c 068 f6065300 
186a0 069 fd647848                 outl    #_SD_CS                         ' /CS=0 (enable)
186a4 06a fdb0027c .again1         call    #_recvbyte                      ' read data byte
186a8 06b f20e42ff                 cmp     reply,            #$FF wz       ' $FF?
186ac 06c ad900020         if_z    jmp     #.ready1
186b0 06d fd62441a                 getct   replyR1                         '\ timeout ?
186b4 06e f1824528                 sub     replyR1,          ini_time      '|
186b8 06f f2124529                 cmp     replyR1,          time_out  wc  '| c if < timeout
186bc 070 3d90000c         if_nc   jmp     #.error1                        '/ n: not ready
186c0 071 ff800001                 waitx   ##delay5us                      ' delay 5us
186c4 072 fd67081f 
186c8 073 fd9fffd8                 jmp     #.again1                        ' try again
186cc 074 f54e4300 .error1         or      reply,#$100 wz                  ' ensure NZ on error
186d0 075 0d647849 .ready1 _RET_   outh    #_SD_CS                         ' /CS=1 (disable)
                   
                   '+=============================================================================+
                   
                   ' we know we now have an 1 /MMC card but its not fully validated yet...
                   '+-----------------------------------------------------------------------------+
                   '+ Check Voltage:                                                              +
                   '+      CMD8,  PAR=$1AA,      CRC=$87, REPLY=R1($01)+R7($xx1AA) ($05=try SDV1) +
                   '+-----------------------------------------------------------------------------+
186d4 076 f6063848 .Command8       mov     cmdout,           #CMD8
186d8 077 f6063baa                 mov     cmdpar,           #$1AA
186dc 078 f6063c87                 mov     cmdcrc,           #$87
                   '+-----------------------------------------------------------------------------+
186e0 079 fdb001c0                 call    #_cmdR1R7        ' /CS=0, send cmd, recv R1+R7, /CS=1
                   '+-----------------------------------------------------------------------------+
186e4 07a ed90001c   if_c_or_z     jmp     #.illegal                       ' j if <> $01 (not idle)
186e8 07b ff000007 .idle           and     reply,            ##$FFF        '\
186ec 07c f50643ff 
186f0 07d f20e43aa                 cmp     reply,            #$1AA     wz  '/ R7[11:0]=$1AA ?
186f4 07e ff200000                 mov     cmdpar2,          ##$40000000   ' preset for SDV2
186f8 07f f6063e00 
186fc 080 5d90025c   if_ne         jmp     #_fail '98                      ' n: unknown R7
18700 081 fd90000c                 jmp     #.Command55                     ' y: CMD55+ACMD41($4000_0000)
                   
18704 082 f20e4405 .illegal        cmp     replyR1,          #$05      wz  ' $05(illegal cmd) ?
18708 083 5d900250   if_ne         jmp     #_fail '08                      ' <>$01/$05 (not idle/illegal)
1870c 084 f6063e00                 mov     cmdpar2,          #0            ' try SDV1
                                                                           ' CMD55+ACMD41($0) fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Prefix to ACMD41 & ACMD23:                                                  +
                   '+      CMD55, PAR=$0,        CRC=$xx, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
18710 085 f6063877 .Command55      mov     cmdout,           #CMD55        '
18714 086 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
18718 087 fdb00180                 call    #_cmdRZA41       ' /CS=0, send cmd, recv R1, /CS=0(ena)
                   '+-----------------------------------------------------------------------------+
1871c 088 ed90023c   if_c_or_z     jmp     #_fail '55                      ' <>$01 (not idle)
                                                                           '              fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check SDV1/SDV2:  (follows CMD55)                                           +
                   '+     ACMD41, PAR=$0,        CRC=$xx, REPLY=R1($00)1 -V1                     +
                   '+     ACMD41, PAR=$40000000, CRC=$xx, REPLY=R1($00)1 -V2                     +
                   '+-----------------------------------------------------------------------------+
18720 089 f6063869 .CommandA41     mov     cmdout,           #ACMD41       '
