17a4c 091 ff800000         wrpin   ##txmode, txpin      ' set asynchronous tx mode in smart pin tx
17a50 092 fc08f91c 
17a54 093 fc123b1c         wxpin   tmpch, txpin         ' set tx bit period + #(bits-1)
17a58 094 fd623841         dirh    txpin                ' enable smart pin tx
                   
17a5c 095 ff800000         wrpin   ##rxmode, rxpin      ' set asynchronous rx mode in smart pin rx
17a60 096 fc087d1b 
17a64 097 fc123b1b         wxpin   tmpch, rxpin         ' set rx bit period + #(bits-1)
17a68 098 fd623641         dirh    rxpin                ' enable smart pin rx
                   
17a6c 099 f6063a0d         mov     tmpch, #$0D          ' we have to prime send buffer empty flag,
17a70 09a fc223b1c         wypin   tmpch, txpin         ' ... so send <cr> to tx pin
17a74 09b f6063c01         mov     rxtx_flag,#1         ' enable rx/tx
17a78 09c fd64002d         ret
                   
                   '-------[ Transmit Char(s) ]--------------------------------------------------
                   ' Call Format:
                   '      call    #serial_tx           ' tx 1-4 char(s)
                   ' On Entry:
                   '      tmpch = char                 ' up to 4 chars; B0 first;
                   '                                   ' <nul> terminates, but if =$0, tx <nul>
                   ' On Return:
                   '      tmpch = -lost-
                   
17a7c 09d          serial_tx
17a7c 09d fd723840         testp   txpin         wc     ' wait for buffer empty on tx pin
17a80 09e 3d9ffff8  if_nc  jmp     #serial_tx           '
17a84 09f fc223b1c         wypin   tmpch, txpin         ' send byte (bits7:0) to tx pin
                   
17a88 0a0 f04e3a08         shr     tmpch, #8     wz     ' any more chars to send?
17a8c 0a1 5d9fffec  if_nz  jmp     #serial_tx           ' (nz = another char in tmpch)
17a90 0a2 fd64002d         ret
                   
                   '-------[ Receive a char ]----------------------------------------------------
                   ' Call Format:
                   '      call    #serial_rx           ' rx 1 char (waits till char ready)
                   '      call    #serial_rx1          ' rx 1 char (assumes char ready)
                   ' On Entry:
                   '      tmpch = -anything-
                   ' On Return:
                   '      tmpch = char
                   
17a94 0a3          serial_rx
17a94 0a3 fd723640         testp   rxpin        wc      ' char ready?
