                   _XDIVP    = 1           '/ crystal / div * mul / divp  to give 180MHz
                   
                   
                   
                   
                   
                   _XOSC     = %10         ' %00=OFF, %01=OSC, %10=15pF, %11=30pF
                   
                   
                   
                   
                   _XSEL     = %11         ' %00=rcfast, %01=rcslow, %10=XI, %11=PLL
                   
                   
                   
                   
                   
