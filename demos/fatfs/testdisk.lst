0abe0 043 f6641401         neg     .rslt,#1
0abe4 044 fd64002d         ret
                   
                   '------------------------------------------------------------------------------------------------
                   
                   CON
                   
                   '------------------------------------------------------------------------------------------------
                   ' 1 Commands & Responses...
                   '------------------------------------------------------------------------------------------------
                   ' Command              Argument        Response/Data    Description
                     CMD0   = 0  +$40   ' 0               R1       -       GO_IDLE_STATE            *Reqs valid CRC
                     CMD1   = 1  +$40   ' 0               R1       -       SEND_OP_COND
                     ACMD41 = 41 +$40   ' $4000_0000      R1       -       APP_SEND_OP_COND         *Reqs CMD55 first
                     CMD8   = 8  +$40   ' 0               R1+R7    -       SEND_IF_COND             *Reqs valid CRC
                     CMD9   = 9  +$40   ' 0               R1       Y       SEND_CSD
                     CMD10  = 10 +$40   ' 0               R1       Y       SEND_CID
                   '  CMD12  = 12 +$40   ' 0               R2       -       STOP_TRANSMISSION
                     CMD13  = 13 +$40   ' 0               R2       -       SEND_STATUS
                     CMD16  = 16 +$40   ' BlkLen[31:0]    R1       -       SET_BLOCKLEN
                     CMD17  = 17 +$40   ' Addr[31:0]      R1       Y       READ_SINGLE_BLOCK
                   '  CMD18  = 18 +$40   ' Addr[31:0]      R1       Y       READ_MULTIPLE_BLOCK
                   '  CMD23  = 23 +$40   ' NoBlks[15:0]    R1       -       SET_BLOCK_COUNT
                   '  ACMD23 = 23 +$40   ' NoBlks[22:0]    R1       -       SET_WR_BLOCK_ERASE_COUNT *Reqs CMD55 first
                     CMD24  = 24 +$40   ' Addr[31:0]      R1       Y*      WRITE_BLOCK
                   '  CMD25  = 25 +$40   ' Addr[31:0]      R1       Y*      WRITE_MULTIPLE_BLOCK
                     CMD55  = 55 +$40   ' 0               R1       -       APP_CMD                  *Prefix for ACMD41/ACMD23
                     CMD58  = 58 +$40   ' 0               R1+R3    -       READ_OCR
                   
                   
                   ' R1 response:  $FF = busy/wait (0-8 bytes?)
                   '               b7: 0 (msb first)
                   '               b6: Parameter Error
                   '               b5: Address Error
                   '               b4: Erase Sequence Error
                   '               b3: Command CRC Error
                   '               b2: Illegal Command
                   '               b1: Erase Reset
                   '               b0: In Idle State
                   ' R1b response: ???
                   ' R3 response:  R1 + OCR(32b)
                   ' R7 response:  R1($01) + 32b(b11..b0 = $1AA = SDC V2 2V7-3V6, else reject)
                   '
                   ' DataPacket:   DataToken(1byte) + DataBlock(1-2048bytes) + CRC(2bytes)
                   '   DataToken:  $FE = CMD17/18/24 (read'1'block/read'n'blocks/write'1'block)
                   '               $FC = CMD25 (write'n'blocks)
                   '               $FD = CMD25 StopToken  (Single byte packet without data or CRC)
                   ' ErrorToken:   Single Byte Reply
                   '               b7-b5: 000
                   '               b4: Card Locked
                   '               b3: Out of Range
                   '               b2: Card ECC failed
                   '               b1: CC Error
                   '               b0: Error
                   ' DataResponse:
                   '               b7-b4: xxx0
                   '               $x5: Data Accepted
                   '               $xB: Data Rejected - CRC Error
                   '               $xD: Data Rejected - Write Error
                   
                   
                   DAT
                   
                   '
                   ' Check pin pull-up
                   '
0abe8 045          check_pullup
0abe8 045 fd63ec58         drvl    pa              ' drive pin low
0abec 046          check_pulldn
0abec 046 ff800000         waitx   ##300*1         ' wait >1us
0abf0 047 fd66581f 
0abf4 048 fd63ec50         fltl    pa              ' float pin
0abf8 049 ff800002         waitx   ##300*5         ' wait >5us
0abfc 04a fd67b81f 
0ac00 04b 0d73ec40   _ret_ testp   pa      wc      ' sample pin
                   
                   '+-------[1 Card Initialisation ]--------------------------------------------+ <--- 1 initialisation --->
                   '+ On Entry:                                                                   +
                   '+ Call Format:                                                                +
                   '+              CALL    #_SDcard_Init                   '                      + < call: sd initialise >
                   '+ On Return:                                                                  +
                   '+      hub $20   = CSD[16] + CID[16]                   ' csd/cid data         +
                   '+      Returns  "Z" if ok, "NZ" if error                                      +
                   '+-----------------------------------------------------------------------------+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ 1 /SDHC/sdxc SPI Initialisation                                        +
                   '+-----------------------------------------------------------------------------+
                   '+      Send >74 clocks with /CS=1 & DI=1 starting & ending with CLK=0         +
                   '+-----------------------------------------------------------------------------+
0ac04 04c          _SDcard_Init
0ac04 04c f6065a20                 mov     _hubdata,         #$20          ' init hub data ptr=$20
                                                                           ' ie. after CLKFREQ ($14), CLKMODE ($18) & BAUDRATE ($1C)
                                   'callpa  #_SD_CS,          #check_pullup ' check for pull-up on sd_cs
                           'if_nc   jmp     #_fail '_pullup                 '
                   
0ac08 04d fd647859                 drvh    #_SD_CS                         ' cs=1 & output
0ac0c 04e fd647a58                 drvl    #_SD_CK                         ' ck=0 & output
0ac10 04f fd647659                 drvh    #_SD_DI                         ' di=1 & output
                   
0ac14 050 f6064ec0                 mov     ctr1,             #(96*2)
0ac18 051 ff800001 .count          waitx   ##delay5us                      '\ 5us+5us (ie 100KHz)
0ac1c 052 fd67081f 
0ac20 053 fd647a4f                 outnot  #_SD_CK                         '| CLK=0-->1-->0
0ac24 054 fb6e4ffc                 djnz    ctr1,             #.count       '/
0ac28 055 ff800001                 waitx   ##delay5us                      '  CLK=0 (idle) & /CS=1
0ac2c 056 fd67081f 
                   '+-----------------------------------------------------------------------------+
                   '+ Software Reset:                                                             +
                   '+      CMD0,  PAR=$0,        CRC=$95, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
0ac30 057 fd62501a .Command0       getct   ini_time                        '\ set timeout up to CMD9
0ac34 058 ff000dbb                 mov     time_out,         ##delay10ms   '/
0ac38 059 f6065340 
0ac3c 05a f6064e0a                 mov     ctr1,             #10           ' try a few times
0ac40 05b f6063840 .again0         mov     cmdout,           #CMD0
0ac44 05c f6063a00                 mov     cmdpar,           #0
0ac48 05d f6063c95                 mov     cmdcrc,           #$95
                   '+-----------------------------------------------------------------------------+
0ac4c 05e fdb0022c                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
0ac50 05f 3f055d4a   if_nc         mov     time_out,         ##delay1s     ' increase timeout to 1s
0ac54 060 36065300 
                                                                           '\ $01(idle): 1 /MMC, not fully validated
0ac58 061 3d900050   if_nc         jmp     #.Command8                      '/ $00(good): (dane card response)
                   '+-----------------------------------------------------------------------------+
0ac5c 062 ff800001                 waitx   ##delay5us                      ' delay 5us
0ac60 063 fd67081f 
0ac64 064 fb6e4ff6                 djnz    ctr1,             #.again0      ' n: try again?
0ac68 065 fd9002c8                 jmp     #_fail '00                      '
                   
                   '+-----------------------------------------------------------------------------+
                   '+ _SD_Ready: check 1 card is ready (send $FF until $FF received)             +
                   '+            return Z if ok, NZ and reply on timeout                          +
                   '+-----------------------------------------------------------------------------+
0ac6c 066 fd62501a _SD_Ready       getct   ini_time                        '\ set timeout
0ac70 067 ff055d4a                 mov     time_out,         ##delay1s     '/
0ac74 068 f6065300 
0ac78 069 fd647848                 outl    #_SD_CS                         ' /CS=0 (enable)
0ac7c 06a fdb0027c .again1         call    #_recvbyte                      ' read data byte
0ac80 06b f20e42ff                 cmp     reply,            #$FF wz       ' $FF?
0ac84 06c ad900020         if_z    jmp     #.ready1
0ac88 06d fd62441a                 getct   replyR1                         '\ timeout ?
0ac8c 06e f1824528                 sub     replyR1,          ini_time      '|
0ac90 06f f2124529                 cmp     replyR1,          time_out  wc  '| c if < timeout
0ac94 070 3d90000c         if_nc   jmp     #.error1                        '/ n: not ready
0ac98 071 ff800001                 waitx   ##delay5us                      ' delay 5us
0ac9c 072 fd67081f 
0aca0 073 fd9fffd8                 jmp     #.again1                        ' try again
0aca4 074 f54e4300 .error1         or      reply,#$100 wz                  ' ensure NZ on error
0aca8 075 0d647849 .ready1 _RET_   outh    #_SD_CS                         ' /CS=1 (disable)
                   
                   '+=============================================================================+
                   
                   ' we know we now have an 1 /MMC card but its not fully validated yet...
                   '+-----------------------------------------------------------------------------+
                   '+ Check Voltage:                                                              +
                   '+      CMD8,  PAR=$1AA,      CRC=$87, REPLY=R1($01)+R7($xx1AA) ($05=try SDV1) +
                   '+-----------------------------------------------------------------------------+
0acac 076 f6063848 .Command8       mov     cmdout,           #CMD8
0acb0 077 f6063baa                 mov     cmdpar,           #$1AA
0acb4 078 f6063c87                 mov     cmdcrc,           #$87
                   '+-----------------------------------------------------------------------------+
0acb8 079 fdb001c0                 call    #_cmdR1R7        ' /CS=0, send cmd, recv R1+R7, /CS=1
                   '+-----------------------------------------------------------------------------+
0acbc 07a ed90001c   if_c_or_z     jmp     #.illegal                       ' j if <> $01 (not idle)
0acc0 07b ff000007 .idle           and     reply,            ##$FFF        '\
0acc4 07c f50643ff 
0acc8 07d f20e43aa                 cmp     reply,            #$1AA     wz  '/ R7[11:0]=$1AA ?
0accc 07e ff200000                 mov     cmdpar2,          ##$40000000   ' preset for SDV2
0acd0 07f f6063e00 
0acd4 080 5d90025c   if_ne         jmp     #_fail '98                      ' n: unknown R7
0acd8 081 fd90000c                 jmp     #.Command55                     ' y: CMD55+ACMD41($4000_0000)
                   
0acdc 082 f20e4405 .illegal        cmp     replyR1,          #$05      wz  ' $05(illegal cmd) ?
0ace0 083 5d900250   if_ne         jmp     #_fail '08                      ' <>$01/$05 (not idle/illegal)
0ace4 084 f6063e00                 mov     cmdpar2,          #0            ' try SDV1
                                                                           ' CMD55+ACMD41($0) fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Prefix to ACMD41 & ACMD23:                                                  +
                   '+      CMD55, PAR=$0,        CRC=$xx, REPLY=R1($01)                           +
                   '+-----------------------------------------------------------------------------+
0ace8 085 f6063877 .Command55      mov     cmdout,           #CMD55        '
0acec 086 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
0acf0 087 fdb00180                 call    #_cmdRZA41       ' /CS=0, send cmd, recv R1, /CS=0(ena)
                   '+-----------------------------------------------------------------------------+
0acf4 088 ed90023c   if_c_or_z     jmp     #_fail '55                      ' <>$01 (not idle)
                                                                           '              fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check SDV1/SDV2:  (follows CMD55)                                           +
                   '+     ACMD41, PAR=$0,        CRC=$xx, REPLY=R1($00)1 -V1                     +
                   '+     ACMD41, PAR=$40000000, CRC=$xx, REPLY=R1($00)1 -V2                     +
                   '+-----------------------------------------------------------------------------+
0acf8 089 f6063869 .CommandA41     mov     cmdout,           #ACMD41       '
0acfc 08a f6023b1f                 mov     cmdpar,           cmdpar2       ' SDV1=0 / SDV2=$40000000
                   '+-----------------------------------------------------------------------------+
0ad00 08b fdb00178                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
0ad04 08c 1d9fffe0   if_nc_and_nz  jmp     #.Command55                     '  =$01(busy): CMD55+CMD41 again
0ad08 08d cd900228   if_c          jmp     #_fail '41                      ' <>$00/$01: error
                   
0ad0c 08e f20e3e00                 cmp     cmdpar2,          #0        wz  ' SDV1 ?
0ad10 08f a6065409         if_z    mov     blocksh,          #9            ' y: #1 SDV1(byte address)
0ad14 090 ad90001c         if_z    jmp     #.Command16                     ' y: SDV1 does not use CMD58
                                                                           ' SDV2         fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Check OCR CCS bit:                                                          +
                   '+      CMD58, PAR=$0,        CRC=$xx, REPLY=R1($00)+R3(b30=1)                 +
                   '+-----------------------------------------------------------------------------+
0ad18 091 f606387a .Command58      mov     cmdout,           #CMD58        ' SDHC ?
0ad1c 092 f6063a00                 mov     cmdpar,           #0            '
                   '+-----------------------------------------------------------------------------+
0ad20 093 fdb00158                 call    #_cmdR1R3        ' /CS=0, send cmd, recv R1+R3, /CS=1
                   '+-----------------------------------------------------------------------------+
0ad24 094 dd90020c   if_c_or_nz    jmp     #_fail '58                      ' <>$00(good): error
0ad28 095 f42e421e                 testbn  reply,            #30       wz  ' bit30=CCS=1? $40000000?
0ad2c 096 a6065409         if_z    mov     blocksh,          #9            ' n: #2 SDV2(byte address)
0ad30 097 56065400         if_nz   mov     blocksh,          #0            ' y: #3 SDHC/SDV2(block address)
                   ''      if_nz   jmp     #.Command9x                     ' y: does not req cmd16?                        ?????????
                                                                           ' SDV2(byte)   fall thru
                   '+-----------------------------------------------------------------------------+
                   '+ Force block size to 512 bytes:                                              +
                   '+      CMD16, PAR=$200,      CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
0ad34 098 f6063850 .Command16      mov     cmdout,           #CMD16        ' force blocksize=512bytes
0ad38 099 ff000001                 mov     cmdpar,           ##512         ' 512 bytes
0ad3c 09a f6063a00 
                   '+-----------------------------------------------------------------------------+
0ad40 09b fdb00138                 call    #_cmdR1          ' /CS=0, send cmd, recv R1, /CS=1
                   '+-----------------------------------------------------------------------------+
0ad44 09c 1d9fffec   if_nc_and_nz  jmp     #.Command16                     '  =$01(idle): again
0ad48 09d dd9001e8   if_c_or_nz    jmp     #_fail '16                      ' <>$00(good): error
                   '+-----------------------------------------------------------------------------+
0ad4c 09e f602572d .Command9x      mov     bufaddr,          _hubdata      ' where to store CSD/CID
                   '+-----------------------------------------------------------------------------+
                   '+ Read CSD register (16 bytes):                                               +
                   '+      CMD9,  PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
0ad50 09f f6063849 .Command9       mov     cmdout,           #CMD9         ' read CSD register
0ad54 0a0 fdb00044                 call    #_readREG                       '
                   '+-----------------------------------------------------------------------------+
                   '+ Read CID register (16 bytes):                                               +
                   '+      CMD10, PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+-----------------------------------------------------------------------------+
0ad58 0a1 f606384a .Command10      mov     cmdout,           #CMD10        ' read CID register
0ad5c 0a2 fdb0003c                 call    #_readREG                       '
                   '+-----------------------------------------------------------------------------+
0ad60 0a3 0d6c1e6f         _RET_   MODZ    _set                      wz    ' "Z" = success
                   '+=============================================================================+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ Read Sector:                                                                +
                   '+-----------------------------------------------------------------------------+
0ad64 0a4          _readSECTOR
                   '+-----------------------------------------------------------------------------+
                   '+ Read Block/Sector:  (512 bytes)                                             +
                   '+      CMD17, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
0ad64 0a4 ff000001 .Command17      mov     bytescnt,         ##512         ' read block (no. bytes)
0ad68 0a5 f6064a00 
0ad6c 0a6 f6063851                 mov     cmdout,           #CMD17        '
0ad70 0a7 f6023b2c                 mov     cmdpar,           blocknr       '
0ad74 0a8 f0623b2a                 shl     cmdpar,           blocksh       ' <<0 or <<9
                   '+-----------------------------------------------------------------------------+
0ad78 0a9 fdb00028                 call    #_readBLOCK                     ' read 512 bytes
                   '+-----------------------------------------------------------------------------+
0ad7c 0aa fd64002d                 RET                                     ' "Z" = success
                   '+-----------------------------------------------------------------------------+
                   '+ Write Sector:                                                               +
                   '+-----------------------------------------------------------------------------+
0ad80 0ab          _writeSECTOR
                   '+-----------------------------------------------------------------------------+
                   '+ Write Block/Sector:  (512 bytes)                                            +
                   '+      CMD24, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
0ad80 0ab ff000001 .Command24      mov     bytescnt,         ##512         ' write block (no. bytes)
0ad84 0ac f6064a00 
0ad88 0ad f6063858                 mov     cmdout,           #CMD24        '
0ad8c 0ae f6023b2c                 mov     cmdpar,           blocknr       '
0ad90 0af f0623b2a                 shl     cmdpar,           blocksh       ' <<0 or <<9
                   '+-----------------------------------------------------------------------------+
0ad94 0b0 fdb0005c                 call    #_writeBLOCK                    ' write 512 bytes
                   '+-----------------------------------------------------------------------------+
0ad98 0b1 fd64002d                 RET                                     ' "Z" = success
                   '+=============================================================================+
                   
                   '+-----------------------------------------------------------------------------+
                   '+ Read Block/Sector:  (512 bytes)                                             +
                   '+      CMD9,  PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+      CMD10, PAR=$0,        CRC=$xx, REPLY=R1($00)                           +
                   '+      CMD17, PAR=blocknr,   CRC=$xx, REPLY=R1($] +n*$FF +($FE+block+CRC16) +
                   '+-----------------------------------------------------------------------------+
0ad9c 0b2 f6064a10 _readREG        mov     bytescnt,         #16           ' CMD9,10: CSD,CID register
0ada0 0b3 f6063a00                 mov     cmdpar,           #0            '        PAR=$0,      16 bytes
0ada4 0b4          _readBLOCK                                              ' CMD17: PAR=sector, 512 bytes
