0a058 09e 3d9ffff8  if_nc  jmp     #serial_tx           '
0a05c 09f fc223b1c         wypin   tmpch, txpin         ' send byte (bits7:0) to tx pin
                   
0a060 0a0 f04e3a08         shr     tmpch, #8     wz     ' any more chars to send?
0a064 0a1 5d9fffec  if_nz  jmp     #serial_tx           ' (nz = another char in tmpch)
0a068 0a2 fd64002d         ret
                   
                   '-------[ Receive a char ]----------------------------------------------------
                   ' Call Format:
                   '      call    #serial_rx           ' rx 1 char (waits till char ready)
