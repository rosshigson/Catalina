001ac 06b f6007414        mov    t1,RI         ' save register specification for later
001b0 06c f0442806        shr    RI,#6         ' ignore registers r0 - r5 (never saved)
001b4 06d f604781c        mov    t3,#r6        ' start with r6
001b8 06e          push_nxt
001b8 06e f05c2801        shr    RI,#1 wcz     ' save rX?
001bc 06f c98c7800  if_c  altd   t3            ' yes - decrement SP ...
001c0 070 cc64015f  if_c  wrlong 0-0,--PTRA    ' ... and save the register
001c4 071 f1047801        add    t3,#1         ' point to next register
001c8 072 5d9fffec  if_nz jmp    #push_nxt     ' continue till all registers saved
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
001cc 073 fc64755f        wrlong t1,--PTRA     ' save register specification
                   
                   
001d0 074 f107ec04        add    PA,#4         ' increment PC ...
                   
001d4 075 fd9fffc4        jmp    #returni      ' ... and return
                   
001d8 076 0003ffff Bits18 long   %0000_0000_0000_0011_1111_1111_1111_1111
                   
                   '
                   ' pop_m - pop many registers (specified by the long on top of stack)
                   ' from the stack, incremening the SP after each one
                   '
001dc 077          pop_m
                   
001dc 077 fd604224        stalli               ' disable interrupts
                   
                   
                   
                   
                   
                   
                   
001e0 078 fb042961        rdlong RI,PTRA++     ' pop the long value specifying registers to pop
                   
001e4 079 f604762d        mov    t2,#r23       ' start with ...
001e8 07a f0642808        shl    RI,#(32-24)   ' ... r23
001ec 07b          pop_nxt
001ec 07b f07c2801        shl    RI,#1 wcz     ' load rX?
001f0 07c c98c7600  if_c  altd   t2            ' yes - load the register ...
001f4 07d cb040161  if_c  rdlong 0-0,PTRA++    ' ... and increment the stack pointer
001f8 07e 51847601  if_nz sub    t2,#1         ' if more to do, point to previous register ...
001fc 07f 5d9fffec  if_nz jmp    #pop_nxt      ' ... and continue till all registers popped
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
                   
00200 080 fd9fff98        jmp    #returni
                   
                   '
                   ' push_b - push a structure (size in bytes at the PC) pointed to by R0
                   '          onto the stack, decrementing the SP (PTRA).
                   '
00204 081          push_b
                   
00204 081 fd604224        stalli               ' disable interrupts
                   
00208 082 fb002bf6        rdlong BC,PA         ' load the byte count
0020c 083 f107ec04        add    PA,#4         ' increment the PC
00210 084 f6007815        mov    t3,BC         ' round up the count ...
00214 085 f1047803        add    t3,#3         ' ... to be ...
00218 086 f5247803        andn   t3,#3         ' ... a multiple of 4
0021c 087 f183f03c        sub    PTRA,t3       ' decrement SP (PTRA) by rounded up size
00220 088 f6007416        mov    t1,R0         ' source is in R0
00224 089 f60077f8        mov    t2,PTRA       ' destination is SP (PTRA)
00228 08a fd900014        jmp    #copy_bytes   ' do the copy
                   '
                   ' copy_b - copy a structure (size in bytes at the PC)
                   '          from the address in R1 to the address in R0
                   '
0022c 08b          copy_b
                   
0022c 08b fd604224        stalli               ' disable interrupts
                   
00230 08c fb002bf6        rdlong BC,PA         ' load the byte count
00234 08d f107ec04        add    PA,#4         ' increment the PC
00238 08e f6007417        mov    t1,R1         ' source is in R1
0023c 08f f6007616        mov    t2,R0         ' destination is in R0
                   '
00240 090          copy_bytes
00240 090 fcd80815        rep    #4,BC         ' repeat the next 4 instructions BC times
00244 091 fac0783a        rdbyte t3,t1         ' read from src to t3
00248 092 fc40783b        wrbyte t3,t2         ' write t3 to dst
0024c 093 f1047401        add    t1,#1         ' increment source
00250 094 f1047601        add    t2,#1         ' increment destination
00254 095 fd9fff44        jmp    #returni
                   '
                   ' new_fp - save current frame pointer and set up a new frame pointer
                   ' also calculate what SP (PTRA) was before data was pushed and save it in BC
                   '
00258 096          new_fp
                   
00258 096 fd604224        stalli               ' disable interrupts
                   
0025c 097 fc67f35f        wrlong PTRB,--PTRA   ' save FP (PTRB) to stack
00260 098 f603f3f8        mov    PTRB,PTRA     ' set up new FP (PTRB)
00264 099 f1042a08        add    BC,#8         ' calculate what SP (PTRA) was ...
00268 09a f1002bf9        add    BC,PTRB       ' ... before arguments were pushed
0026c 09b f187f004        sub    PTRA,#4       ' allow for alloca
00270 09c fc646500        wrlong Bit31,PTRA    ' initialize pre-alloca SP (to a known value)
00274 09d fd9fff24        jmp    #returni
                   '
                   ' fp_ret - pop current frame, restore previous frame and stack pointers,
                   '          then restore the previous program counter
                   '
                   ' f_ret -  just restore the previous program counter
                   '
00278 09e          fp_ret
                   
00278 09e fd604224        stalli               ' disable interrupts
                   
0027c 09f f107f004        add    PTRA,#4       ' allow for alloca
00280 0a0 fb07f361        rdlong PTRB,PTRA++   ' restore previous FP (PTRB)
00284 0a1          f_ret
                   
00284 0a1 fd604224        stalli               ' disable interrupts
                   
00288 0a2 fb07ed00        rdlong PA,PTRA       ' read the PC
0028c 0a3 f107f008        add    PTRA,#8       ' increment the SP (PTRA)
00290 0a4 fd9fff08        jmp    #returni
                   '
                   ' f_call - call the routine at the address pointed to by the PC
                   ' f_cali - call the routine whose address is in RI
                   '
00294 0a5          f_call
                   
00294 0a5 fd604224        stalli               ' disable interrupts
                   
00298 0a6 fb0029f6        rdlong RI,PA         ' get the address to call
0029c 0a7 f107ec04        add    PA,#4         ' increment the PC (this is the return address)
002a0 0a8          f_cali
                   
002a0 0a8 fd604224        stalli               ' disable interrupts
                   
002a4 0a9 f187f008        sub    PTRA,#8       ' decrement the SP (PTRA)
002a8 0aa fc67ed00        wrlong PA,PTRA       ' save current PC to stack
                   
002ac 0ab fd604024        allowi               ' enable interrupts
                   
002b0 0ac fd60282c        jmp    RI            ' execute next instruction
                   
                   'fd_32s - Signed 32 bit division
                   '         Divisor --> r1
                   '         Dividend--> r0
                   '         Result --> Quotient in r0
                   '                    Remainder in r1
                   
002b4 0ad          f_d32s
                   
002b4 0ad fd604224        stalli               ' disable interrupts
                   
002b8 0ae fda00303        call   #\signed_d32  ' perform signed division
002bc 0af fd9ffedc        jmp    #returni
                   
                   ' plugin - call a plugin
                   ' On entry:
                   '       R3 = code:
                   '            - cog id if >= 128 (i.e. $80 + cog id)
                   '            - plugin type if < 128 (i.e. 0 .. 127)
                   '            - service id if < 0
                   '       R2 = data (optional pointer)
                   '
                   ' NOTES: Locks are currently only supported when invoking via a service id.
                   '        When using service id, the data should only use the lower 24 bits.
                   '
                   ' On exit:
                   '       R0 = result
                   
002c0 0b0          plugin
                   
002c0 0b0 fd604224        stalli               ' disable interrupts
                   
002c4 0b1 fda00319        call   #\do_plugin   ' do_plugin does all the work
002c8 0b2 fd9ffed0        jmp    #returni
                   
