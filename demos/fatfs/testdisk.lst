0a020 090 fd64002d         ret
                   
                   '-------[ Serial Initialize (uses SmartPins) ]--------------------------------
                   ' Call Format:
                   '      call      #serial_init       ' provide addr & baud
                   ' On Entry:
                   '      tmpch     = bitrate          ' tx & rx bit period + #(bits-1)
                   '                                   ' = (_clkfreq / _BAUDRATE) << 16 + 7
                   ' On Return:
                   '      tmpch = #0D
                   
0a024 091          serial_init
0a024 091 ff800000         wrpin   ##txmode, txpin      ' set asynchronous tx mode in smart pin tx
0a028 092 fc08f91c 
0a02c 093 fc123b1c         wxpin   tmpch, txpin         ' set tx bit period + #(bits-1)
0a030 094 fd623841         dirh    txpin                ' enable smart pin tx
                   
0a034 095 ff800000         wrpin   ##rxmode, rxpin      ' set asynchronous rx mode in smart pin rx
0a038 096 fc087d1b 
0a03c 097 fc123b1b         wxpin   tmpch, rxpin         ' set rx bit period + #(bits-1)
0a040 098 fd623641         dirh    rxpin                ' enable smart pin rx
                   
0a044 099 f6063a0d         mov     tmpch, #$0D          ' we have to prime send buffer empty flag,
0a048 09a fc223b1c         wypin   tmpch, txpin         ' ... so send <cr> to tx pin
0a04c 09b f6063c01         mov     rxtx_flag,#1         ' enable rx/tx
0a050 09c fd64002d         ret
                   
                   '-------[ Transmit Char(s) ]--------------------------------------------------
                   ' Call Format:
                   '      call    #serial_tx           ' tx 1-4 char(s)
                   ' On Entry:
                   '      tmpch = char                 ' up to 4 chars; B0 first;
