                   '-------------------- 1 Card Functions -----------------------------------------
                   
0ab9c 032          .SD_Init
0ab9c 032 fdb00064         call    #_SDcard_Init
0aba0 033 a6041400   if_z  mov     .rslt,#0
0aba4 034 56641401   if_nz neg     .rslt,#1
0aba8 035 fd64002d         ret
                   
0abac 036          .SD_Write
0abac 036 fdb000bc         call    #_SD_Ready      ' 1 card ready?
0abb0 037 5d900014   if_nz jmp     #.SD_Result     ' no - return result from card
0abb4 038 fdb001c8         call    #_writeSECTOR   ' yes - write sector
0abb8 039 fd90000c         jmp     #.SD_Result     ' return result
                   
0abbc 03a          .SD_Read
0abbc 03a fdb000ac         call    #_SD_Ready      ' 1 card ready?
0abc0 03b 5d900004   if_nz jmp     #.SD_Result     ' no - return result from card
0abc4 03c fdb0019c         call    #_readSECTOR    ' yes - read sector, return result
0abc8 03d          .SD_Result
0abc8 03d a6041400   if_z  mov     .rslt,#0
0abcc 03e 56001521   if_nz mov     .rslt, reply
0abd0 03f fdb00328         call    #_sendFF
0abd4 040 fd64002d         ret                     ' return data response
                   
0abd8 041          .SD_ByteIO
                   ' ??? not implemented ???
0abd8 041 f6641401         neg     .rslt,#1
0abdc 042 fd64002d         ret
                   
0abe0 043          .SD_StopIO
