#ifndef __COGKBMB_T2
#define __COGKBMB_T2
{
    USB Keyboard and Gamepad Driver
    Copyright (c) 2022-23 by Marco Maccaferri <macca@maccasoft.com>
    Based on 1CogKbM code by Garry Jordan ("garryj")
    with code portions by Ada Gottensträter

    Usage : see hkbd_compare, hkbd_translate for keyboard
                hid_decode and hpad_translate for controllers

    TERMS OF USE: MIT License
}

{
 NOTE: The original usb.spin2 has been split into 5 files -
 two files for Port A, two files for Port B, and one common file:

 1. cogkbma.t2 contains cog code and data for port A that can be 
    placed AFTER the C sbrk.
 
 2. cogkbmb.t2 contains cog code and data for port B that can be 
    placed AFTER the C sbrk.

 3. kbmprec.t2 contains definitions and hub data common to both 
    ports A & B that must be placed BEFORE the C sbrk

 4. kbmprea.t2 contains hub code and data for port A that 
    must be placed BEFORE the C sbrk. 

 5. kbmpreb.t2 contains hub code and data for port B that 
    must be placed BEFORE the C sbrk. 
}

CON
' USB "portB" connector pin assignments (upper port):

    USB_B_BASE_PIN   = _USB_BASE_PIN
    USB_B_EVENT_REPO = USB_B_BASE_PIN
    B_ACTIVITY_LED   = USB_B_BASE_PIN 
    B_ERROR_LED      = USB_B_BASE_PIN

DAT
                orgh
                alignl
                org

DAT             ' USB Host driver
B_usb_host_start
                mov     B_hcog_base_addr, ptrb

                mov     B_htmp, ##@B_hlut_end - 4 - @B_hlut_start ' Dealing with hub addresses
                shr     B_htmp, #2                        ' so byte->long for the lut cell count
                loc     pb, #@B_hlut_start - @B_usb_host_start
                add     pb, B_hcog_base_addr
                setq2   B_htmp
                rdlong  0, pb                           ' Do the hub->lut copy

                loc     pb, #@B_usb_host_init - @B_usb_host_start
                add     pb, B_hcog_base_addr
                jmp     pb                              ' Initialize host and enter main processing loop

'------------------------------------------------------------------------------
' SETUP transaction. The mechanics of SETUP are identical to OUT, but it's
' special because the receiving function must not respond with either STALL or
' NAK, and must accept the DATAx packet that follows the SETUP token. If a
' non-control endpoint receives a SETUP token, or the function receives a
' corrupt packet, it must ignore the transaction
'------------------------------------------------------------------------------
' On entry:
'   PTRA - start address of the SETUP data struct.
' On exit:
'   B_retval - PID_ACK on success, otherwise error code.
'------------------------------------------------------------------------------
B_txn_setup
                setbyte B_ep_addr_pid, #PID_SETUP, #0
                mov     B_pkt_data, #SETUP_TXN_LEN        ' SETUP is single fixed size DATAx packet
                bitl    B_hstatus, #DATAx_TGLB            ' And always uses DATA0 packet
                mov     B_retry, #TXN_RETRIES             ' Retries possible as function will ignore a corrupt packet
                mov     pa, ptra                        ' Save SETUP struct pointer in case of retry
.setup
                call    #B_txn_out                        ' SETUP/OUT are the same transaction type, just different PIDs
                cmp     B_retval, #PID_ACK        wz
        if_z    ret
                call    #B_retry_wait
                cmp     B_retval, #ERR_TXN_RETRY  wz
        if_z    ret
                mov     ptra, pa                        ' Restore SETUP's DATAx pointer
                jmp     #.setup

'------------------------------------------------------------------------------
' IN/INTERRUPT transaction.
' Possible function response: STALL or NAK handshake, or DATAx packet.
'------------------------------------------------------------------------------
' On entry:
'   B_ep_addr_pid - PID_IN(b0..7), address(b8..b14), endpoint(b15..18) and
'     CRC(b19..23).
' On exit:
'------------------------------------------------------------------------------
B_txn_in
                call    #B_wait_txn_ok                    ' ISR: ensure txn doesn't cross frame boundary
                setbyte B_ep_addr_pid, #PID_IN, #0
                call    #B_utx_token                      ' Put IN request on the bus

                ' Fall through to B_urx_packet

'------------------------------------------------------------------------------
' Wait for a packet from a device/function. As host, the only two packet types
' received are handshakes and IN DATAx.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   B_retval - the ID of the packet. If a PID fails validation, ERR_PACKET is
'     returned.
'------------------------------------------------------------------------------
B_urx_packet
                rqpin   B_urx, B_dm                         ' Wait until start-of-packet signal appears on the USB.
                testb   B_urx, #SOPB              wc
        if_c    jmp     #B_urx_packet
                getct   B_hct2
                addct2  B_hct2, B_tat_wait                  ' Start the response turn-around timer
                bitl    B_hstatus, #EOPB                  ' Make sure sticky EOP flag is clear
                mov     B_newb_flg, #0                    ' Initialize for multi-byte read
.wait_sop
                rdpin   B_urx, B_dm
                testb   B_urx, #SOPB              wc
        if_c    jmp     #.get_pid
                jnct2   #.wait_sop
        _ret_   mov     B_retval, #ERR_TAT
.get_pid
                call    #B_urx_next
                testb   B_urx, #BUS_ERRB          wc
        if_nc   jmp     #.chk_pid
        _ret_   mov     B_retval, #ERR_URX
.chk_pid
                cmp     B_retval, #PID_ACK        wz
        if_nz   cmp     B_retval, #PID_NAK        wz
        if_nz   cmp     B_retval, #PID_STALL      wz
        if_z    jmp     #.chk_eop                       ' Handshake, so check that packet is single byte
                testb   B_hstatus, #DATAx_TGLB    wc      ' Get low/full speed even/odd DATAx sequence to look for
                cmp     B_retval, #PID_DATA0      wz
   if_z_and_nc  jmp     #B_urx_data                       ' DATA0 and sequence match
   if_z_and_c   jmp     #.ack_resend                    ' Sequence error. Ignore data, resend the ACK that the device must have missed
                cmp     B_retval, #PID_DATA1      wz
   if_z_and_c   jmp     #B_urx_data                       ' DATA1 and sequence match
   if_z_and_nc  jmp     #.ack_resend
        _ret_   mov     B_retval, #ERR_PACKET             ' Some other bus error...
.ack_resend
                rqpin   B_urx, B_dm
                testb   B_urx, #EOPB              wc
        if_nc   jmp     #.ack_resend
                mov     B_retval, #PID_ACK
                call    #B_utx_handshake                  ' Send handshake PID and return to caller
        _ret_   mov     B_retval, #ERR_DATAX_SYNC
.chk_eop
                testb   B_hstatus, #LOW_SPEEDB    wc
        if_nc   jmp     #.idle                          ' Full-speed doesn't need an additional read to get EOP status
                call    #B_urx_next                       ' Low-speed requires an additional read to get EOP status
                testb   B_hstatus, #EOPB          wc
        if_c    jmp     #.idle                          ' Low-speed EOP seen
                testb   B_urx, #BUS_ERRB          wz
        if_nc   mov     B_retval, #ERR_PACKET             ' No EOP where one was expected
        if_z    mov     B_retval, #ERR_URX                ' Bit unstuff error, EOP SE0 > 3 bits or SE1, so we're hosed
                ret
.idle
                rqpin   B_urx, B_dm
                testb   B_urx, #J_IDLEB           wc
        if_nc   jmp     #.idle                          ' Wait for bus IDLE before returning handshake result
                ret

'------------------------------------------------------------------------------
' Send a token packet with CRC5 checksum of address and endpoint. It is the
' responsibility of the caller to append the appropriate inter-packet delay,
' if one is required.
'------------------------------------------------------------------------------
' On entry:
'   B_ep_addr_pid - packed with the PID, address and endpoint.
' On exit:
'------------------------------------------------------------------------------
B_utx_token
                rqpin   B_urx, B_dm
                testb   B_urx, #J_IDLEB           wc
        if_nc   jmp     #B_utx_token
                testb   B_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #B_utx_pre
                mov     B_utx, #OUT_SOP
                call    #B_utx_byte                       ' Send sync byte
                mov     B_htmp, B_ep_addr_pid               ' Preserve the PID and destination
                mov     B_pkt_cnt, #3
.next_byte
                getbyte B_utx, B_htmp, #0                   ' Bytes on the bus LSB->MSB
                shr     B_htmp, #8                        ' Shift to next byte to send
.wait
                testp   B_dp                      wc
        if_nc   jmp     #.wait
                akpin   B_dp
                wypin   B_utx, B_dm
        _ret_   djnz    B_pkt_cnt, #.next_byte

'------------------------------------------------------------------------------
' SETUP/OUT/INTERRUPT transaction.
' Possible function response in order of precedence: STALL, ACK, NAK.
'------------------------------------------------------------------------------
' On entry:
'   B_ep_addr_pid - PID_OUT(b0..7), address(b8..b14), endpoint(b15..18) and
'     CRC(b19..23).
'   PTRA - start address of the data buff/struct that has the bytes to send.
'   B_pkt_data - count of DATAx payload bytes to send.
' On exit:
'------------------------------------------------------------------------------
B_txn_out
                call    #B_wait_txn_ok                    ' ISR: ensure txn doesn't cross frame boundary
                call    #B_utx_token                      ' Put SETUP/OUT token on the bus
                rdfast  ##$80000000, ptra               ' Use hub RAM FIFO interface to read the tx buffer
                mov     B_pkt_cnt, B_pkt_data

                ' Fall through to B_utx_data

'------------------------------------------------------------------------------
' Transmit a DATAx packet with USB-16 checksum of payload. The payload CRC is
' calculated while the data byte is being shifted out. Since data stage
' success/fail is not determined until the status stage of the transaction,
' this routine is only concerned about the current DATAx packet.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - hub start address of the data to read.
'   B_pkt_cnt - data payload size.
' On exit:
'------------------------------------------------------------------------------
B_utx_data
                rqpin   B_urx, B_dm
                testb   B_urx, #SOPB              wc
        if_c    jmp     #B_utx_data
                mov     B_hctwait, B_ip_delay
                call    #B_poll_waitx                     ' SETUP/OUT token always precedes tx DATAx so insert IP delay
                testb   B_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #B_utx_pre
                mov     B_utx, #OUT_SOP
                call    #B_utx_byte                       ' Send sync
                bmask   B_crc, #15                        ' Prime the CRC16 pump
                testb   B_hstatus, #DATAx_TGLB    wc      ' Set the requested DATAx PID
        if_nc   mov     B_utx, #PID_DATA0
        if_c    mov     B_utx, #PID_DATA1
                call    #B_utx_byte                       ' No CRC calc done on PID
                cmp     B_pkt_cnt, #0             wz      ' Check if sending a zero length payload
        if_z    jmp     #.send_B_crc                      ' If so, only the CRC goes out
.read_byte
                rfbyte  B_utx                             ' Fetch data byte
                call    #B_utx_byte
                rev     B_utx                             ' Calculate CRC while the data is shifting out
                setq    B_utx                             ' SETQ left-justifies the reflected data byte
                crcnib  B_crc, ##USB16_POLY               ' Run CRC calc on the data nibs
                crcnib  B_crc, ##USB16_POLY
                djnz    B_pkt_cnt, #.read_byte
.send_B_crc
                'bitnot  B_crc,#0 addbits 15               ' Final XOR, and send the calculated CRC16
                bitnot  B_crc,#((0&$1F) | (15&$1f)<<5)               ' Final XOR, and send the calculated CRC16 ' p2asm does not have addbits
                getbyte B_utx, B_crc, #0
                call    #B_utx_byte
                getbyte B_utx, B_crc, #1
                call    #B_utx_byte                       ' Last CRC byte out
                jmp     #B_urx_packet                     ' Handle function response/error and back to caller

'------------------------------------------------------------------------------
' Receive a DATAx_ payload with USB-16 checksum. The CRC is calculated as the
' payload bytes are received. The routine reads bytes until EOP is detected and
' expects that the packet includes at least the CRC word.
'
' In control transfers, it's possible to recieve fewer data bytes than what
' was requested, which makes it difficult to determine where the data stops
' and the CRC word begins. So the CRC calculation is done on every byte of the
' packet, including the CRC word. The CRC value should then be equal to the
' USB-16 expected residual value of 0xB001.
'
' The routine writes the IN packet data to a static max_packet_size buffer
' so the caller can verify IN success before writing the data to its final
' destination.
'------------------------------------------------------------------------------
' On entry:
'   B_pkt_data - max byte count expected to be in the packet.
'   B_newb_flg - signals new byte ready when toggled.
' On exit:
'   B_pkt_cnt - actual number of bytes read.
'------------------------------------------------------------------------------
B_urx_data
                mov     B_htmp2, pb
                mov     pb, B_urx_buff_p
                wrfast  ##$80000000, pb                 ' Use hub RAM FIFO interface to buffer bytes received
                mov     pb, B_htmp2
                bmask   B_crc, #15                        ' Prime the CRC16 pump
                mov     B_pkt_cnt, #0                     ' Keep track of payload bytes received
                mov     B_pkt_tmp, B_pkt_data
                add     B_pkt_tmp, #2                     ' Tweak payload byte count to include CRC word
.wait_byte
' In-line rx for max speed
                rqpin   B_urx, B_dm
                mov     B_utx, #BYTE_TGLF                 ' Reg utx free in this context
                and     B_utx, B_urx
                cmp     B_newb_flg, B_utx           wz      ' Fetch a byte whenever the flags differ
        if_nz   xor     B_newb_flg, #BYTE_TGLF            ' Synchronize flags
        if_nz   jmp     #.get_byte                      ' New byte!
                testb   B_urx, #EOPB              wc
        if_c    jmp     #.chk_B_crc                       ' At end-of-packet
                jmp     #.wait_byte
.get_byte
                getbyte B_retval, B_urx, #1                 ' New byte from smart pins
                wfbyte  B_retval                          ' Add it to the data buffer
                rev     B_retval                          ' Calculate CRC while next byte is shifting in
                setq    B_retval                          ' SETQ left-justifies the reflected data byte
                crcnib  B_crc, ##USB16_POLY               ' Run CRC calc on the data nibs
                crcnib  B_crc, ##USB16_POLY
.end_B_crc
                add     B_pkt_cnt, #1
                cmp     B_pkt_cnt, B_pkt_tmp        wcz
        if_a    mov     B_retval, #ERR_PACKET             ' Error if payload > expected size
        if_a    ret
' For full-speed at 80MHz, the time it takes to do the final byte write and
' CRC verify has likely put us into the EOP zone. The P2 smart pins keep the
' EOP flag "sticky" for 7-bits of J, but at 80MHz, it still could be possible
' to miss it, so cheat a bit and look for SOP clear here.
                rqpin   B_urx, B_dm
                testb   B_urx, #EOPB              wc      ' FIXME: checking for EOP set should work when > 80MHz
        if_nc   jmp     #.wait_byte                     ' Next read will catch EOP at low-speed
' CRC OK = Payload CRC calc ^ packet's CRC bytes = $B001 (the USB-16 expected residual)
.chk_B_crc
                sub     B_pkt_cnt, #2                     ' Adjust payload count to exclude the CRC bytes read
                xor     B_crc, ##USB16_RESIDUAL   wz      ' CRC of (data + transmitted CRC) XOR residual should equal zero
        if_nz   jmp     #B_urx_packet                     ' CRC fail; discard data and wait until data re-sent or transfer timeout
                mov     B_retval, #PID_ACK
                mov     B_hctwait, B_ip_delay
                call    #B_poll_waitx

                ' Fall through to B_utx_handshake

'------------------------------------------------------------------------------
' Transmit a handshake PID. The routine assumes that the bus is IDLE and
' the appropriate IP delay has been inserted.
'------------------------------------------------------------------------------
' On entry:
'   B_retval - handshake PID to send.
' On exit:
'   B_retval unchanged.
'------------------------------------------------------------------------------
B_utx_handshake
                testb   B_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #B_utx_pre
                mov     B_utx, #OUT_SOP
                call    #B_utx_byte                       ' Send sync
                mov     B_utx, B_retval
                call    #B_utx_byte                       ' Send handshake PID
.idle
                rqpin   B_urx, B_dm
                testb   B_urx, #J_IDLEB           wc
        if_nc   jmp     #.idle                          ' Wait for IDLE to ensure the PID tx is complete
                mov     B_hctwait, B_tat_wait               ' Ensure one turn-around time before next transaction
                jmp     #B_poll_waitx

'------------------------------------------------------------------------------
' Wait for the USB tx buffer to empty and feed it a new byte.
'------------------------------------------------------------------------------
' On entry:
'   B_utx - byte to transmit.
' On exit:
'------------------------------------------------------------------------------
B_utx_byte
                testp   B_dp                      wc
        if_nc   jmp     #B_utx_byte
                akpin   B_dp
                waitx   B_utx_tweak       ' Wait #0 '#3 if < 180MHz, wait #3 '#20 if 180MHz+
        _ret_   wypin   B_utx, B_dm

'------------------------------------------------------------------------------
' Fetch the next data byte of a packet. Always check receiver status for EOP.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   B_retval - the byte read.
'   B_urx - the receiver status. The caller must check the B_hstatus reg EOP flag
'     on return. If EOP is set, the byte in reg B_retval remains as the last byte
'     received.
'------------------------------------------------------------------------------
B_urx_next
                rdpin   B_urx, B_dm
                mov     B_utx, #BYTE_TGLF                 ' Reg utx free in this context
                and     B_utx, B_urx
                cmp     B_newb_flg, B_utx           wz      ' Fetch a byte whenever the flags differ
        if_nz   xor     B_newb_flg, #BYTE_TGLF            ' Synchronize flags
        if_nz   getbyte B_retval, B_urx, #1                 ' Fetch the new byte
        if_nz   ret                                     ' New byte is priority, so return now
                testb   B_urx, #SOPB              wc
                testb   B_urx, #BUS_ERRB          wz
   if_c_and_nz  jmp     #B_urx_next                       ' If SOP still raised and !BUS_ERRB a new byte should be coming
        if_nc   bith    B_hstatus, #EOPB                  ' If EOP make it sticky, otherwise it's a bus error
                ret

'------------------------------------------------------------------------------
' Calculate USB-5 CRC. The upper word of the CRC pre-calc table in LUT contains
' the data used for the USB-5 CRC lookups. The token packet is three bytes in
' length, and the PID is not included in the CRC calculation:
'  CRC5  FRAME_NUMBER SOF (full-speed)
'  CRC5  ENDP ADDRESS PID
' %00000_1111_1111111_xxxxxxxx
'------------------------------------------------------------------------------
' On entry:
'   B_ep_addr_pid - stuffed with the function endpoint, address and
'     SETUP/IN/OUT/SOF PID according to the USB standard.
' On exit:
'   B_ep_addr_pid - CRC value appended to the packet.
'------------------------------------------------------------------------------
B_calc_crc5
                and     B_ep_addr_pid, ##EP_ADDR_MASK     ' Clear existing CRC, if any
                mov     B_htmp, B_ep_addr_pid
                shr     B_htmp, #8                        ' PID not included in CRC calc
                mov     B_crc, #$1f                       ' Initial CRC5 value
                rev     B_htmp                            ' Input data reflected
                setq    B_htmp                            ' CRCNIB setup for data bits 0..7
                crcnib  B_crc, #USB5_POLY
                crcnib  B_crc, #USB5_POLY                 ' Data bits 0..7 calculated
                shl     B_htmp, #9                wc      ' Shift out processed bits + 1 to set up CRC of remaining bits 8..10
                crcbit  B_crc, #USB5_POLY                 ' Inline instead of REP as we're in hubexec
                shl     B_htmp, #1                wc
                crcbit  B_crc, #USB5_POLY
                shl     B_htmp, #1                wc
                crcbit  B_crc, #USB5_POLY
                xor     B_crc, #$1f                       ' Final XOR value
                shl     B_crc, #8 + 11                    ' CRC to bits 23..19 of the token packet
        _ret_   or      B_ep_addr_pid, B_crc                ' Put the CRC in its new home

'------------------------------------------------------------------------------
' Full-speed/low-speed frame timing interrupt service routine.
'------------------------------------------------------------------------------
B_isr1_fsframe
                getct   B_iframe_ct_base
                mov     B_iframe_ct_new, B_iframe_ct_base
                addct1  B_iframe_ct_new, B_frame1ms_clks_
                wxpin   B_usb_h_fs_nco_, B_dm              ' Restore host mode and 12Mbs baud
.wait
                testp   B_dp                      wc
        if_nc   jmp     #.wait
                akpin   B_dp
                mov     B_utx, #PID_SOF
                wypin   #OUT_SOP, B_dm                    ' Put start-of-packet SYNC field on the USB
                call    #B_utx_byte                       ' Send token PID byte
                mov     B_icrc, #$1f                      ' Prime the CRC5 pump
                mov     B_sof_pkt, B_frame                  ' CRC5 calculation done on the 11-bit frame number value
                rev     B_sof_pkt                         ' Input data reflected
                setq    B_sof_pkt                         ' CRCNIB setup for data bits 0..7
                crcnib  B_icrc, #USB5_POLY
                crcnib  B_icrc, #USB5_POLY                ' Data bits 0..7 calculated
                getbyte B_utx, B_frame, #0                  ' Send the low byte of the frame number
                call    #B_utx_byte
                shl     B_sof_pkt, #8                     ' Shift out processed bits to set up CRCBIT * 3
                rep     #2, #3                          ' Three data bits left to process
                shl     B_sof_pkt, #1             wc
                crcbit  B_icrc, #USB5_POLY                ' Data bits 8..10 calculated
                xor     B_icrc, #$1f                      ' Final XOR value
                getbyte B_utx, B_frame, #1                  ' Send remaining frame number bits
                shl     B_icrc, #3                        ' Merge CRC to bits 7..3 of the final token byte
                or      B_utx, B_icrc
                call    #B_utx_byte                       ' Last start-of-frame byte is on the wire
                mov     B_isrtmp1, B_ip_delay_fs_          ' Use normal inter-packet delay when full-speed
                jmp     #B_isr1_wait
B_isr1_lsframe
                getct   B_iframe_ct_base
                mov     B_iframe_ct_new, B_iframe_ct_base
                addct1  B_iframe_ct_new, B_frame1ms_clks_
.wait
                testp   B_dp                      wc
        if_nc   jmp     #.wait
                akpin   B_dp
                wypin   #OUT_EOP, B_dm                    ' EOP is the low-speed keep-alive strobe
                mov     B_isrtmp1, B_ip_delay_ls_          ' Normal inter-packet delay works when low-speed
B_isr1_wait
                rqpin   B_utx, B_dm
                testb   B_utx, #SOPB                 wc
        if_c    jmp     #B_isr1_wait
                add     B_frame, #1                       ' Next frame# and check for wrap around
                zerox   B_frame, #10
                waitx   B_isrtmp1                         ' Make sure bus is idle
                reti1

'------------------------------------------------------------------------------
' Wait for a window within the 1ms frame boundary that will ensure that a
' transaction will complete before the next frame is triggered.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
B_wait_txn_ok
                getct   B_htmp2
                sub     B_htmp2, B_iframe_ct_base
                testb   B_hstatus, #LOW_SPEEDB    wc
        if_c    cmp     B_htmp2, B_txn_ok_ls_      wcz
        if_nc   cmp     B_htmp2, B_txn_ok_fs_      wcz
        if_a    jmp     #B_wait_txn_ok                    ' Not enough time, so wait until next frame
                ret

'------------------------------------------------------------------------------
' A device connection was detected, or a bus reset was requested by the USB
' client. Set the appropriate smart pin FS/LS speed mode to match the device
' and perform a reset sequence prior to device enumeration.
'------------------------------------------------------------------------------
B_dev_reset
                rqpin   B_urx, B_dm
                testb   B_urx, #K_RESUMEB         wc      ' K differential "1" in FS mode signals low-speed
        if_c    call    #B_set_speed_low                  ' The speed config subroutines must restore the caller C flag
        if_nc   call    #B_set_speed_full                 ' state on return if it writes the C flag.
B_reset
                setint1 #0                              ' Don't want frame interrupt while in reset
                wypin   #OUT_SE0, B_dm                    ' Assert bus reset
                waitx   B_reset_hold_                    ' Spec is >= 10ms
                wypin   #OUT_IDLE, B_dm
                mov     B_frame, #0                       ' Reset the frame timespan count
                getct   B_iframe_ct_base
                mov     B_iframe_ct_new, B_iframe_ct_base
                addct1  B_iframe_ct_new, B_frame1ms_clks_
                mov     B_htmp, B_frame                     ' Allow reset recovery time (Section 9.2.6.2)
                add     B_htmp, #36
                setint1 #1                              ' Set ISR event trigger to CT-passed-CT1
.B_framewait
                cmp     B_frame, B_htmp             wcz
        if_b    jmp     #.B_framewait
                ret

'------------------------------------------------------------------------------
' Bulk hub<->hub byte copy. Does not check for src/dest buffer overlap.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - source address.
'   PB - destination address.
'   B_hr0 - length of copy, in bytes.
' On exit:
'------------------------------------------------------------------------------
B_hmemcpy
                rdbyte  B_htmp, ptra++
                wrbyte  B_htmp, pb
                add     pb, #1
        _ret_   djnz    B_hr0, #B_hmemcpy

'------------------------------------------------------------------------------
' A fatal USB error has occured. Notify the client and spin in a pseudo-idle
' loop until the errant device is disconnected.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
B_host_error
                loc     ptra, #@B_usb_error_code
                wrlong  B_retval, ptra                    ' Post the USB operation result value
                wxpin   #USB_ERROR, B_usb_event_pin       ' Signal the client an error has occurred
                drvl    B_host_error_led
                jmp     #host_B_reset                     ' See if it works...

' USB commands and error codes
B_cmd_data        long    0
B_usb_err_code    long    ERR_NONE

' Parameters block assigned at cog startup
B_dm              long    USB_B_BASE_PIN + 2    ' Client defines the basepin for four consecutive USB port pins
B_dp              long    USB_B_BASE_PIN + 3
B_usb_event_pin   long    USB_B_EVENT_REPO      ' Host event reporting uses a long repository smart pin
B_host_active_led long    B_ACTIVITY_LED        ' Client defines the LED pin# for host bus activity
B_host_error_led  long    B_ERROR_LED           ' Client defines the LED pin# to light on error
B_hid_descr_p     long    0, 0[7]
B_hid_report_p    long    0, 0[7]
B_hub_descr_p     long    0
B_urx_buff_p      long    0
B_dev_desc_buff_p long    0
B_con_desc_buff_p long    0
B_cache_start_p   long    0
B_cache_end_p     long    0

B_hdev_init_start
B_hdev_port       long    0
B_hdev_next_datax long    0, 0
B_hub_intf_num    long    0
B_hub_next_datax  long    0
B_hub_status_chg  long    0
B_hub_port_status long    0
B_ms_intf_num     long    0
B_ms_in_max_pkt   long    0
B_kb_intf_num     long    0
B_kb_interval     long    0
B_kb_in_max_pkt   long    0
B_kb_max_index    long    0
B_kb_led_states   long    0
B_kbm_next_datax  long    0
B_gp_intf_num     long    0
B_gp_interval     long    0
B_gp_max_index    long    0
B_gp_descr_len    long    0, 0[7]
B_hdev_init_end

B_hidr_start
B_hidr_id         long    0
B_hidr_axis       long    0[3]
B_hidr_buttons    long    0
B_hidr_hats       long    0
B_hidr_flags      long    0
B_hidr_state      long    0
B_hidr_size       long    0
B_hidr_count      long    0
B_hidr_offset     long    0
B_hidr_usage      long    0
B_hidr_usage_idx  long    0
B_hidr_lminmax    long    0
B_hidr_pminmax    long    0
B_hidr_end

' Initialized at cog startup:
B_save_sysclk     long    0         ' Save the current sysclock as the client may change it
B_hcog_base_addr  long    0         ' This object's start address in hub, read from PTRB at cog creation
B_iframe_ct_new   long    0
B_iframe_ct_base  long    0
B_p2rev_val       long    P2RevB
B_utx_tweak       long    0         ' Sysclock speeds above ~120MHz need some fairy dust for USB tx
' This register block is reset to zero when a USB device connects
B_hreg_init_start
B_hstatus         long    0         ' Host status flags
B_hctwait         long    0         ' Poll-based wait clocks
B_ip_delay        long    0         ' Inter-packet delay in bit periods for connected device speed
B_tat_wait        long    0         ' Maximum bus turn-around time in bit periods for connected device speed
B_nak_retry       long    0         ' NAK retry count, unlimited retries if zero
B_xfer_retry      long    0         ' Control transfer retry count
B_retry           long    0         ' Transaction retry count
B_utx             long    0         ' Byte to transmit on USB
B_urx             long    0         ' LSByte receiver status flags, MSByte received data
B_newb_flg        long    0         ' Receive "new byte" bit toggle detector
B_max_pkt_size    long    0         ' Maximum payload bytes allowed, likely to change on device connect.
B_total_data      long    0         ' Total bytes to tx/rx in a transfer data stage
B_stage_data      long    0         ' Count of bytes sent/received so far during a data stage.
B_pkt_data        long    0         ' Payload size of an OUT packet or bytes received on IN
B_frame           long    0         ' USB 1ms frame counter value
B_sof_pkt         long    0         ' ISR frame# packet and CRC5
B_icrc            long    0         ' Only used by the 1ms frame output ISR routine
B_pkt_cnt         long    0         ' Count of DATAx packet payload bytes
B_crc             long    0         ' Used for CRC16 calculation
B_ep_addr_pid     long    0         ' Endpoint and device addresses for connected device
B_retval          long    0         ' Global success/fail return parameter
B_context_retval  long    0         ' Operation contextual return parameter
' Device stuff
B_hdev_id         long    0
B_hdev_bcd        long    0
B_hdev_type       long    0
B_hdev_type2      long    0      ' Configured device indicator
' Keyboard/mouse stuff
B_hctrl_ep_addr   long    0
B_hctrl_max_pkt   long    0
B_hconfig_base    long    0
B_hcon_tot_len    long    0         ' Size of the complete config descriptor chain
B_hdev_intf_idx   long    0         ' Used during verbose descriptor terminal output
B_hdev_class      long    0
B_hdev_subclass   long    0
B_hdev_protocol   long    0
B_hsearch_key     long    0         ' Descriptor type to search for in the config chain
B_hnext_desc      long    0         ' Offset from the config descriptor start address to the next descriptor in the chain
B_hhub_ctrl_ep    long    0         ' Hub control endpoint address
B_hhub_ep_addr    long    0         ' Hub interface endpoint address
B_hmouse_ep_addr  long    0         ' Mouse interface endpoint address
B_hkbd_ctrl_ep    long    0         ' Keyboard control endpoint address
B_hkbd_ep_addr    long    0         ' Keyboard interface endpoint address
B_hkbd_poll_cnt   long    0         ' Poll interval counter used for key auto-repeat
B_hkbd_rpt_key    long    0         ' Key to repeat (0 disables repeat)
B_hkbd_ledstates  long    0         ' Off/on state of keyboard LEDs
B_hdev_ep_addr    long    0, 0[7]
B_hdev_out_addr   long    0
B_hreg_init_end
' Variables dependent on the system freqency
B_var_64_lower_  long    0
B_var_64_upper_  long    0
B_12Mbps_        long    0
B_1_5Mbps_       long    0
B_1ns16fp_       long    0         ' 1ns as 32,16 fixed point
B_1us_           long    0         ' 1us
B_10us_          long    0         ' 10us
B_33us_          long    0         ' 33us
B_txn_err_       long    0         ' 250us
B_500us_         long    0         ' 500us
B_txn_ok_ls_     long    0         ' 666us timespan for LS transaction OK window
B_txn_ok_fs_     long    0         ' 850us timespan for FS transaction OK window
B_ip_delay_ls_   long    0         ' Low-Speed inter-packet 4 bit-time delay
B_ip_delay_fs_   long    0         ' Full-Speed inter-packet 4 bit-time delay
B_tat_wait_ls_   long    0         ' Low-Speed turnaround 22 bit-time wait
B_tat_wait_fs_   long    0         ' Full-Speed turnaround 28 bit-time wait
B_preamble_wait_ long    0
B_1ms_           long    0         ' 1ms
B_2ms_           long    0         ' 2ms
B_suspend_wait_  long    0         ' 3ms
B_4ms_           long    0         ' 4ms
B_xfer_wait_     long    0         ' 5ms
B_8ms_           long    0         ' 8ms timespan for keyboard/mouse interrupt IN transactions
B_reset_hold_    long    0         ' 15ms
B_resume_hold_   long    0         ' Hold K-state for 20ms to signal device(s) to resume
B_21ms_          long    0         ' 21ms
B_100ms_         long    0         ' 100ms
B_500ms_         long    0         ' 500ms
B_pulse_time_    long    0         ' Activity LED toggle interval, one sec connect wait, 500ms_ when connected
B_frame1ms_clks_ long    0         '_1ms +/- n clocks: calculated based on the current sysclock
'------------------------------------------------------------------------------
B_usb_h_ls_nco_  long    0         ' USB smart pin modes dependent on sysclock
B_usb_d_ls_nco_  long    0
B_usb_h_fs_nco_  long    0
B_usb_d_fs_nco_  long    0
'------------------------------------------------------------------------------
' Scratch registers
B_htmp            long    0         ' Scratch registers whose context remains within the same code block
B_htmp1           long    0
B_htmp2           long    0
B_htmp3           long    0
B_hrep            long    0         ' Repeat count
B_hsave0          long    0         ' Subroutine parameter saves
B_hsave1          long    0
B_hsave2          long    0
B_isrtmp1         long    0
B_pkt_tmp         long    0         ' Tmp storage for routines that deal with datax packets
B_hr0             long    0         ' Multi-purpose registers
B_hr1             long    0
B_hr2             long    0
B_hr3             long    0
B_hpar1           long    0         ' Routine entry/exit parameters
B_hpar2           long    0
B_hpar3           long    0
B_hct2            long    0         ' Function response bus turn-around timer
B_hct3            long    0         ' Keyboard/mouse poll timer
B_mod_cnt         long    0         ' Used in idle loops
B_last_mouse_data long    0

B_gpad_last_x     long    0[2]      ' max 4 gamepads, one word each
B_gpad_last_y     long    0[2]      ' max 4 gamepads, one word each
B_gpad_last_b     long    0[2]      ' max 4 gamepads, one word each
                fit     $1F0

DAT             ' USB Host LUT execution
                orgf     $200 ' WAS 'org' IN ORIGINAL
B_hlut_start

'------------------------------------------------------------------------------
' Full-speed is the host's native speed, so all that is needed is to set the FS
' settings to startup defaults.
'------------------------------------------------------------------------------
' On entry:
' On exit: Save/restore caller C flag state if C is changed in this routine!
'------------------------------------------------------------------------------
B_set_speed_full
                mov     ijmp1, #B_isr1_fsframe            ' Set the USB 1ms frame handler ISR routine
                mov     B_max_pkt_size, #64               ' Set FS control read/write DATAx packet size
                mov     B_tat_wait, B_tat_wait_fs_         ' Bus turn-around time in full-speed bit periods
        _ret_   mov     B_ip_delay, B_ip_delay_fs_         ' Inter-packet delay in full-speed bit periods
'                ret                             wcz     ' Restore caller flags on exit

'------------------------------------------------------------------------------
' When a low-speed device connects, the D-/D+ signaling is inverted. If there
' is a downstream hub connected (not yet implemented), the baud generator
' remains set at the full-speed rate, but signaling is switched to low-speed,
' which reverses the D-/D+ polarity. The polarity can be changed without
' putting the smart pins into reset.
'------------------------------------------------------------------------------
' On entry:
' On exit: CZ flags restored to caller states
'------------------------------------------------------------------------------
B_set_speed_low
                test    B_hstatus, #DWNSTRM_HUBF  wz      ' If no downstream hub connected, set low-speed baud
        if_z    mov     ijmp1, #B_isr1_lsframe            ' Set the USB 1ms frame handler ISR routine
                testb   B_p2rev_val, #0           wc      ' P2 Revision is either %0001 (A) or %0010 (B+)
        if_c    dirl    B_dm                              ' P2RevA needs to be completely reconfigured
        if_c    dirl    B_dp
        if_c    wrpin   ##USB_V1HMODE_LS, B_dm            ' Low-speed signaling is always used
        if_c    wrpin   ##USB_V1HMODE_LS, B_dp
        if_c    wxpin   B_1_5Mbps_, B_dm                   ' Set 1.5Mbs baud if no downstream hub
        if_c    dirh    B_dm
        if_c    dirh    B_dp
        if_nc   wxpin   B_usb_h_ls_nco_, B_dm              ' Host mode and 1.5Mbs baud if no downstream hub
                mov     B_max_pkt_size, #8                ' Set LS control read/write DATAx packet size
                mov     B_tat_wait, B_tat_wait_ls_         ' Bus turn-around time in low-speed bit periods
                mov     B_ip_delay, B_ip_delay_ls_         ' Inter-packet delay in low-speed bit periods
                bith    B_hstatus, #LOW_SPEEDB            ' D- pulled high, so it's a Low-Speed device
                ret                             wcz     ' Restore caller flags on exit

'------------------------------------------------------------------------------
' Perform configuration stuff required when a device intitially connects.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
B_on_connect
                mov     B_hr0, #2                         ' FIXME: need to determine a reasonable limit for reset & retry
                call    #B_dev_reset                      ' Reset device prior to Get Device Descriptor request
.B_retry
                testb   B_hstatus, #LOW_SPEEDB    wc
        if_c    mov     B_hpar1, #USB_SPEED_LOW           ' Also the connect speed
        if_nc   mov     B_hpar1, #USB_SPEED_FULL
                mov     B_ep_addr_pid, ##EP_ADDR_ZERO     ' New connect, use pre-calc CRC for ep/addr zero
                loc     ptra, #@B_get_dev_desc - @B_usb_host_start ' Hub start address of GetDeviceDescriptor SETUP struct
                add     ptra, B_hcog_base_addr
                wrword  #8, ptra[wLength]               ' Request IN data stage max of 8 bytes will test actual < requested logic
                mov     pb, B_dev_desc_buff_p             ' Start address of DeviceDescriptor struct for IN data
                call    #B_control_read                   ' Execute GetDeviceDescriptor()
                cmp     B_retval, #PID_ACK        wz
        if_z    jmp     #.B_get_dev_desc
                mov     B_hctwait, B_500ms_                ' If the first GetDescriptor() fails, reset and try again
                call    #B_poll_waitx
                sub     B_hr0, #1         wz              ' FIXME: need to determine a reasonable limit for reset & retry
        if_z    jmp     #B_host_error                     ' Post error and spin until the errant device is disconnected
                call    #B_reset                          ' Try another reset to see if the device responds
                jmp     #.B_retry
.B_get_dev_desc
                mov     pa, B_dev_desc_buff_p             ' Fetch the max packet size for control transactions from the
                add     pa, #DEV_bMaxPktSize0           ' appropriate Device Descriptor struct member offset
                rdbyte  B_max_pkt_size, pa
                mov     B_hctwait, B_1ms_
                call    #B_poll_waitx                     ' Do a reset before SetAddress(), but wait a bit first
                call    #B_reset
                loc     ptra, #@B_set_address - @B_usb_host_start ' Hub start address of SetAddress SETUP struct
                add     ptra, B_hcog_base_addr
                wrword  #8, ptra[wValue]                ' Only support one device port at this time
                call    #B_control_write                  ' Execute SetAddress()
                cmp     B_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to idle if not ACK
                mov     B_hctwait, B_8ms_
                call    #B_poll_waitx                     ' Allow SetAddress() a minimum 2ms recovery interval
                mov     B_ep_addr_pid, ##8 << 8           ' Device ep/addr now #8 and endpoint zero
                call    #B_calc_crc5
                loc     ptra, #@B_get_dev_desc - @B_usb_host_start ' Repeat SETUP for GetDeviceDescriptor()
                add     ptra, B_hcog_base_addr
                mov     pb, B_dev_desc_buff_p             ' Start address of DeviceDescriptor struct has exact descriptor length
                rdbyte  B_total_data, pb
                wrword  B_total_data, ptra[wLength]       ' Assign it to the SETUP wLength struct member
                call    #B_control_read                   ' Execute GetDeviceDescriptor() again, but with updated data length
                cmp     B_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to idle if not ACK
                mov     B_hctrl_ep_addr, B_ep_addr_pid      ' Make the device control address and endpoint official
                mov     ptra, B_dev_desc_buff_p           ' Do the same with the control max packet size
                rdbyte  B_hctrl_max_pkt, ptra[DEV_bMaxPktSize0]
                mov     B_hctwait, B_500us_
                call    #B_poll_waitx
                loc     ptra, #@B_get_config_desc - @B_usb_host_start ' Hub start address of GetConfigurationDescriptor SETUP struct
                add     ptra, B_hcog_base_addr
                wrword  #$FF, ptra[wLength]             ' Maximum DATAx bytes for receive to the SETUP struct
                mov     pb, B_con_desc_buff_p             ' Hub start address of ConfigurationDescriptor structure
                call    #B_control_read                   ' Execute GetConfigurationDescriptor()
                cmp     B_retval, #PID_ACK        wz
        if_nz   ret
                mov     ptra, B_con_desc_buff_p           ' Check the config descriptor struct for expected data
                mov     B_hconfig_base, ptra              ' Will need this for configuration
                rdbyte  B_hr0, ptra++                     ' Config.bLength is at offset zero, expect >= CON_DESC_LEN
                rdbyte  B_hr1, ptra++                     ' Config.bDescType is next member, expect = TYPE_CONFIG constant
                rdword  B_htmp, ptra                      ' Config.wTotalLen is next member, expect >= bytes actually received
                cmp     B_hr0, #CON_DESC_LEN      wcz
        if_ae   cmp     B_hr1, #TYPE_CONFIG       wcz
        if_z    cmp     B_htmp, B_total_data        wcz
        if_b    mov     B_retval, #ERR_CONFIG_FAIL
        if_b    jmp     #B_host_error
                loc     pa, #@B_init_kbdm_data - @B_usb_host_start
                add     pa, B_hcog_base_addr
                call    pa
                loc     pa, #@B_hparse_con_desc - @B_usb_host_start
                add     pa, B_hcog_base_addr
                jmp     pa

'------------------------------------------------------------------------------
' Perform a control read transaction (Section 8.5.3, Figure 8-37).
' Status reporting is always in the function-to-host direction.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - start address of the SETUP data in hub.
'   PB - start address of the buffer/struct to be written to during the IN data
'     stage.
'   B_ep_addr_pid - device address, endpoint and CRC5.
' On exit:
'   B_retval - PID_ACK on success, otherwise error. If successful, reg B_total_data
'     contains the count of data stage bytes actually received, which must
'     always be <= the count requested.
'   B_context_retval - ERR_NONE if the overall transfer succeeds, otherwise a
'     more specific USB operation error code.
'------------------------------------------------------------------------------
B_control_read
                mov     B_hpar1, B_ep_addr_pid
                mov     B_hpar2, ptra
                mov     B_hpar3, pb                       ' Save dest buffer pointer
                mov     B_xfer_retry, #XFER_RETRIES
.xfer_start
                rdword  B_total_data, ptra[wLength]       ' Get the size of the data stage from the SETUP struct
                call    #B_txn_setup                      ' SETUP logic is the same for both control reads and writes
                cmp     B_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to caller to handle error
                cmp     B_total_data, #0          wz
        if_z    jmp     #B_pre_status_in                  ' No data, so directly to status stage
                mov     B_stage_data, #0                  ' Prepare for data stage
                mov     B_nak_retry, ##IN_NAK_RETRIES
                bith    B_hstatus, #DATAx_TGLB            ' Data stage starts with DATA1 PID
.data
                mov     B_pkt_data, B_total_data
                sub     B_pkt_data, B_stage_data
                cmp     B_pkt_data, B_max_pkt_size  wcz
        if_a    mov     B_pkt_data, B_max_pkt_size          ' Have a full packet with more data left
.B_nak_retry
                mov     B_retry, #TXN_RETRIES             ' Reset bus error retry limit
.in_B_retry
                call    #B_txn_in
                cmp     B_retval, #PID_ACK        wz      ' Commit on ACK
        if_z    jmp     #.commit
                cmp     B_retval, #PID_STALL      wz
        if_z    jmp     #.B_xfer_retry                    ' STALL triggers a transfer retry
                call    #B_retry_wait                     ' Wait a bit before retry
                cmp     B_retval, #PID_NAK        wz
        if_z    jmp     #.B_nak_retry                     ' Function not ready to send data
                cmp     B_retval, #ERR_NAK        wz
        if_z    jmp     #.B_xfer_retry                    ' NAK limit exceeded triggers a transfer retry
                cmp     B_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.in_B_retry                      ' Bus error retry
                ret                                     ' The transfer has failed
.commit
                cmp     B_pkt_cnt, #0             wz      ' Empty pkt means previous pkt was max_pkt_len
        if_z    jmp     #.pre_status                    ' and also end-of-data
                mov     ptra, B_urx_buff_p                ' Copy DATAx in rx buffer to dest struct
                mov     B_hr0, B_pkt_cnt
                cmp     ptra, pb                wz
        if_nz   call    #B_hmemcpy                        ' hmemcpy(PTRA, PB, B_hr0)
                add     B_stage_data, B_pkt_cnt             ' Update bytes received on commit
                cmp     B_stage_data, B_total_data  wz      ' Have all asked-for bytes?
        if_z    jmp     #.pre_status                    ' Have all the data that's coming, so done
                cmp     B_pkt_cnt, B_pkt_data       wcz     ' Check for short packet
        if_b    jmp     #.pre_status                    ' Actual payload < expected means end of data stage
        if_a    mov     B_retval, #ERR_PACKET
        if_a    mov     B_context_retval, B_retval          ' In this case overall and context are the same
        if_a    ret                                     ' Caller must handle ERR_PACKET
                bitnot  B_hstatus, #DATAx_TGLB            ' Toggle DATAx sync bit
                jmp     #.data                          ' Start next IN transaction
.pre_status
                mov     B_total_data, B_stage_data          ' Replace the asked-for byte count with the bytes actually received
                setbyte B_ep_addr_pid, #PID_OUT, #0
                mov     B_pkt_data, #0
                bith    B_hstatus, #DATAx_TGLB            ' Status stage starts with DATA1 PID
                mov     B_retry, #TXN_RETRIES             ' Reset txn retry limit
                mov     B_nak_retry, ##OUT_NAK_RETRIES
.B_out_retry
                call    #B_txn_out                        ' Send empty OUT DATAx packet to confirm IN data received OK
                cmp     B_retval, #PID_ACK        wz
        if_z    ret                                     ' All is good when ACK
                cmp     B_retval, #PID_STALL      wz
        if_z    jmp     #.B_xfer_retry                    ' STALL triggers a transfer retry
                call    #B_retry_wait                     ' Wait a bit before retry
                cmp     B_retval, #ERR_NAK        wz
        if_z    jmp     #.B_xfer_retry                    ' NAK limit exceeded triggers a transfer retry
                cmp     B_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.B_out_retry                     ' Retry due to bus error or OUT-NAK retry limit not reached
                ret                                     ' Caller must handle transfer retirement
' I've encountered transfer STALL, even though the data looks correct, and
' instances of getting stuck in an endless OUT-NAK loop. Repeating the entire
' ControlRead() transfer gets things unstuck most of the time...
.B_xfer_retry
                mov     B_hctwait, B_xfer_wait_
                call    #B_poll_waitx
                call    #B_wait_txn_ok
                mov     B_ep_addr_pid, B_hpar1
                mov     ptra, B_hpar2
                mov     pb, B_hpar3
                djnz    B_xfer_retry, #.xfer_start
                mov     B_context_retval, B_retval          ' Preserve the USB error code
        _ret_   mov     B_retval, #ERR_XFER_RETRY

'------------------------------------------------------------------------------
' Perform a control write transaction (Section 8.5.3, Figure 8-37). Status
' reporting is always in the function-to-host direction. It is assumed that
' the SETUP data struct is filled with the required values.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - points to the start of the struct for the SETUP data.
'   PB - the start address of the struct/buffer to be read for the OUT data
'     stage.
'   B_ep_addr_pid - the proper CRC'd address and endpoint to use.
' On exit:
'   B_retval - used to convey the success/failure of each stage.
'   B_context_retval - ERR_NONE if the overall transfer succeeds, otherwise a
'     more specific USB operation error code.
'------------------------------------------------------------------------------
B_control_write
                testb   B_ep_addr_pid, #31        wc
        if_c    bith    B_hstatus, #DWNSTRM_HUBB
        if_c    bith    B_usb_h_ls_nco_, #14

                mov     B_hpar1, B_ep_addr_pid
                mov     B_hpar2, ptra
                mov     B_hpar3, pb
                mov     B_xfer_retry, #XFER_RETRIES
.xfer_start
                mov     B_nak_retry, #NAK_NOLIMIT         ' Unlimited NAK retries the default
                rdword  B_total_data, ptra[wLength]       ' Get the size of the data stage from the SETUP struct
                call    #B_txn_setup                      ' SETUP logic is the same for both control reads and writes
                cmp     B_retval, #PID_ACK        wz
        if_nz   jmp     #B_dwnstream_reset                ' Back to caller to handle error
                cmp     B_total_data, #0          wz
        if_z    jmp     #B_pre_status_in                  ' No data, so directly to status stage
                mov     B_stage_data, #0                  ' Prepare for data stage
                setbyte B_ep_addr_pid, #PID_OUT, #0       ' PID isn't part of the CRC calc
                bith    B_hstatus, #DATAx_TGLB            ' Data stage starts with DATA1 PID
                mov     B_retry, #TXN_RETRIES             ' Reset txn retry limit
.data
                mov     B_pkt_data, B_total_data
                sub     B_pkt_data, B_stage_data
                cmp     B_pkt_data, B_max_pkt_size  wcz
        if_a    mov     B_pkt_data, B_max_pkt_size          ' Data remaining is > max_pkt, so cap at max_pkt
.B_out_retry
                mov     ptra, pb                        ' Set current location in the OUT data buffer/struct
                call    #B_txn_out
                cmp     B_retval, #PID_ACK        wz
        if_z    jmp     #.commit                        ' Function got the data
                call    #B_retry_wait                     ' Wait a bit before retry
                cmp     B_retval, #ERR_TXN_RETRY  wz      ' Out of !NAK retries?
        if_nz   jmp     #.B_out_retry
                jmp     #B_dwnstream_reset                ' Caller must handle transfer retirement
.commit
                mov     pb, ptra                        ' Save the current buffer/struct location
                add     B_stage_data, B_pkt_data
                cmp     B_stage_data, B_total_data  wz
        if_nz   bitnot  B_hstatus, #DATAx_TGLB            ' Toggle DATAx sync bit
        if_nz   jmp     #.data                          ' More data to send
B_pre_status_in
                bith    B_hstatus, #DATAx_TGLB            ' Status stage expects IN to be an empty DATA1 packet
                mov     B_retry, #TXN_RETRIES             ' Reset txn retry limit
.B_status_retry
                mov     B_pkt_data, #0
                call    #B_txn_in
                cmp     B_retval, #PID_ACK        wz      ' ACK says a DATA1 packet was received
        if_z    cmp     B_pkt_data, #0            wz      ' DEBUG: should never fail if the function is USB compliant?
        if_z    jmp     #B_dwnstream_reset                ' Control Write finished
                cmp     B_retval, #PID_STALL      wz      ' STALL needs to go to the caller for resolution
        if_z    jmp     #B_dwnstream_reset
                call    #B_retry_wait                     ' NAK or bus error, so delay a bit
                cmp     B_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.B_status_retry
'                ret                                     ' Caller must handle transfer retirement

'------------------------------------------------------------------------------
' Execute an IN interrupt transaction.
'------------------------------------------------------------------------------
' On entry:
'   B_ep_addr_pid - The function address and endpoint for the IN request.
'   B_hpar2 - Address of the IN data buffer
'   B_hpar3 - Word1 has max data packet size, word0 has the DATAx to expect.
' On exit:
'   B_retval - the result of the operation.
'   B_hpar3 - the count of IN data bytes actually received.
'------------------------------------------------------------------------------
B_do_int_in
                testb   B_ep_addr_pid, #31        wc
        if_c    bith    B_hstatus, #DWNSTRM_HUBB
        if_c    bith    B_usb_h_ls_nco_, #14

                getword B_htmp, B_hpar3, #0
                cmp     B_htmp, #PID_DATA0        wz
                bitnz   B_hstatus, #DATAx_TGLB            ' Set/reset flag for DATAx to expect
                mov     B_retry, #TXN_RETRIES
.B_retry
                getword B_pkt_data, B_hpar3, #1             ' IN max packet length
                call    #B_txn_in
                cmp     B_retval, #PID_ACK        wz      ' ACK if data received
        if_z    jmp     #.commit
                cmp     B_retval, #PID_NAK        wz      ' NAK if no data available (common)
        if_nz   cmp     B_retval, #PID_STALL      wz      ' STALL if the endpoint has a transfer issue and must be reset (rare)
        if_z    jmp     #.post_ret                      ' The caller must handle either
                call    #B_retry_wait
                cmp     B_retval, #ERR_TXN_RETRY  wz
        if_z    jmp     #.post_ret
                jmp     #.B_retry
.commit
                mov     ptra, B_urx_buff_p                ' Copy the rx buffer
                mov     pb, B_hpar2                       ' to the destination buffer
                mov     B_hr0, B_pkt_cnt            wz      ' Skip copy if it's an empty packet
        if_nz   cmp     ptra, pb                wz
        if_nz   call    #B_hmemcpy                        ' hmemcpy(PTRA, PB, B_hr0)
.post_ret
                mov     B_hpar3, B_pkt_cnt                  ' IN bytes actually received

'------------------------------------------------------------------------------
' Resets the downstream hub port to FS
'------------------------------------------------------------------------------
B_dwnstream_reset
                testb   B_ep_addr_pid, #31        wc
        if_nc   ret                                     ' No LS device, reset not needed
                bitl    B_usb_h_ls_nco_, #14
                bitl    B_hstatus, #DWNSTRM_HUBB
                wxpin   B_usb_h_fs_nco_, B_dm              ' Restore host mode and 12Mbs baud
                mov     B_max_pkt_size, #64               ' Set FS control read/write DATAx packet size
                mov     B_tat_wait, B_tat_wait_fs_         ' Bus turn-around time in low-speed bit periods
        _ret_   mov     B_ip_delay, B_ip_delay_fs_         ' Inter-packet delay in low-speed bit periods

'------------------------------------------------------------------------------
' The one millisecond frame timer is implemented as an interrupt service
' routine. Since this timing is critical, care must be taken to avoid any
' instructions that can delay the interrupt branch, which will likely upset
' the timer. WAITX is among those instructions, so any time you're inside
' an IN/OUT/SETUP transaction, use this routine instead of WAITX.
'------------------------------------------------------------------------------
' On entry:
'   B_hctwait - wait interval in sysclocks.
' On exit:
'------------------------------------------------------------------------------
B_poll_waitx
                getct   B_hct2
                addct2  B_hct2, B_hctwait
.wait
                jnct2   #.wait
                ret

'------------------------------------------------------------------------------
' Transaction retry handling for NAK/STALL or bus error.
'------------------------------------------------------------------------------
' On entry:
'   B_retval - transaction response PID or error code.
' On exit:
'------------------------------------------------------------------------------
B_retry_wait
                cmp     B_retval, #PID_STALL      wz
        if_z    ret                                     ' STALL is special case
                cmp     B_retval, #PID_NAK        wz
        if_z    jmp     #.nak
                mov     B_hctwait, B_txn_err_              ' Transaction error wait...
                call    #B_poll_waitx
.dec
                sub     B_retry, #1               wz
        if_z    mov     B_retval, #ERR_TXN_RETRY          ' Only set error code if no retries left
                ret                                     ' Retry result to caller
.nak
                mov     B_hctwait, B_33us_                 ' Seems to be a reasonable NAK delay
                call    #B_poll_waitx
                cmp     B_nak_retry, #NAK_NOLIMIT wz
        if_z    ret                                     ' Indefinite NAK retries
                sub     B_nak_retry, #1           wz
        if_z    mov     B_retval, #ERR_NAK
                ret

host_B_reset
                setint1 #0                              ' Ensure 1ms frame strobe interrupt is off
                mov     B_htmp, ##_CLOCKFREQ                ' Get current sysclock setting
' FIXME: kludge to set a USB tx byte write ACKPIN<->WRPIN delay.
                cmp     B_htmp, ##168_000_000     wcz
        if_be   mov     B_utx_tweak, #0
        if_a    mov     B_utx_tweak, #3   '#20
' Check to see if the system clock has been changed.
                cmp     B_htmp, B_save_sysclk       wz
        if_nz   loc     pb, #@B_hinit_usb_timings - @B_usb_host_start
        if_nz   add     pb, B_hcog_base_addr
        if_nz   call    pb                              ' Recalculate sysclk dependent timing values
                dirl    B_dm                              ' Put smart pins into reset
                dirl    B_dp
                cmp     B_p2rev_val, #P2RevB      wz
        if_z    jmp     #.not_reva
                wrpin   ##USB_V1HMODE_FS, B_dm            ' The host is also the root hub, so full-speed is its native speed
                wrpin   ##USB_V1HMODE_FS, B_dp
                wxpin   B_12Mbps_, B_dm                    ' Default to Full-Speed
                jmp     #.enable
.not_reva
                wrpin   ##USB_V2_DRVOUT, B_dm             ' The same USB smart pin mode for D- and D+ pins
                wrpin   ##USB_V2_DRVOUT, B_dp
                wxpin   B_usb_h_fs_nco_, B_dm              ' Set host mode and full-speed NCO
.enable
                dirh    B_dm                              ' Crank them smart pins up
                dirh    B_dp
                waitx   B_1us_
                wypin   #OUT_IDLE, B_dm

                ' Handle Port protection enable and startup delay
                mov     B_htmp, B_usb_event_pin             ' I/O + 1 pin is the Serial Host USB Protection enable/disable
                add     B_htmp, #1                        ' Protection enable is a one-time operation
                drvl    B_htmp                            ' disable port
                waitx   B_21ms_                          ' Wait a while for everything to turn off
                drvh    B_htmp                            ' Enable the port
                waitx   B_21ms_                          ' Hold to let the idle state get settled

                setd    pa, #B_hreg_init_start            ' Reset all host common registers to startup values
                rep     @.regloop,#B_hreg_init_end - B_hreg_init_start
                alti    pa, #%000_111_000
                mov     0-0, #0
.regloop

B_discon_entry
                mov     B_mod_cnt, #3                     ' Make the first heartbeat pulse a short one

                ' Fall through to B_disconnected loop

'-----------------------------------------------------------------------------------------------------------------
' Device connect handling (Section 7.1.7.3).
'-----------------------------------------------------------------------------------------------------------------
' The 15K pull-down resistors on D+ and D- allow the host to passively monitor the bus lines while waiting for a
' device to connect (Section 7.1.7.3).
'-----------------------------------------------------------------------------------------------------------------
B_disconnected
                mov     B_hr1, ##_CLOCKFREQ                 ' Check to see if the system frequency has changed
                cmp     B_hr1, B_save_sysclk        wz
        if_nz   jmp     #host_B_reset                     ' host_reset will apply the new USB bus NCO calculation
                shr     B_hr1, #3                         ' Pulse the activity LED every two seconds but break
                waitx   B_hr1                             ' it down to smaller wait chunks
                incmod  B_mod_cnt, #8             wc
        if_c    drvnot  B_host_active_led
                rqpin   B_urx, B_dm
                and     B_urx, #J_IDLEF | K_RESUMEF wcz   ' Wait for rise of J or K, mutually exclusive
        if_z    jmp     #B_disconnected                   ' J and K still low, so keep waiting for connect
        if_ne   jmp     #.connect_test                  ' J or K is high, so test for connect
.se1_test
                mov     B_hctwait, B_100ms_                ' J and K high is illegal SE1 state, so wait and retest
                call    #B_poll_waitx
                rqpin   B_urx, B_dm
                and     B_urx, #J_IDLEF | K_RESUMEF wcz
        if_ne   mov     B_retval, #ERR_NONE               ' SE0 or idle state resets any previous error
        if_ne   jmp     #B_discon_entry                   ' Back to connect detection loop
.se1            'SE1 is a fatal error condition
                mov     B_hctwait, B_100ms_
                call    #B_poll_waitx
                mov     B_retval, #ERR_SE1
                call    #B_host_error                     ' Seeing SE1 for any length of time is not good...
.connect_test                                           ' Test lines until stable J/K state seen
                waitx   B_100ms_                         ' Total of 100ms debounce interval (Section 7.1.7.3)
                rqpin   B_urx, B_dm
                and     B_urx, #J_IDLEF | K_RESUMEF wcz
        if_z    jmp     #B_discon_entry                   ' D+ and D- low
        if_e    jmp     #.se1_test                      ' D+ and D- high
B_connected
                bith    B_hstatus, #CONNECTEDB            ' Device plugged in
                call    #B_on_connect                     ' Initial device configuration
                cmp     B_retval, #PID_ACK        wz      ' Anything other than ACK means the device is unusable
        if_nz   jmp     #B_discon_entry
.set_pulse
                getct   B_pulse_time_
                add     B_pulse_time_, B_500ms_           ' Set activity LED pulse to the bus idle toggle rate
' Sample the USB 1ms B_frame delta register to see how close it is to the ideal frame interval
' of 1ms and make a correction, if necessary.
'                mov     B_htmp, B_1ms_
'                subs    B_htmp, B_iframe_delta
'                adds    B_frame1ms_clks_, B_htmp
'                debug(udec(B_frame1ms_clks_))

                ' Fall through to idle/processing loop

                cmp     B_hdev_port, #7           wcz
        if_a    mov     B_hdev_port, #0

B_hidle
                rqpin   B_urx, B_dm
                testb   B_urx, #SE0_RESETB        wc
        if_c    jmp     #.se0_test
                pollct3                         wc
        if_nc   jmp     #.nopoll
                getct   B_hct3
                addct3  B_hct3, B_1ms_                     ' Set the timer for next poll interval

                altgb   B_hdev_port, #B_hdev_type
                getbyte B_htmp

                cmp     B_htmp, #HID_READY        wz
        if_nz   cmp     B_htmp, #PS3_READY        wz
        if_nz   cmp     B_htmp, #XINPUT_READY     wz
                loc     pa, #@B_hget_gp_in_report - @B_usb_host_start
        if_z    jmp     #.poll

                cmp     B_htmp, #HUB_READY        wz
                loc     pa, #@B_hget_hub_status - @B_usb_host_start
        if_z    wxpin   B_htmp, B_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     B_htmp, #KB_READY         wz
                loc     pa, #@B_hget_kbd_in_report - @B_usb_host_start
        if_z    wxpin   B_htmp, B_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     B_htmp, #M_READY          wz
                loc     pa, #@B_hget_mouse_in_report - @B_usb_host_start
        if_z    wxpin   B_htmp, B_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     B_htmp, #KBM_READY        wz
        if_z    wxpin   B_htmp, B_usb_event_pin             ' Notify the client
        if_nz   jmp     #.next
                bitnot  B_hstatus, #KBM_TOGGLEB   wcz
        if_nc   loc     pa, #@B_hget_kbd_in_report - @B_usb_host_start
        if_c    loc     pa, #@B_hget_mouse_in_report - @B_usb_host_start
.poll
                add     pa, B_hcog_base_addr
                call    pa
.next
                incmod  B_hdev_port, #7

'                call    #B_key_repeat                     ' perform key auto-repeat
                loc     pa, #@B_key_repeat - @B_usb_host_start
                add     pa, B_hcog_base_addr
                call    pa

.nopoll
                cmp     B_cmd_data, #CMD_SUSPEND  wz
        if_z    jmp     #B_hsuspend
                cmp     B_cmd_data, #CMD_RESET    wz
        if_z    mov     B_cmd_data, #ERR_NONE             ' Acknowledge client reset cmd received
        if_z    jmp     #host_B_reset                     ' See if it works...
                getct   B_hr0
                cmp     B_hr0, B_pulse_time_       wcz     ' Connected "heartbeat"
        if_ae   drvnot  B_host_active_led
        if_ae   getct   B_pulse_time_
        if_ae   add     B_pulse_time_, B_500ms_
                jmp     #B_hidle
' Check for extended SE0 state on the bus
.se0_test
                mov     B_hctwait, B_1ms_
                call    #B_poll_waitx                     ' Wait a bit and test for SE0 again
                rqpin   B_urx, B_dm
                testb   B_urx, #SE0_RESETB        wc
        if_nc   jmp     #B_hidle                          ' Bus still IDLE
                call    #B_wait_txn_ok
                wypin   ##OUT_IDLE, B_dm                  ' Float USB
                wxpin   #DEV_DISCONNECT, B_usb_event_pin  ' Notify client of disconnect
                jmp     #host_B_reset                     ' Device disconnected

B_hsuspend
                call    #B_wait_txn_ok                    ' Avoid a potential collision with an active frame isr
                setint1 #0                              ' Stopping the 1ms frame packets signals suspend
                waitx   B_suspend_wait_                  ' The device enters suspend state when the bus is idle and
                wypin   #OUT_IDLE, B_dm                   ' no frame SOPs are received for three consecutive frames
                mov     B_cmd_data, #ERR_NONE             ' Clear the cmd from the event queue
                mov     B_mod_cnt, #0

                ' Fall through to resume wait loop

B_hwait_resume
                mov     B_hr1, ##_CLOCKFREQ                 ' Use the CLKFREQ value, as the sysclock may change
                shr     B_hr1, #2
                waitx   B_hr1                             ' Pulse the activity LED every two seconds but break
                incmod  B_mod_cnt, #8             wc      ' it down to smaller wait chunks
        if_c    drvnot  B_host_active_led
                cmp     B_cmd_data, #CMD_RESUME   wz
        if_nz   jmp     #B_hwait_resume
                mov     B_htmp, ##_CLOCKFREQ                ' Check to see if the system frequency has changed
                cmp     B_htmp, B_save_sysclk       wz
        if_z    jmp     #.resume
                loc     pb, #@B_hinit_usb_timings - @B_usb_host_start
                add     pb, B_hcog_base_addr
                call    pb                              ' Recalculate sysclk dependent timing values
                testb   B_hstatus, #LOW_SPEEDB    wc
        if_nc   wxpin   B_usb_h_fs_nco_, B_dm              ' Write the new NCO calculation for the current bus speed
        if_c    wxpin   B_usb_h_ls_nco_, B_dm
.resume
                wypin   #OUT_K, B_dm
                waitx   B_resume_hold_                   ' Hold K-state for 20ms to signal device(s) to resume
                wypin   #OUT_SE0, B_dm
                mov     B_htmp, B_ip_delay_ls_
                shr     B_htmp, #1                        ' Delay two LS bit times for K to J (idle) transition
                waitx   B_htmp
                wypin   #OUT_J, B_dm
                shr     B_htmp, #1
                waitx   B_htmp
                wypin   #OUT_IDLE, B_dm
                getct   B_iframe_ct_base
                mov     B_iframe_ct_new, B_iframe_ct_base
                addct1  B_iframe_ct_new, B_frame1ms_clks_
                setint1 #1                              ' Enable the 1ms frame ISR
                mov     B_hctwait, B_4ms_
                call    #B_poll_waitx                     ' Delay until at least three 1ms frames transmitted
        _ret_   mov     B_cmd_data, #ERR_NONE             ' Acknowledge resume cmd complete

'------------------------------------------------------------------------------
' Send preamble to enable low-speed HUB ports
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   USB baud rate set to low-speed
'------------------------------------------------------------------------------
B_utx_pre
                dirl    B_dm                              ' Put smart pins into reset
                dirl    B_dp
                wrpin   #0, B_dm                          ' Disable smartpin mode
                wrpin   #0, B_dp
                drvl    B_dm
                drvh    B_dp

                mov     B_htmp, ##OUT_SOP | (PID_PRE << 8)

                rep     @.l1, #16 + 1
                shr     B_htmp, #1        wc
        if_nc   setq    #1
        if_nc   outnot  B_dm                              ' Bit-bang sync+preamble+idle
                waitx   B_preamble_wait_
.l1

                dirl    B_dm                              ' Put smart pins into reset
                dirl    B_dp
                wrpin   ##USB_V2_DRVOUT, B_dm             ' The same USB smart pin mode for D- and D+ pins
                wrpin   ##USB_V2_DRVOUT, B_dp
                wxpin   B_usb_h_ls_nco_, B_dm              ' Host mode and 1.5Mbs baud
                dirh    B_dm                              ' Crank them smart pins up
                dirh    B_dp
                wypin   #OUT_IDLE, B_dm

                mov     B_max_pkt_size, #8                ' Set LS control read/write DATAx packet size
                mov     B_tat_wait, B_tat_wait_ls_         ' Bus turn-around time in low-speed bit periods
        _ret_   mov     B_ip_delay, B_ip_delay_ls_         ' Inter-packet delay in low-speed bit periods

B_hlut_end
                fit     $400

                orgh
'
' NOTE: Hub execution and data regions moved to kbmpreb.s
'       Common definitions moved to cogkbmc.s
'

#endif
