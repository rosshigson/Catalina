#ifndef __COGKBMA_T2
#define __COGKBMA_T2
{
    USB Keyboard and Gamepad Driver
    Copyright (c) 2022-23 by Marco Maccaferri <macca@maccasoft.com>
    Based on 1CogKbM code by Garry Jordan ("garryj")
    with code portions by Ada Gottensträter

    Usage : see hkbd_compare, hkbd_translate for keyboard
                hid_decode and hpad_translate for controllers

    TERMS OF USE: MIT License
}

{
 NOTE: The original usb.spin2 has been split into 5 files -
 two files for Port A, two files for Port B, and one common file:

 1. cogkbma.t2 contains cog code and data for port A that can be 
    placed AFTER the C sbrk.
 
 2. cogkbmb.t2 contains cog code and data for port B that can be 
    placed AFTER the C sbrk.

 3. kbmprec.t2 contains definitions and hub data common to both 
    ports A & B that must be placed BEFORE the C sbrk

 4. kbmprea.t2 contains hub code and data for port A that 
    must be placed BEFORE the C sbrk. 

 5. kbmpreb.t2 contains hub code and data for port B that 
    must be placed BEFORE the C sbrk. 
}

CON
' USB "portA" connector pin assignments (lower port):

    USB_A_BASE_PIN   = _USB_BASE_PIN + 4
    USB_A_EVENT_REPO = USB_A_BASE_PIN
    A_ACTIVITY_LED   = USB_A_BASE_PIN
    A_ERROR_LED      = USB_A_BASE_PIN

DAT
                orgh
                alignl
                org

DAT             ' USB Host driver
A_usb_host_start
                mov     A_hcog_base_addr, ptrb

                mov     A_htmp, ##@A_hlut_end - 4 - @A_hlut_start ' Dealing with hub addresses
                shr     A_htmp, #2                        ' so byte->long for the lut cell count
                loc     pb, #@A_hlut_start - @A_usb_host_start
                add     pb, A_hcog_base_addr
                setq2   A_htmp
                rdlong  0, pb                           ' Do the hub->lut copy

                loc     pb, #@A_usb_host_init - @A_usb_host_start
                add     pb, A_hcog_base_addr
                jmp     pb                              ' Initialize host and enter main processing loop

'------------------------------------------------------------------------------
' SETUP transaction. The mechanics of SETUP are identical to OUT, but it's
' special because the receiving function must not respond with either STALL or
' NAK, and must accept the DATAx packet that follows the SETUP token. If a
' non-control endpoint receives a SETUP token, or the function receives a
' corrupt packet, it must ignore the transaction
'------------------------------------------------------------------------------
' On entry:
'   PTRA - start address of the SETUP data struct.
' On exit:
'   A_retval - PID_ACK on success, otherwise error code.
'------------------------------------------------------------------------------
txn_setup
                setbyte A_ep_addr_pid, #PID_SETUP, #0
                mov     A_pkt_data, #SETUP_TXN_LEN        ' SETUP is single fixed size DATAx packet
                bitl    A_hstatus, #DATAx_TGLB            ' And always uses DATA0 packet
                mov     A_retry, #TXN_RETRIES             ' Retries possible as function will ignore a corrupt packet
                mov     pa, ptra                        ' Save SETUP struct pointer in case of retry
.setup
                call    #A_txn_out                        ' SETUP/OUT are the same transaction type, just different PIDs
                cmp     A_retval, #PID_ACK        wz
        if_z    ret
                call    #A_retry_wait
                cmp     A_retval, #ERR_TXN_RETRY  wz
        if_z    ret
                mov     ptra, pa                        ' Restore SETUP's DATAx pointer
                jmp     #.setup

'------------------------------------------------------------------------------
' IN/INTERRUPT transaction.
' Possible function response: STALL or NAK handshake, or DATAx packet.
'------------------------------------------------------------------------------
' On entry:
'   A_ep_addr_pid - PID_IN(b0..7), address(b8..b14), endpoint(b15..18) and
'     CRC(b19..23).
' On exit:
'------------------------------------------------------------------------------
A_txn_in
                call    #A_wait_txn_ok                    ' ISR: ensure txn doesn't cross frame boundary
                setbyte A_ep_addr_pid, #PID_IN, #0
                call    #A_utx_token                      ' Put IN request on the bus

                ' Fall through to A_urx_packet

'------------------------------------------------------------------------------
' Wait for a packet from a device/function. As host, the only two packet types
' received are handshakes and IN DATAx.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   A_retval - the ID of the packet. If a PID fails validation, ERR_PACKET is
'     returned.
'------------------------------------------------------------------------------
A_urx_packet
                rqpin   A_urx, A_dm                         ' Wait until start-of-packet signal appears on the USB.
                testb   A_urx, #SOPB              wc
        if_c    jmp     #A_urx_packet
                getct   A_hct2
                addct2  A_hct2, A_tat_wait                  ' Start the response turn-around timer
                bitl    A_hstatus, #EOPB                  ' Make sure sticky EOP flag is clear
                mov     A_newb_flg, #0                    ' Initialize for multi-byte read
.wait_sop
                rdpin   A_urx, A_dm
                testb   A_urx, #SOPB              wc
        if_c    jmp     #.get_pid
                jnct2   #.wait_sop
        _ret_   mov     A_retval, #ERR_TAT
.get_pid
                call    #A_urx_next
                testb   A_urx, #BUS_ERRB          wc
        if_nc   jmp     #.chk_pid
        _ret_   mov     A_retval, #ERR_URX
.chk_pid
                cmp     A_retval, #PID_ACK        wz
        if_nz   cmp     A_retval, #PID_NAK        wz
        if_nz   cmp     A_retval, #PID_STALL      wz
        if_z    jmp     #.chk_eop                       ' Handshake, so check that packet is single byte
                testb   A_hstatus, #DATAx_TGLB    wc      ' Get low/full speed even/odd DATAx sequence to look for
                cmp     A_retval, #PID_DATA0      wz
   if_z_and_nc  jmp     #A_urx_data                       ' DATA0 and sequence match
   if_z_and_c   jmp     #.ack_resend                    ' Sequence error. Ignore data, resend the ACK that the device must have missed
                cmp     A_retval, #PID_DATA1      wz
   if_z_and_c   jmp     #A_urx_data                       ' DATA1 and sequence match
   if_z_and_nc  jmp     #.ack_resend
        _ret_   mov     A_retval, #ERR_PACKET             ' Some other bus error...
.ack_resend
                rqpin   A_urx, A_dm
                testb   A_urx, #EOPB              wc
        if_nc   jmp     #.ack_resend
                mov     A_retval, #PID_ACK
                call    #A_utx_handshake                  ' Send handshake PID and return to caller
        _ret_   mov     A_retval, #ERR_DATAX_SYNC
.chk_eop
                testb   A_hstatus, #LOW_SPEEDB    wc
        if_nc   jmp     #.idle                          ' Full-speed doesn't need an additional read to get EOP status
                call    #A_urx_next                       ' Low-speed requires an additional read to get EOP status
                testb   A_hstatus, #EOPB          wc
        if_c    jmp     #.idle                          ' Low-speed EOP seen
                testb   A_urx, #BUS_ERRB          wz
        if_nc   mov     A_retval, #ERR_PACKET             ' No EOP where one was expected
        if_z    mov     A_retval, #ERR_URX                ' Bit unstuff error, EOP SE0 > 3 bits or SE1, so we're hosed
                ret
.idle
                rqpin   A_urx, A_dm
                testb   A_urx, #J_IDLEB           wc
        if_nc   jmp     #.idle                          ' Wait for bus IDLE before returning handshake result
                ret

'------------------------------------------------------------------------------
' Send a token packet with CRC5 checksum of address and endpoint. It is the
' responsibility of the caller to append the appropriate inter-packet delay,
' if one is required.
'------------------------------------------------------------------------------
' On entry:
'   A_ep_addr_pid - packed with the PID, address and endpoint.
' On exit:
'------------------------------------------------------------------------------
A_utx_token
                rqpin   A_urx, A_dm
                testb   A_urx, #J_IDLEB           wc
        if_nc   jmp     #A_utx_token
                testb   A_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #A_utx_pre
                mov     A_utx, #OUT_SOP
                call    #A_utx_byte                       ' Send sync byte
                mov     A_htmp, A_ep_addr_pid               ' Preserve the PID and destination
                mov     A_pkt_cnt, #3
.next_byte
                getbyte A_utx, A_htmp, #0                   ' Bytes on the bus LSB->MSB
                shr     A_htmp, #8                        ' Shift to next byte to send
.wait
                testp   A_dp                      wc
        if_nc   jmp     #.wait
                akpin   A_dp
                wypin   A_utx, A_dm
        _ret_   djnz    A_pkt_cnt, #.next_byte

'------------------------------------------------------------------------------
' SETUP/OUT/INTERRUPT transaction.
' Possible function response in order of precedence: STALL, ACK, NAK.
'------------------------------------------------------------------------------
' On entry:
'   A_ep_addr_pid - PID_OUT(b0..7), address(b8..b14), endpoint(b15..18) and
'     CRC(b19..23).
'   PTRA - start address of the data buff/struct that has the bytes to send.
'   A_pkt_data - count of DATAx payload bytes to send.
' On exit:
'------------------------------------------------------------------------------
A_txn_out
                call    #A_wait_txn_ok                    ' ISR: ensure txn doesn't cross frame boundary
                call    #A_utx_token                      ' Put SETUP/OUT token on the bus
                rdfast  ##$80000000, ptra               ' Use hub RAM FIFO interface to read the tx buffer
                mov     A_pkt_cnt, A_pkt_data

                ' Fall through to A_utx_data

'------------------------------------------------------------------------------
' Transmit a DATAx packet with USB-16 checksum of payload. The payload CRC is
' calculated while the data byte is being shifted out. Since data stage
' success/fail is not determined until the status stage of the transaction,
' this routine is only concerned about the current DATAx packet.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - hub start address of the data to read.
'   A_pkt_cnt - data payload size.
' On exit:
'------------------------------------------------------------------------------
A_utx_data
                rqpin   A_urx, A_dm
                testb   A_urx, #SOPB              wc
        if_c    jmp     #A_utx_data
                mov     A_hctwait, A_ip_delay
                call    #A_poll_waitx                     ' SETUP/OUT token always precedes tx DATAx so insert IP delay
                testb   A_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #A_utx_pre
                mov     A_utx, #OUT_SOP
                call    #A_utx_byte                       ' Send sync
                bmask   A_crc, #15                        ' Prime the CRC16 pump
                testb   A_hstatus, #DATAx_TGLB    wc      ' Set the requested DATAx PID
        if_nc   mov     A_utx, #PID_DATA0
        if_c    mov     A_utx, #PID_DATA1
                call    #A_utx_byte                       ' No CRC calc done on PID
                cmp     A_pkt_cnt, #0             wz      ' Check if sending a zero length payload
        if_z    jmp     #.send_A_crc                      ' If so, only the CRC goes out
.read_byte
                rfbyte  A_utx                             ' Fetch data byte
                call    #A_utx_byte
                rev     A_utx                             ' Calculate CRC while the data is shifting out
                setq    A_utx                             ' SETQ left-justifies the reflected data byte
                crcnib  A_crc, ##USB16_POLY               ' Run CRC calc on the data nibs
                crcnib  A_crc, ##USB16_POLY
                djnz    A_pkt_cnt, #.read_byte
.send_A_crc
                'bitnot  A_crc,#0 addbits 15               ' Final XOR, and send the calculated CRC16
                bitnot  A_crc,#((0&$1F) | (15&$1f)<<5)               ' Final XOR, and send the calculated CRC16 ' p2asm does not have addbits
                getbyte A_utx, A_crc, #0
                call    #A_utx_byte
                getbyte A_utx, A_crc, #1
                call    #A_utx_byte                       ' Last CRC byte out
                jmp     #A_urx_packet                     ' Handle function response/error and back to caller

'------------------------------------------------------------------------------
' Receive a DATAx_ payload with USB-16 checksum. The CRC is calculated as the
' payload bytes are received. The routine reads bytes until EOP is detected and
' expects that the packet includes at least the CRC word.
'
' In control transfers, it's possible to recieve fewer data bytes than what
' was requested, which makes it difficult to determine where the data stops
' and the CRC word begins. So the CRC calculation is done on every byte of the
' packet, including the CRC word. The CRC value should then be equal to the
' USB-16 expected residual value of 0xB001.
'
' The routine writes the IN packet data to a static max_packet_size buffer
' so the caller can verify IN success before writing the data to its final
' destination.
'------------------------------------------------------------------------------
' On entry:
'   A_pkt_data - max byte count expected to be in the packet.
'   A_newb_flg - signals new byte ready when toggled.
' On exit:
'   A_pkt_cnt - actual number of bytes read.
'------------------------------------------------------------------------------
A_urx_data
                mov     A_htmp2, pb
                mov     pb, A_urx_buff_p
                wrfast  ##$80000000, pb                 ' Use hub RAM FIFO interface to buffer bytes received
                mov     pb, A_htmp2
                bmask   A_crc, #15                        ' Prime the CRC16 pump
                mov     A_pkt_cnt, #0                     ' Keep track of payload bytes received
                mov     A_pkt_tmp, A_pkt_data
                add     A_pkt_tmp, #2                     ' Tweak payload byte count to include CRC word
.wait_byte
' In-line rx for max speed
                rqpin   A_urx, A_dm
                mov     A_utx, #BYTE_TGLF                 ' Reg utx free in this context
                and     A_utx, A_urx
                cmp     A_newb_flg, A_utx           wz      ' Fetch a byte whenever the flags differ
        if_nz   xor     A_newb_flg, #BYTE_TGLF            ' Synchronize flags
        if_nz   jmp     #.get_byte                      ' New byte!
                testb   A_urx, #EOPB              wc
        if_c    jmp     #.chk_A_crc                       ' At end-of-packet
                jmp     #.wait_byte
.get_byte
                getbyte A_retval, A_urx, #1                 ' New byte from smart pins
                wfbyte  A_retval                          ' Add it to the data buffer
                rev     A_retval                          ' Calculate CRC while next byte is shifting in
                setq    A_retval                          ' SETQ left-justifies the reflected data byte
                crcnib  A_crc, ##USB16_POLY               ' Run CRC calc on the data nibs
                crcnib  A_crc, ##USB16_POLY
.end_A_crc
                add     A_pkt_cnt, #1
                cmp     A_pkt_cnt, A_pkt_tmp        wcz
        if_a    mov     A_retval, #ERR_PACKET             ' Error if payload > expected size
        if_a    ret
' For full-speed at 80MHz, the time it takes to do the final byte write and
' CRC verify has likely put us into the EOP zone. The P2 smart pins keep the
' EOP flag "sticky" for 7-bits of J, but at 80MHz, it still could be possible
' to miss it, so cheat a bit and look for SOP clear here.
                rqpin   A_urx, A_dm
                testb   A_urx, #EOPB              wc      ' FIXME: checking for EOP set should work when > 80MHz
        if_nc   jmp     #.wait_byte                     ' Next read will catch EOP at low-speed
' CRC OK = Payload CRC calc ^ packet's CRC bytes = $B001 (the USB-16 expected residual)
.chk_A_crc
                sub     A_pkt_cnt, #2                     ' Adjust payload count to exclude the CRC bytes read
                xor     A_crc, ##USB16_RESIDUAL   wz      ' CRC of (data + transmitted CRC) XOR residual should equal zero
        if_nz   jmp     #A_urx_packet                     ' CRC fail; discard data and wait until data re-sent or transfer timeout
                mov     A_retval, #PID_ACK
                mov     A_hctwait, A_ip_delay
                call    #A_poll_waitx

                ' Fall through to A_utx_handshake

'------------------------------------------------------------------------------
' Transmit a handshake PID. The routine assumes that the bus is IDLE and
' the appropriate IP delay has been inserted.
'------------------------------------------------------------------------------
' On entry:
'   A_retval - handshake PID to send.
' On exit:
'   A_retval unchanged.
'------------------------------------------------------------------------------
A_utx_handshake
                testb   A_hstatus, #DWNSTRM_HUBB  wc
        if_c    call    #A_utx_pre
                mov     A_utx, #OUT_SOP
                call    #A_utx_byte                       ' Send sync
                mov     A_utx, A_retval
                call    #A_utx_byte                       ' Send handshake PID
.idle
                rqpin   A_urx, A_dm
                testb   A_urx, #J_IDLEB           wc
        if_nc   jmp     #.idle                          ' Wait for IDLE to ensure the PID tx is complete
                mov     A_hctwait, A_tat_wait               ' Ensure one turn-around time before next transaction
                jmp     #A_poll_waitx

'------------------------------------------------------------------------------
' Wait for the USB tx buffer to empty and feed it a new byte.
'------------------------------------------------------------------------------
' On entry:
'   A_utx - byte to transmit.
' On exit:
'------------------------------------------------------------------------------
A_utx_byte
                testp   A_dp                      wc
        if_nc   jmp     #A_utx_byte
                akpin   A_dp
                waitx   A_utx_tweak       ' Wait #0 '#3 if < 180MHz, wait #3 '#20 if 180MHz+
        _ret_   wypin   A_utx, A_dm

'------------------------------------------------------------------------------
' Fetch the next data byte of a packet. Always check receiver status for EOP.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   A_retval - the byte read.
'   A_urx - the receiver status. The caller must check the A_hstatus reg EOP flag
'     on return. If EOP is set, the byte in reg A_retval remains as the last byte
'     received.
'------------------------------------------------------------------------------
A_urx_next
                rdpin   A_urx, A_dm
                mov     A_utx, #BYTE_TGLF                 ' Reg utx free in this context
                and     A_utx, A_urx
                cmp     A_newb_flg, A_utx           wz      ' Fetch a byte whenever the flags differ
        if_nz   xor     A_newb_flg, #BYTE_TGLF            ' Synchronize flags
        if_nz   getbyte A_retval, A_urx, #1                 ' Fetch the new byte
        if_nz   ret                                     ' New byte is priority, so return now
                testb   A_urx, #SOPB              wc
                testb   A_urx, #BUS_ERRB          wz
   if_c_and_nz  jmp     #A_urx_next                       ' If SOP still raised and !BUS_ERRB a new byte should be coming
        if_nc   bith    A_hstatus, #EOPB                  ' If EOP make it sticky, otherwise it's a bus error
                ret

'------------------------------------------------------------------------------
' Calculate USB-5 CRC. The upper word of the CRC pre-calc table in LUT contains
' the data used for the USB-5 CRC lookups. The token packet is three bytes in
' length, and the PID is not included in the CRC calculation:
'  CRC5  FRAME_NUMBER SOF (full-speed)
'  CRC5  ENDP ADDRESS PID
' %00000_1111_1111111_xxxxxxxx
'------------------------------------------------------------------------------
' On entry:
'   A_ep_addr_pid - stuffed with the function endpoint, address and
'     SETUP/IN/OUT/SOF PID according to the USB standard.
' On exit:
'   A_ep_addr_pid - CRC value appended to the packet.
'------------------------------------------------------------------------------
A_calc_crc5
                and     A_ep_addr_pid, ##EP_ADDR_MASK     ' Clear existing CRC, if any
                mov     A_htmp, A_ep_addr_pid
                shr     A_htmp, #8                        ' PID not included in CRC calc
                mov     A_crc, #$1f                       ' Initial CRC5 value
                rev     A_htmp                            ' Input data reflected
                setq    A_htmp                            ' CRCNIB setup for data bits 0..7
                crcnib  A_crc, #USB5_POLY
                crcnib  A_crc, #USB5_POLY                 ' Data bits 0..7 calculated
                shl     A_htmp, #9                wc      ' Shift out processed bits + 1 to set up CRC of remaining bits 8..10
                crcbit  A_crc, #USB5_POLY                 ' Inline instead of REP as we're in hubexec
                shl     A_htmp, #1                wc
                crcbit  A_crc, #USB5_POLY
                shl     A_htmp, #1                wc
                crcbit  A_crc, #USB5_POLY
                xor     A_crc, #$1f                       ' Final XOR value
                shl     A_crc, #8 + 11                    ' CRC to bits 23..19 of the token packet
        _ret_   or      A_ep_addr_pid, A_crc                ' Put the CRC in its new home

'------------------------------------------------------------------------------
' Full-speed/low-speed frame timing interrupt service routine.
'------------------------------------------------------------------------------
A_isr1_fsframe
                getct   A_iframe_ct_base
                mov     A_iframe_ct_new, A_iframe_ct_base
                addct1  A_iframe_ct_new, A_frame1ms_clks_
                wxpin   A_usb_h_fs_nco_, A_dm              ' Restore host mode and 12Mbs baud
.wait
                testp   A_dp                      wc
        if_nc   jmp     #.wait
                akpin   A_dp
                mov     A_utx, #PID_SOF
                wypin   #OUT_SOP, A_dm                    ' Put start-of-packet SYNC field on the USB
                call    #A_utx_byte                       ' Send token PID byte
                mov     A_icrc, #$1f                      ' Prime the CRC5 pump
                mov     A_sof_pkt, A_frame                  ' CRC5 calculation done on the 11-bit frame number value
                rev     A_sof_pkt                         ' Input data reflected
                setq    A_sof_pkt                         ' CRCNIB setup for data bits 0..7
                crcnib  A_icrc, #USB5_POLY
                crcnib  A_icrc, #USB5_POLY                ' Data bits 0..7 calculated
                getbyte A_utx, A_frame, #0                  ' Send the low byte of the frame number
                call    #A_utx_byte
                shl     A_sof_pkt, #8                     ' Shift out processed bits to set up CRCBIT * 3
                rep     #2, #3                          ' Three data bits left to process
                shl     A_sof_pkt, #1             wc
                crcbit  A_icrc, #USB5_POLY                ' Data bits 8..10 calculated
                xor     A_icrc, #$1f                      ' Final XOR value
                getbyte A_utx, A_frame, #1                  ' Send remaining frame number bits
                shl     A_icrc, #3                        ' Merge CRC to bits 7..3 of the final token byte
                or      A_utx, A_icrc
                call    #A_utx_byte                       ' Last start-of-frame byte is on the wire
                mov     A_isrtmp1, A_ip_delay_fs_          ' Use normal inter-packet delay when full-speed
                jmp     #A_isr1_wait
isr1_lsA_frame
                getct   A_iframe_ct_base
                mov     A_iframe_ct_new, A_iframe_ct_base
                addct1  A_iframe_ct_new, A_frame1ms_clks_
.wait
                testp   A_dp                      wc
        if_nc   jmp     #.wait
                akpin   A_dp
                wypin   #OUT_EOP, A_dm                    ' EOP is the low-speed keep-alive strobe
                mov     A_isrtmp1, A_ip_delay_ls_          ' Normal inter-packet delay works when low-speed
A_isr1_wait
                rqpin   A_utx, A_dm
                testb   A_utx, #SOPB                 wc
        if_c    jmp     #A_isr1_wait
                add     A_frame, #1                       ' Next frame# and check for wrap around
                zerox   A_frame, #10
                waitx   A_isrtmp1                         ' Make sure bus is idle
                reti1

'------------------------------------------------------------------------------
' Wait for a window within the 1ms frame boundary that will ensure that a
' transaction will complete before the next frame is triggered.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
A_wait_txn_ok
                getct   A_htmp2
                sub     A_htmp2, A_iframe_ct_base
                testb   A_hstatus, #LOW_SPEEDB    wc
        if_c    cmp     A_htmp2, A_txn_ok_ls_      wcz
        if_nc   cmp     A_htmp2, A_txn_ok_fs_      wcz
        if_a    jmp     #A_wait_txn_ok                    ' Not enough time, so wait until next frame
                ret

'------------------------------------------------------------------------------
' A device connection was detected, or a bus reset was requested by the USB
' client. Set the appropriate smart pin FS/LS speed mode to match the device
' and perform a reset sequence prior to device enumeration.
'------------------------------------------------------------------------------
A_dev_reset
                rqpin   A_urx, A_dm
                testb   A_urx, #K_RESUMEB         wc      ' K differential "1" in FS mode signals low-speed
        if_c    call    #A_set_speed_low                  ' The speed config subroutines must restore the caller C flag
        if_nc   call    #A_set_speed_full                 ' state on return if it writes the C flag.
A_reset
                setint1 #0                              ' Don't want frame interrupt while in reset
                wypin   #OUT_SE0, A_dm                    ' Assert bus reset
                waitx   A_reset_hold_                    ' Spec is >= 10ms
                wypin   #OUT_IDLE, A_dm
                mov     A_frame, #0                       ' Reset the frame timespan count
                getct   A_iframe_ct_base
                mov     A_iframe_ct_new, A_iframe_ct_base
                addct1  A_iframe_ct_new, A_frame1ms_clks_
                mov     A_htmp, A_frame                     ' Allow reset recovery time (Section 9.2.6.2)
                add     A_htmp, #36
                setint1 #1                              ' Set ISR event trigger to CT-passed-CT1
.A_framewait
                cmp     A_frame, A_htmp             wcz
        if_b    jmp     #.A_framewait
                ret

'------------------------------------------------------------------------------
' Bulk hub<->hub byte copy. Does not check for src/dest buffer overlap.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - source address.
'   PB - destination address.
'   A_hr0 - length of copy, in bytes.
' On exit:
'------------------------------------------------------------------------------
A_hmemcpy
                rdbyte  A_htmp, ptra++
                wrbyte  A_htmp, pb
                add     pb, #1
        _ret_   djnz    A_hr0, #A_hmemcpy

'------------------------------------------------------------------------------
' A fatal USB error has occured. Notify the client and spin in a pseudo-idle
' loop until the errant device is disconnected.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
A_host_error
                loc     ptra, #@A_usb_error_code
                wrlong  A_retval, ptra                    ' Post the USB operation result value
                wxpin   #USB_ERROR, A_usb_event_pin       ' Signal the client an error has occurred
                drvl    A_host_error_led
                jmp     #host_A_reset                     ' See if it works...

' USB commands and error codes
A_cmd_data        long    0
A_usb_err_code    long    ERR_NONE

' Parameters block assigned at cog startup
A_dm              long    USB_A_BASE_PIN + 2    ' Client defines the basepin for four consecutive USB port pins
A_dp              long    USB_A_BASE_PIN + 3
A_usb_event_pin   long    USB_A_EVENT_REPO      ' Host event reporting uses a long repository smart pin
A_host_active_led long    A_ACTIVITY_LED        ' Client defines the LED pin# for host bus activity
A_host_error_led  long    A_ERROR_LED           ' Client defines the LED pin# to light on error
A_hid_descr_p     long    0, 0[7]
A_hid_report_p    long    0, 0[7]
A_hub_descr_p     long    0
A_urx_buff_p      long    0
A_dev_desc_buff_p long    0
A_con_desc_buff_p long    0
A_cache_start_p   long    0
A_cache_end_p     long    0

A_hdev_init_start
A_hdev_port       long    0
A_hdev_next_datax long    0, 0
A_hub_intf_num    long    0
A_hub_next_datax  long    0
A_hub_status_chg  long    0
A_hub_port_status long    0
A_ms_intf_num     long    0
A_ms_in_max_pkt   long    0
A_kb_intf_num     long    0
A_kb_interval     long    0
A_kb_in_max_pkt   long    0
A_kb_max_index    long    0
A_kb_led_states   long    0
A_kbm_next_datax  long    0
A_gp_intf_num     long    0
A_gp_interval     long    0
A_gp_max_index    long    0
A_gp_descr_len    long    0, 0[7]
A_hdev_init_end

A_hidr_start
A_hidr_id         long    0
A_hidr_axis       long    0[3]
A_hidr_buttons    long    0
A_hidr_hats       long    0
A_hidr_flags      long    0
A_hidr_state      long    0
A_hidr_size       long    0
A_hidr_count      long    0
A_hidr_offset     long    0
A_hidr_usage      long    0
A_hidr_usage_idx  long    0
A_hidr_lminmax    long    0
A_hidr_pminmax    long    0
A_hidr_end

' Initialized at cog startup:
A_save_sysclk     long    0         ' Save the current sysclock as the client may change it
A_hcog_base_addr  long    0         ' This object's start address in hub, read from PTRB at cog creation
A_iframe_ct_new   long    0
A_iframe_ct_base  long    0
A_p2rev_val       long    P2RevB
A_utx_tweak       long    0         ' Sysclock speeds above ~120MHz need some fairy dust for USB tx
' This register block is reset to zero when a USB device connects
A_hreg_init_start
A_hstatus         long    0         ' Host status flags
A_hctwait         long    0         ' Poll-based wait clocks
A_ip_delay        long    0         ' Inter-packet delay in bit periods for connected device speed
A_tat_wait        long    0         ' Maximum bus turn-around time in bit periods for connected device speed
A_nak_retry       long    0         ' NAK retry count, unlimited retries if zero
A_xfer_retry      long    0         ' Control transfer retry count
A_retry           long    0         ' Transaction retry count
A_utx             long    0         ' Byte to transmit on USB
A_urx             long    0         ' LSByte receiver status flags, MSByte received data
A_newb_flg        long    0         ' Receive "new byte" bit toggle detector
A_max_pkt_size    long    0         ' Maximum payload bytes allowed, likely to change on device connect.
A_total_data      long    0         ' Total bytes to tx/rx in a transfer data stage
A_stage_data      long    0         ' Count of bytes sent/received so far during a data stage.
A_pkt_data        long    0         ' Payload size of an OUT packet or bytes received on IN
A_frame           long    0         ' USB 1ms frame counter value
A_sof_pkt         long    0         ' ISR frame# packet and CRC5
A_icrc            long    0         ' Only used by the 1ms frame output ISR routine
A_pkt_cnt         long    0         ' Count of DATAx packet payload bytes
A_crc             long    0         ' Used for CRC16 calculation
A_ep_addr_pid     long    0         ' Endpoint and device addresses for connected device
A_retval          long    0         ' Global success/fail return parameter
A_context_retval  long    0         ' Operation contextual return parameter
' Device stuff
A_hdev_id         long    0
A_hdev_bcd        long    0
A_hdev_type       long    0
A_hdev_type2      long    0      ' Configured device indicator
' Keyboard/mouse stuff
A_hctrl_ep_addr   long    0
A_hctrl_max_pkt   long    0
A_hconfig_base    long    0
A_hcon_tot_len    long    0         ' Size of the complete config descriptor chain
A_hdev_intf_idx   long    0         ' Used during verbose descriptor terminal output
A_hdev_class      long    0
A_hdev_subclass   long    0
A_hdev_protocol   long    0
A_hsearch_key     long    0         ' Descriptor type to search for in the config chain
A_hnext_desc      long    0         ' Offset from the config descriptor start address to the next descriptor in the chain
A_hhub_ctrl_ep    long    0         ' Hub control endpoint address
A_hhub_ep_addr    long    0         ' Hub interface endpoint address
A_hmouse_ep_addr  long    0         ' Mouse interface endpoint address
A_hkbd_ctrl_ep    long    0         ' Keyboard control endpoint address
A_hkbd_ep_addr    long    0         ' Keyboard interface endpoint address
A_hkbd_poll_cnt   long    0         ' Poll interval counter used for key auto-repeat
A_hkbd_rpt_key    long    0         ' Key to repeat (0 disables repeat)
A_hkbd_ledstates  long    0         ' Off/on state of keyboard LEDs
A_hdev_ep_addr    long    0, 0[7]
A_hdev_out_addr   long    0
A_hreg_init_end
' Variables dependent on the system freqency
A_var_64_lower_  long    0
A_var_64_upper_  long    0
A_12Mbps_        long    0
A_1_5Mbps_       long    0
A_1ns16fp_       long    0         ' 1ns as 32,16 fixed point
A_1us_           long    0         ' 1us
A_10us_          long    0         ' 10us
A_33us_          long    0         ' 33us
A_txn_err_       long    0         ' 250us
A_500us_         long    0         ' 500us
A_txn_ok_ls_     long    0         ' 666us timespan for LS transaction OK window
A_txn_ok_fs_     long    0         ' 850us timespan for FS transaction OK window
A_ip_delay_ls_   long    0         ' Low-Speed inter-packet 4 bit-time delay
A_ip_delay_fs_   long    0         ' Full-Speed inter-packet 4 bit-time delay
A_tat_wait_ls_   long    0         ' Low-Speed turnaround 22 bit-time wait
A_tat_wait_fs_   long    0         ' Full-Speed turnaround 28 bit-time wait
A_preamble_wait_ long    0
A_1ms_           long    0         ' 1ms
A_2ms_           long    0         ' 2ms
A_suspend_wait_  long    0         ' 3ms
A_4ms_           long    0         ' 4ms
A_xfer_wait_     long    0         ' 5ms
A_8ms_           long    0         ' 8ms timespan for keyboard/mouse interrupt IN transactions
A_reset_hold_    long    0         ' 15ms
A_resume_hold_   long    0         ' Hold K-state for 20ms to signal device(s) to resume
A_21ms_          long    0         ' 21ms
A_100ms_         long    0         ' 100ms
A_500ms_         long    0         ' 500ms
A_pulse_time_    long    0         ' Activity LED toggle interval, one sec connect wait, 500ms_ when connected
A_frame1ms_clks_ long    0         '_1ms +/- n clocks: calculated based on the current sysclock
'------------------------------------------------------------------------------
A_usb_h_ls_nco_  long    0         ' USB smart pin modes dependent on sysclock
A_usb_d_ls_nco_  long    0
A_usb_h_fs_nco_  long    0
A_usb_d_fs_nco_  long    0
'------------------------------------------------------------------------------
' Scratch registers
A_htmp            long    0         ' Scratch registers whose context remains within the same code block
A_htmp1           long    0
A_htmp2           long    0
A_htmp3           long    0
A_hrep            long    0         ' Repeat count
A_hsave0          long    0         ' Subroutine parameter saves
A_hsave1          long    0
A_hsave2          long    0
A_isrtmp1         long    0
A_pkt_tmp         long    0         ' Tmp storage for routines that deal with datax packets
A_hr0             long    0         ' Multi-purpose registers
A_hr1             long    0
A_hr2             long    0
A_hr3             long    0
A_hpar1           long    0         ' Routine entry/exit parameters
A_hpar2           long    0
A_hpar3           long    0
A_hct2            long    0         ' Function response bus turn-around timer
A_hct3            long    0         ' Keyboard/mouse poll timer
A_mod_cnt         long    0         ' Used in idle loops
A_last_mouse_data long    0

A_gpad_last_x     long    0[2]      ' max 4 gamepads, one word each
A_gpad_last_y     long    0[2]      ' max 4 gamepads, one word each
A_gpad_last_b     long    0[2]      ' max 4 gamepads, one word each
                fit     $1F0

DAT             ' USB Host LUT execution
                orgf     $200 ' WAS 'org' IN ORIGINAL
A_hlut_start

'------------------------------------------------------------------------------
' Full-speed is the host's native speed, so all that is needed is to set the FS
' settings to startup defaults.
'------------------------------------------------------------------------------
' On entry:
' On exit: Save/restore caller C flag state if C is changed in this routine!
'------------------------------------------------------------------------------
A_set_speed_full
                mov     ijmp1, #A_isr1_fsframe            ' Set the USB 1ms frame handler ISR routine
                mov     A_max_pkt_size, #64               ' Set FS control read/write DATAx packet size
                mov     A_tat_wait, A_tat_wait_fs_         ' Bus turn-around time in full-speed bit periods
        _ret_   mov     A_ip_delay, A_ip_delay_fs_         ' Inter-packet delay in full-speed bit periods
'                ret                             wcz     ' Restore caller flags on exit

'------------------------------------------------------------------------------
' When a low-speed device connects, the D-/D+ signaling is inverted. If there
' is a downstream hub connected (not yet implemented), the baud generator
' remains set at the full-speed rate, but signaling is switched to low-speed,
' which reverses the D-/D+ polarity. The polarity can be changed without
' putting the smart pins into reset.
'------------------------------------------------------------------------------
' On entry:
' On exit: CZ flags restored to caller states
'------------------------------------------------------------------------------
A_set_speed_low
                test    A_hstatus, #DWNSTRM_HUBF  wz      ' If no downstream hub connected, set low-speed baud
        if_z    mov     ijmp1, #isr1_lsA_frame            ' Set the USB 1ms frame handler ISR routine
                testb   A_p2rev_val, #0           wc      ' P2 Revision is either %0001 (A) or %0010 (B+)
        if_c    dirl    A_dm                              ' P2RevA needs to be completely reconfigured
        if_c    dirl    A_dp
        if_c    wrpin   ##USB_V1HMODE_LS, A_dm            ' Low-speed signaling is always used
        if_c    wrpin   ##USB_V1HMODE_LS, A_dp
        if_c    wxpin   A_1_5Mbps_, A_dm                   ' Set 1.5Mbs baud if no downstream hub
        if_c    dirh    A_dm
        if_c    dirh    A_dp
        if_nc   wxpin   A_usb_h_ls_nco_, A_dm              ' Host mode and 1.5Mbs baud if no downstream hub
                mov     A_max_pkt_size, #8                ' Set LS control read/write DATAx packet size
                mov     A_tat_wait, A_tat_wait_ls_         ' Bus turn-around time in low-speed bit periods
                mov     A_ip_delay, A_ip_delay_ls_         ' Inter-packet delay in low-speed bit periods
                bith    A_hstatus, #LOW_SPEEDB            ' D- pulled high, so it's a Low-Speed device
                ret                             wcz     ' Restore caller flags on exit

'------------------------------------------------------------------------------
' Perform configuration stuff required when a device intitially connects.
'------------------------------------------------------------------------------
' On entry:
' On exit:
'------------------------------------------------------------------------------
A_on_connect
                mov     A_hr0, #2                         ' FIXME: need to determine a reasonable limit for reset & retry
                call    #A_dev_reset                      ' Reset device prior to Get Device Descriptor request
.A_retry
                testb   A_hstatus, #LOW_SPEEDB    wc
        if_c    mov     A_hpar1, #USB_SPEED_LOW           ' Also the connect speed
        if_nc   mov     A_hpar1, #USB_SPEED_FULL
                mov     A_ep_addr_pid, ##EP_ADDR_ZERO     ' New connect, use pre-calc CRC for ep/addr zero
                loc     ptra, #@A_get_dev_desc - @A_usb_host_start ' Hub start address of GetDeviceDescriptor SETUP struct
                add     ptra, A_hcog_base_addr
                wrword  #8, ptra[wLength]               ' Request IN data stage max of 8 bytes will test actual < requested logic
                mov     pb, A_dev_desc_buff_p             ' Start address of DeviceDescriptor struct for IN data
                call    #A_control_read                   ' Execute GetDeviceDescriptor()
                cmp     A_retval, #PID_ACK        wz
        if_z    jmp     #.A_get_dev_desc
                mov     A_hctwait, A_500ms_                ' If the first GetDescriptor() fails, reset and try again
                call    #A_poll_waitx
                sub     A_hr0, #1         wz              ' FIXME: need to determine a reasonable limit for reset & retry
        if_z    jmp     #A_host_error                     ' Post error and spin until the errant device is disconnected
                call    #A_reset                          ' Try another reset to see if the device responds
                jmp     #.A_retry
.A_get_dev_desc
                mov     pa, A_dev_desc_buff_p             ' Fetch the max packet size for control transactions from the
                add     pa, #DEV_bMaxPktSize0           ' appropriate Device Descriptor struct member offset
                rdbyte  A_max_pkt_size, pa
                mov     A_hctwait, A_1ms_
                call    #A_poll_waitx                     ' Do a reset before SetAddress(), but wait a bit first
                call    #A_reset
                loc     ptra, #@A_set_address - @A_usb_host_start ' Hub start address of SetAddress SETUP struct
                add     ptra, A_hcog_base_addr
                wrword  #8, ptra[wValue]                ' Only support one device port at this time
                call    #A_control_write                  ' Execute SetAddress()
                cmp     A_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to idle if not ACK
                mov     A_hctwait, A_8ms_
                call    #A_poll_waitx                     ' Allow SetAddress() a minimum 2ms recovery interval
                mov     A_ep_addr_pid, ##8 << 8           ' Device ep/addr now #8 and endpoint zero
                call    #A_calc_crc5
                loc     ptra, #@A_get_dev_desc - @A_usb_host_start ' Repeat SETUP for GetDeviceDescriptor()
                add     ptra, A_hcog_base_addr
                mov     pb, A_dev_desc_buff_p             ' Start address of DeviceDescriptor struct has exact descriptor length
                rdbyte  A_total_data, pb
                wrword  A_total_data, ptra[wLength]       ' Assign it to the SETUP wLength struct member
                call    #A_control_read                   ' Execute GetDeviceDescriptor() again, but with updated data length
                cmp     A_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to idle if not ACK
                mov     A_hctrl_ep_addr, A_ep_addr_pid      ' Make the device control address and endpoint official
                mov     ptra, A_dev_desc_buff_p           ' Do the same with the control max packet size
                rdbyte  A_hctrl_max_pkt, ptra[DEV_bMaxPktSize0]
                mov     A_hctwait, A_500us_
                call    #A_poll_waitx
                loc     ptra, #@A_get_config_desc - @A_usb_host_start ' Hub start address of GetConfigurationDescriptor SETUP struct
                add     ptra, A_hcog_base_addr
                wrword  #$FF, ptra[wLength]             ' Maximum DATAx bytes for receive to the SETUP struct
                mov     pb, A_con_desc_buff_p             ' Hub start address of ConfigurationDescriptor structure
                call    #A_control_read                   ' Execute GetConfigurationDescriptor()
                cmp     A_retval, #PID_ACK        wz
        if_nz   ret
                mov     ptra, A_con_desc_buff_p           ' Check the config descriptor struct for expected data
                mov     A_hconfig_base, ptra              ' Will need this for configuration
                rdbyte  A_hr0, ptra++                     ' Config.bLength is at offset zero, expect >= CON_DESC_LEN
                rdbyte  A_hr1, ptra++                     ' Config.bDescType is next member, expect = TYPE_CONFIG constant
                rdword  A_htmp, ptra                      ' Config.wTotalLen is next member, expect >= bytes actually received
                cmp     A_hr0, #CON_DESC_LEN      wcz
        if_ae   cmp     A_hr1, #TYPE_CONFIG       wcz
        if_z    cmp     A_htmp, A_total_data        wcz
        if_b    mov     A_retval, #ERR_CONFIG_FAIL
        if_b    jmp     #A_host_error
                loc     pa, #@A_init_kbdm_data - @A_usb_host_start
                add     pa, A_hcog_base_addr
                call    pa
                loc     pa, #@A_hparse_con_desc - @A_usb_host_start
                add     pa, A_hcog_base_addr
                jmp     pa

'------------------------------------------------------------------------------
' Perform a control read transaction (Section 8.5.3, Figure 8-37).
' Status reporting is always in the function-to-host direction.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - start address of the SETUP data in hub.
'   PB - start address of the buffer/struct to be written to during the IN data
'     stage.
'   A_ep_addr_pid - device address, endpoint and CRC5.
' On exit:
'   A_retval - PID_ACK on success, otherwise error. If successful, reg A_total_data
'     contains the count of data stage bytes actually received, which must
'     always be <= the count requested.
'   A_context_retval - ERR_NONE if the overall transfer succeeds, otherwise a
'     more specific USB operation error code.
'------------------------------------------------------------------------------
A_control_read
                mov     A_hpar1, A_ep_addr_pid
                mov     A_hpar2, ptra
                mov     A_hpar3, pb                       ' Save dest buffer pointer
                mov     A_xfer_retry, #XFER_RETRIES
.xfer_start
                rdword  A_total_data, ptra[wLength]       ' Get the size of the data stage from the SETUP struct
                call    #txn_setup                      ' SETUP logic is the same for both control reads and writes
                cmp     A_retval, #PID_ACK        wz
        if_nz   ret                                     ' Back to caller to handle error
                cmp     A_total_data, #0          wz
        if_z    jmp     #A_pre_status_in                  ' No data, so directly to status stage
                mov     A_stage_data, #0                  ' Prepare for data stage
                mov     A_nak_retry, ##IN_NAK_RETRIES
                bith    A_hstatus, #DATAx_TGLB            ' Data stage starts with DATA1 PID
.data
                mov     A_pkt_data, A_total_data
                sub     A_pkt_data, A_stage_data
                cmp     A_pkt_data, A_max_pkt_size  wcz
        if_a    mov     A_pkt_data, A_max_pkt_size          ' Have a full packet with more data left
.A_nak_retry
                mov     A_retry, #TXN_RETRIES             ' Reset bus error retry limit
.in_A_retry
                call    #A_txn_in
                cmp     A_retval, #PID_ACK        wz      ' Commit on ACK
        if_z    jmp     #.commit
                cmp     A_retval, #PID_STALL      wz
        if_z    jmp     #.A_xfer_retry                    ' STALL triggers a transfer retry
                call    #A_retry_wait                     ' Wait a bit before retry
                cmp     A_retval, #PID_NAK        wz
        if_z    jmp     #.A_nak_retry                     ' Function not ready to send data
                cmp     A_retval, #ERR_NAK        wz
        if_z    jmp     #.A_xfer_retry                    ' NAK limit exceeded triggers a transfer retry
                cmp     A_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.in_A_retry                      ' Bus error retry
                ret                                     ' The transfer has failed
.commit
                cmp     A_pkt_cnt, #0             wz      ' Empty pkt means previous pkt was max_pkt_len
        if_z    jmp     #.pre_status                    ' and also end-of-data
                mov     ptra, A_urx_buff_p                ' Copy DATAx in rx buffer to dest struct
                mov     A_hr0, A_pkt_cnt
                cmp     ptra, pb                wz
        if_nz   call    #A_hmemcpy                        ' hmemcpy(PTRA, PB, A_hr0)
                add     A_stage_data, A_pkt_cnt             ' Update bytes received on commit
                cmp     A_stage_data, A_total_data  wz      ' Have all asked-for bytes?
        if_z    jmp     #.pre_status                    ' Have all the data that's coming, so done
                cmp     A_pkt_cnt, A_pkt_data       wcz     ' Check for short packet
        if_b    jmp     #.pre_status                    ' Actual payload < expected means end of data stage
        if_a    mov     A_retval, #ERR_PACKET
        if_a    mov     A_context_retval, A_retval          ' In this case overall and context are the same
        if_a    ret                                     ' Caller must handle ERR_PACKET
                bitnot  A_hstatus, #DATAx_TGLB            ' Toggle DATAx sync bit
                jmp     #.data                          ' Start next IN transaction
.pre_status
                mov     A_total_data, A_stage_data          ' Replace the asked-for byte count with the bytes actually received
                setbyte A_ep_addr_pid, #PID_OUT, #0
                mov     A_pkt_data, #0
                bith    A_hstatus, #DATAx_TGLB            ' Status stage starts with DATA1 PID
                mov     A_retry, #TXN_RETRIES             ' Reset txn retry limit
                mov     A_nak_retry, ##OUT_NAK_RETRIES
.A_out_retry
                call    #A_txn_out                        ' Send empty OUT DATAx packet to confirm IN data received OK
                cmp     A_retval, #PID_ACK        wz
        if_z    ret                                     ' All is good when ACK
                cmp     A_retval, #PID_STALL      wz
        if_z    jmp     #.A_xfer_retry                    ' STALL triggers a transfer retry
                call    #A_retry_wait                     ' Wait a bit before retry
                cmp     A_retval, #ERR_NAK        wz
        if_z    jmp     #.A_xfer_retry                    ' NAK limit exceeded triggers a transfer retry
                cmp     A_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.A_out_retry                     ' Retry due to bus error or OUT-NAK retry limit not reached
                ret                                     ' Caller must handle transfer retirement
' I've encountered transfer STALL, even though the data looks correct, and
' instances of getting stuck in an endless OUT-NAK loop. Repeating the entire
' ControlRead() transfer gets things unstuck most of the time...
.A_xfer_retry
                mov     A_hctwait, A_xfer_wait_
                call    #A_poll_waitx
                call    #A_wait_txn_ok
                mov     A_ep_addr_pid, A_hpar1
                mov     ptra, A_hpar2
                mov     pb, A_hpar3
                djnz    A_xfer_retry, #.xfer_start
                mov     A_context_retval, A_retval          ' Preserve the USB error code
        _ret_   mov     A_retval, #ERR_XFER_RETRY

'------------------------------------------------------------------------------
' Perform a control write transaction (Section 8.5.3, Figure 8-37). Status
' reporting is always in the function-to-host direction. It is assumed that
' the SETUP data struct is filled with the required values.
'------------------------------------------------------------------------------
' On entry:
'   PTRA - points to the start of the struct for the SETUP data.
'   PB - the start address of the struct/buffer to be read for the OUT data
'     stage.
'   A_ep_addr_pid - the proper CRC'd address and endpoint to use.
' On exit:
'   A_retval - used to convey the success/failure of each stage.
'   A_context_retval - ERR_NONE if the overall transfer succeeds, otherwise a
'     more specific USB operation error code.
'------------------------------------------------------------------------------
A_control_write
                testb   A_ep_addr_pid, #31        wc
        if_c    bith    A_hstatus, #DWNSTRM_HUBB
        if_c    bith    A_usb_h_ls_nco_, #14

                mov     A_hpar1, A_ep_addr_pid
                mov     A_hpar2, ptra
                mov     A_hpar3, pb
                mov     A_xfer_retry, #XFER_RETRIES
.xfer_start
                mov     A_nak_retry, #NAK_NOLIMIT         ' Unlimited NAK retries the default
                rdword  A_total_data, ptra[wLength]       ' Get the size of the data stage from the SETUP struct
                call    #txn_setup                      ' SETUP logic is the same for both control reads and writes
                cmp     A_retval, #PID_ACK        wz
        if_nz   jmp     #A_dwnstream_reset                ' Back to caller to handle error
                cmp     A_total_data, #0          wz
        if_z    jmp     #A_pre_status_in                  ' No data, so directly to status stage
                mov     A_stage_data, #0                  ' Prepare for data stage
                setbyte A_ep_addr_pid, #PID_OUT, #0       ' PID isn't part of the CRC calc
                bith    A_hstatus, #DATAx_TGLB            ' Data stage starts with DATA1 PID
                mov     A_retry, #TXN_RETRIES             ' Reset txn retry limit
.data
                mov     A_pkt_data, A_total_data
                sub     A_pkt_data, A_stage_data
                cmp     A_pkt_data, A_max_pkt_size  wcz
        if_a    mov     A_pkt_data, A_max_pkt_size          ' Data remaining is > max_pkt, so cap at max_pkt
.A_out_retry
                mov     ptra, pb                        ' Set current location in the OUT data buffer/struct
                call    #A_txn_out
                cmp     A_retval, #PID_ACK        wz
        if_z    jmp     #.commit                        ' Function got the data
                call    #A_retry_wait                     ' Wait a bit before retry
                cmp     A_retval, #ERR_TXN_RETRY  wz      ' Out of !NAK retries?
        if_nz   jmp     #.A_out_retry
                jmp     #A_dwnstream_reset                ' Caller must handle transfer retirement
.commit
                mov     pb, ptra                        ' Save the current buffer/struct location
                add     A_stage_data, A_pkt_data
                cmp     A_stage_data, A_total_data  wz
        if_nz   bitnot  A_hstatus, #DATAx_TGLB            ' Toggle DATAx sync bit
        if_nz   jmp     #.data                          ' More data to send
A_pre_status_in
                bith    A_hstatus, #DATAx_TGLB            ' Status stage expects IN to be an empty DATA1 packet
                mov     A_retry, #TXN_RETRIES             ' Reset txn retry limit
.A_status_retry
                mov     A_pkt_data, #0
                call    #A_txn_in
                cmp     A_retval, #PID_ACK        wz      ' ACK says a DATA1 packet was received
        if_z    cmp     A_pkt_data, #0            wz      ' DEBUG: should never fail if the function is USB compliant?
        if_z    jmp     #A_dwnstream_reset                ' Control Write finished
                cmp     A_retval, #PID_STALL      wz      ' STALL needs to go to the caller for resolution
        if_z    jmp     #A_dwnstream_reset
                call    #A_retry_wait                     ' NAK or bus error, so delay a bit
                cmp     A_retval, #ERR_TXN_RETRY  wz
        if_nz   jmp     #.A_status_retry
'                ret                                     ' Caller must handle transfer retirement

'------------------------------------------------------------------------------
' Execute an IN interrupt transaction.
'------------------------------------------------------------------------------
' On entry:
'   A_ep_addr_pid - The function address and endpoint for the IN request.
'   A_hpar2 - Address of the IN data buffer
'   A_hpar3 - Word1 has max data packet size, word0 has the DATAx to expect.
' On exit:
'   A_retval - the result of the operation.
'   A_hpar3 - the count of IN data bytes actually received.
'------------------------------------------------------------------------------
A_do_int_in
                testb   A_ep_addr_pid, #31        wc
        if_c    bith    A_hstatus, #DWNSTRM_HUBB
        if_c    bith    A_usb_h_ls_nco_, #14

                getword A_htmp, A_hpar3, #0
                cmp     A_htmp, #PID_DATA0        wz
                bitnz   A_hstatus, #DATAx_TGLB            ' Set/reset flag for DATAx to expect
                mov     A_retry, #TXN_RETRIES
.A_retry
                getword A_pkt_data, A_hpar3, #1             ' IN max packet length
                call    #A_txn_in
                cmp     A_retval, #PID_ACK        wz      ' ACK if data received
        if_z    jmp     #.commit
                cmp     A_retval, #PID_NAK        wz      ' NAK if no data available (common)
        if_nz   cmp     A_retval, #PID_STALL      wz      ' STALL if the endpoint has a transfer issue and must be reset (rare)
        if_z    jmp     #.post_ret                      ' The caller must handle either
                call    #A_retry_wait
                cmp     A_retval, #ERR_TXN_RETRY  wz
        if_z    jmp     #.post_ret
                jmp     #.A_retry
.commit
                mov     ptra, A_urx_buff_p                ' Copy the rx buffer
                mov     pb, A_hpar2                       ' to the destination buffer
                mov     A_hr0, A_pkt_cnt            wz      ' Skip copy if it's an empty packet
        if_nz   cmp     ptra, pb                wz
        if_nz   call    #A_hmemcpy                        ' hmemcpy(PTRA, PB, A_hr0)
.post_ret
                mov     A_hpar3, A_pkt_cnt                  ' IN bytes actually received

'------------------------------------------------------------------------------
' Resets the downstream hub port to FS
'------------------------------------------------------------------------------
A_dwnstream_reset
                testb   A_ep_addr_pid, #31        wc
        if_nc   ret                                     ' No LS device, reset not needed
                bitl    A_usb_h_ls_nco_, #14
                bitl    A_hstatus, #DWNSTRM_HUBB
                wxpin   A_usb_h_fs_nco_, A_dm              ' Restore host mode and 12Mbs baud
                mov     A_max_pkt_size, #64               ' Set FS control read/write DATAx packet size
                mov     A_tat_wait, A_tat_wait_fs_         ' Bus turn-around time in low-speed bit periods
        _ret_   mov     A_ip_delay, A_ip_delay_fs_         ' Inter-packet delay in low-speed bit periods

'------------------------------------------------------------------------------
' The one millisecond frame timer is implemented as an interrupt service
' routine. Since this timing is critical, care must be taken to avoid any
' instructions that can delay the interrupt branch, which will likely upset
' the timer. WAITX is among those instructions, so any time you're inside
' an IN/OUT/SETUP transaction, use this routine instead of WAITX.
'------------------------------------------------------------------------------
' On entry:
'   A_hctwait - wait interval in sysclocks.
' On exit:
'------------------------------------------------------------------------------
A_poll_waitx
                getct   A_hct2
                addct2  A_hct2, A_hctwait
.wait
                jnct2   #.wait
                ret

'------------------------------------------------------------------------------
' Transaction retry handling for NAK/STALL or bus error.
'------------------------------------------------------------------------------
' On entry:
'   A_retval - transaction response PID or error code.
' On exit:
'------------------------------------------------------------------------------
A_retry_wait
                cmp     A_retval, #PID_STALL      wz
        if_z    ret                                     ' STALL is special case
                cmp     A_retval, #PID_NAK        wz
        if_z    jmp     #.nak
                mov     A_hctwait, A_txn_err_              ' Transaction error wait...
                call    #A_poll_waitx
.dec
                sub     A_retry, #1               wz
        if_z    mov     A_retval, #ERR_TXN_RETRY          ' Only set error code if no retries left
                ret                                     ' Retry result to caller
.nak
                mov     A_hctwait, A_33us_                 ' Seems to be a reasonable NAK delay
                call    #A_poll_waitx
                cmp     A_nak_retry, #NAK_NOLIMIT wz
        if_z    ret                                     ' Indefinite NAK retries
                sub     A_nak_retry, #1           wz
        if_z    mov     A_retval, #ERR_NAK
                ret

host_A_reset
                setint1 #0                              ' Ensure 1ms frame strobe interrupt is off
                mov     A_htmp, ##_CLOCKFREQ                ' Get current sysclock setting
' FIXME: kludge to set a USB tx byte write ACKPIN<->WRPIN delay.
                cmp     A_htmp, ##168_000_000     wcz
        if_be   mov     A_utx_tweak, #0
        if_a    mov     A_utx_tweak, #3   '#20
' Check to see if the system clock has been changed.
                cmp     A_htmp, A_save_sysclk       wz
        if_nz   loc     pb, #@A_hinit_usb_timings - @A_usb_host_start
        if_nz   add     pb, A_hcog_base_addr
        if_nz   call    pb                              ' Recalculate sysclk dependent timing values
                dirl    A_dm                              ' Put smart pins into reset
                dirl    A_dp
                cmp     A_p2rev_val, #P2RevB      wz
        if_z    jmp     #.not_reva
                wrpin   ##USB_V1HMODE_FS, A_dm            ' The host is also the root hub, so full-speed is its native speed
                wrpin   ##USB_V1HMODE_FS, A_dp
                wxpin   A_12Mbps_, A_dm                    ' Default to Full-Speed
                jmp     #.enable
.not_reva
                wrpin   ##USB_V2_DRVOUT, A_dm             ' The same USB smart pin mode for D- and D+ pins
                wrpin   ##USB_V2_DRVOUT, A_dp
                wxpin   A_usb_h_fs_nco_, A_dm              ' Set host mode and full-speed NCO
.enable
                dirh    A_dm                              ' Crank them smart pins up
                dirh    A_dp
                waitx   A_1us_
                wypin   #OUT_IDLE, A_dm

                ' Handle Port protection enable and startup delay
                mov     A_htmp, A_usb_event_pin             ' I/O + 1 pin is the Serial Host USB Protection enable/disable
                add     A_htmp, #1                        ' Protection enable is a one-time operation
                drvl    A_htmp                            ' disable port
                waitx   A_21ms_                          ' Wait a while for everything to turn off
                drvh    A_htmp                            ' Enable the port
                waitx   A_21ms_                          ' Hold to let the idle state get settled

                setd    pa, #A_hreg_init_start            ' Reset all host common registers to startup values
                rep     @.regloop,#A_hreg_init_end - A_hreg_init_start
                alti    pa, #%000_111_000
                mov     0-0, #0
.regloop

A_discon_entry
                mov     A_mod_cnt, #3                     ' Make the first heartbeat pulse a short one

                ' Fall through to A_disconnected loop

'-----------------------------------------------------------------------------------------------------------------
' Device connect handling (Section 7.1.7.3).
'-----------------------------------------------------------------------------------------------------------------
' The 15K pull-down resistors on D+ and D- allow the host to passively monitor the bus lines while waiting for a
' device to connect (Section 7.1.7.3).
'-----------------------------------------------------------------------------------------------------------------
A_disconnected
                mov     A_hr1, ##_CLOCKFREQ                 ' Check to see if the system frequency has changed
                cmp     A_hr1, A_save_sysclk        wz
        if_nz   jmp     #host_A_reset                     ' host_reset will apply the new USB bus NCO calculation
                shr     A_hr1, #3                         ' Pulse the activity LED every two seconds but break
                waitx   A_hr1                             ' it down to smaller wait chunks
                incmod  A_mod_cnt, #8             wc
        if_c    drvnot  A_host_active_led
                rqpin   A_urx, A_dm
                and     A_urx, #J_IDLEF | K_RESUMEF wcz   ' Wait for rise of J or K, mutually exclusive
        if_z    jmp     #A_disconnected                   ' J and K still low, so keep waiting for connect
        if_ne   jmp     #.connect_test                  ' J or K is high, so test for connect
.se1_test
                mov     A_hctwait, A_100ms_                ' J and K high is illegal SE1 state, so wait and retest
                call    #A_poll_waitx
                rqpin   A_urx, A_dm
                and     A_urx, #J_IDLEF | K_RESUMEF wcz
        if_ne   mov     A_retval, #ERR_NONE               ' SE0 or idle state resets any previous error
        if_ne   jmp     #A_discon_entry                   ' Back to connect detection loop
.se1            'SE1 is a fatal error condition
                mov     A_hctwait, A_100ms_
                call    #A_poll_waitx
                mov     A_retval, #ERR_SE1
                call    #A_host_error                     ' Seeing SE1 for any length of time is not good...
.connect_test                                           ' Test lines until stable J/K state seen
                waitx   A_100ms_                         ' Total of 100ms debounce interval (Section 7.1.7.3)
                rqpin   A_urx, A_dm
                and     A_urx, #J_IDLEF | K_RESUMEF wcz
        if_z    jmp     #A_discon_entry                   ' D+ and D- low
        if_e    jmp     #.se1_test                      ' D+ and D- high
A_connected
                bith    A_hstatus, #CONNECTEDB            ' Device plugged in
                call    #A_on_connect                     ' Initial device configuration
                cmp     A_retval, #PID_ACK        wz      ' Anything other than ACK means the device is unusable
        if_nz   jmp     #A_discon_entry
.set_pulse
                getct   A_pulse_time_
                add     A_pulse_time_, A_500ms_           ' Set activity LED pulse to the bus idle toggle rate
' Sample the USB 1ms A_frame delta register to see how close it is to the ideal frame interval
' of 1ms and make a correction, if necessary.
'                mov     A_htmp, A_1ms_
'                subs    A_htmp, A_iframe_delta
'                adds    A_frame1ms_clks_, A_htmp
'                debug(udec(A_frame1ms_clks_))

                ' Fall through to idle/processing loop

                cmp     A_hdev_port, #7           wcz
        if_a    mov     A_hdev_port, #0

A_hidle
                rqpin   A_urx, A_dm
                testb   A_urx, #SE0_RESETB        wc
        if_c    jmp     #.se0_test
                pollct3                         wc
        if_nc   jmp     #.nopoll
                getct   A_hct3
                addct3  A_hct3, A_1ms_                     ' Set the timer for next poll interval

                altgb   A_hdev_port, #A_hdev_type
                getbyte A_htmp

                cmp     A_htmp, #HID_READY        wz
        if_nz   cmp     A_htmp, #PS3_READY        wz
        if_nz   cmp     A_htmp, #XINPUT_READY     wz
                loc     pa, #@A_hget_gp_in_report - @A_usb_host_start
        if_z    jmp     #.poll

                cmp     A_htmp, #HUB_READY        wz
                loc     pa, #@A_hget_hub_status - @A_usb_host_start
        if_z    wxpin   A_htmp, A_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     A_htmp, #KB_READY         wz
                loc     pa, #@A_hget_kbd_in_report - @A_usb_host_start
        if_z    wxpin   A_htmp, A_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     A_htmp, #M_READY          wz
                loc     pa, #@A_hget_mouse_in_report - @A_usb_host_start
        if_z    wxpin   A_htmp, A_usb_event_pin             ' Notify the client
        if_z    jmp     #.poll

                cmp     A_htmp, #KBM_READY        wz
        if_z    wxpin   A_htmp, A_usb_event_pin             ' Notify the client
        if_nz   jmp     #.next
                bitnot  A_hstatus, #KBM_TOGGLEB   wcz
        if_nc   loc     pa, #@A_hget_kbd_in_report - @A_usb_host_start
        if_c    loc     pa, #@A_hget_mouse_in_report - @A_usb_host_start
.poll
                add     pa, A_hcog_base_addr
                call    pa
.next
                incmod  A_hdev_port, #7

'                call    #A_key_repeat                     ' perform key auto-repeat
                loc     pa, #@A_key_repeat - @A_usb_host_start
                add     pa, A_hcog_base_addr
                call    pa

.nopoll
                cmp     A_cmd_data, #CMD_SUSPEND  wz
        if_z    jmp     #A_hsuspend
                cmp     A_cmd_data, #CMD_RESET    wz
        if_z    mov     A_cmd_data, #ERR_NONE             ' Acknowledge client reset cmd received
        if_z    jmp     #host_A_reset                     ' See if it works...
                getct   A_hr0
                cmp     A_hr0, A_pulse_time_       wcz     ' Connected "heartbeat"
        if_ae   drvnot  A_host_active_led
        if_ae   getct   A_pulse_time_
        if_ae   add     A_pulse_time_, A_500ms_
                jmp     #A_hidle
' Check for extended SE0 state on the bus
.se0_test
                mov     A_hctwait, A_1ms_
                call    #A_poll_waitx                     ' Wait a bit and test for SE0 again
                rqpin   A_urx, A_dm
                testb   A_urx, #SE0_RESETB        wc
        if_nc   jmp     #A_hidle                          ' Bus still IDLE
                call    #A_wait_txn_ok
                wypin   ##OUT_IDLE, A_dm                  ' Float USB
                wxpin   #DEV_DISCONNECT, A_usb_event_pin  ' Notify client of disconnect
                jmp     #host_A_reset                     ' Device disconnected

A_hsuspend
                call    #A_wait_txn_ok                    ' Avoid a potential collision with an active frame isr
                setint1 #0                              ' Stopping the 1ms frame packets signals suspend
                waitx   A_suspend_wait_                  ' The device enters suspend state when the bus is idle and
                wypin   #OUT_IDLE, A_dm                   ' no frame SOPs are received for three consecutive frames
                mov     A_cmd_data, #ERR_NONE             ' Clear the cmd from the event queue
                mov     A_mod_cnt, #0

                ' Fall through to resume wait loop

A_hwait_resume
                mov     A_hr1, ##_CLOCKFREQ                 ' Use the CLKFREQ value, as the sysclock may change
                shr     A_hr1, #2
                waitx   A_hr1                             ' Pulse the activity LED every two seconds but break
                incmod  A_mod_cnt, #8             wc      ' it down to smaller wait chunks
        if_c    drvnot  A_host_active_led
                cmp     A_cmd_data, #CMD_RESUME   wz
        if_nz   jmp     #A_hwait_resume
                mov     A_htmp, ##_CLOCKFREQ                ' Check to see if the system frequency has changed
                cmp     A_htmp, A_save_sysclk       wz
        if_z    jmp     #.resume
                loc     pb, #@A_hinit_usb_timings - @A_usb_host_start
                add     pb, A_hcog_base_addr
                call    pb                              ' Recalculate sysclk dependent timing values
                testb   A_hstatus, #LOW_SPEEDB    wc
        if_nc   wxpin   A_usb_h_fs_nco_, A_dm              ' Write the new NCO calculation for the current bus speed
        if_c    wxpin   A_usb_h_ls_nco_, A_dm
.resume
                wypin   #OUT_K, A_dm
                waitx   A_resume_hold_                   ' Hold K-state for 20ms to signal device(s) to resume
                wypin   #OUT_SE0, A_dm
                mov     A_htmp, A_ip_delay_ls_
                shr     A_htmp, #1                        ' Delay two LS bit times for K to J (idle) transition
                waitx   A_htmp
                wypin   #OUT_J, A_dm
                shr     A_htmp, #1
                waitx   A_htmp
                wypin   #OUT_IDLE, A_dm
                getct   A_iframe_ct_base
                mov     A_iframe_ct_new, A_iframe_ct_base
                addct1  A_iframe_ct_new, A_frame1ms_clks_
                setint1 #1                              ' Enable the 1ms frame ISR
                mov     A_hctwait, A_4ms_
                call    #A_poll_waitx                     ' Delay until at least three 1ms frames transmitted
        _ret_   mov     A_cmd_data, #ERR_NONE             ' Acknowledge resume cmd complete

'------------------------------------------------------------------------------
' Send preamble to enable low-speed HUB ports
'------------------------------------------------------------------------------
' On entry:
' On exit:
'   USB baud rate set to low-speed
'------------------------------------------------------------------------------
A_utx_pre
                dirl    A_dm                              ' Put smart pins into reset
                dirl    A_dp
                wrpin   #0, A_dm                          ' Disable smartpin mode
                wrpin   #0, A_dp
                drvl    A_dm
                drvh    A_dp

                mov     A_htmp, ##OUT_SOP | (PID_PRE << 8)

                rep     @.l1, #16 + 1
                shr     A_htmp, #1        wc
        if_nc   setq    #1
        if_nc   outnot  A_dm                              ' Bit-bang sync+preamble+idle
                waitx   A_preamble_wait_
.l1

                dirl    A_dm                              ' Put smart pins into reset
                dirl    A_dp
                wrpin   ##USB_V2_DRVOUT, A_dm             ' The same USB smart pin mode for D- and D+ pins
                wrpin   ##USB_V2_DRVOUT, A_dp
                wxpin   A_usb_h_ls_nco_, A_dm              ' Host mode and 1.5Mbs baud
                dirh    A_dm                              ' Crank them smart pins up
                dirh    A_dp
                wypin   #OUT_IDLE, A_dm

                mov     A_max_pkt_size, #8                ' Set LS control read/write DATAx packet size
                mov     A_tat_wait, A_tat_wait_ls_         ' Bus turn-around time in low-speed bit periods
        _ret_   mov     A_ip_delay, A_ip_delay_ls_         ' Inter-packet delay in low-speed bit periods

A_hlut_end
                fit     $400

                orgh
'
' NOTE: Hub execution and data regions moved to kbmprea.s
'       Common definitions moved to cogkbmc.s
'

#endif 
